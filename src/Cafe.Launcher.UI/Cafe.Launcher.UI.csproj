<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher.UI</AssemblyName>
    <!-- 表现层命名空间与程序集同名（ADR-043）：RootNamespace 因此是 Cafe.Launcher.UI，
         附带效果是 Resources/*.resx 的清单名推导为 Cafe.Launcher.UI.Resources.LauncherStrings，
         与生成的 Designer 完全对齐。 -->
    <RootNamespace>Cafe.Launcher.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cafe.Launcher.Core\Cafe.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时资产归表现层：/Assets/app-icon.ico 是窗口与托盘的图标（同时拷到输出目录供磁盘路径读取），
         launcher-background.png 通过 avares 载入。app-icon-source.png（图标流水线输入）留在宿主。 -->
    <AvaloniaResource Include="Assets\**" />
    <!-- 协议正文以仓库根目录的单一来源嵌入，避免与应用内文本分叉。 -->
    <AvaloniaResource Include="..\..\TERMS.md" Link="Assets\Legal\TERMS.md" />
    <AvaloniaResource Include="..\..\PRIVACY.md" Link="Assets\Legal\PRIVACY.md" />
    <!-- 关于页的「开源许可」「第三方声明」入口读取这两份文档；它们此前只随发行包
         拷贝，普通发布下运行期不可见，因此这里与协议正文同样嵌入。 -->
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Legal\LICENSE.md" />
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\Legal\THIRD-PARTY-NOTICES.md" />
    <None Update="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <!-- Keep the renderer selected by FluentAvalonia aligned with the desktop host. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MarkView.Avalonia" />
    <PackageReference Include="Shirasagi0012.MaterialColorUtilities" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Keep the native player replaceable and ship only the executable's architecture. -->
  <PropertyGroup>
    <BackgroundVideoRid>$(RuntimeIdentifier)</BackgroundVideoRid>
    <BackgroundVideoRid Condition="'$(BackgroundVideoRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</BackgroundVideoRid>
    <BackgroundVideoRoot>$(MSBuildProjectDirectory)/../../.artifacts/native/libmpv</BackgroundVideoRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(BackgroundVideoRid)' == 'win-x64'">
    <Content Include="$(BackgroundVideoRoot)/win-x64/libmpv-2.dll"
             Link="libmpv/win-x64/libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../native/libmpv/*" Link="libmpv/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RestoreVideoBackgroundRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(BackgroundVideoRid)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/Restore-VideoBackgroundRuntime.ps1&quot;" />
  </Target>
  <!-- 包管理器容器（如 Arch）可能没有 pwsh；同一提交在构建任务里已执行该校验。 -->
  <Target Name="ValidateLocalizationCatalog" BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLocalizationCatalogValidation)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/Generate-LocalizationCatalog.ps1&quot; -Check" />
  </Target>
</Project>
