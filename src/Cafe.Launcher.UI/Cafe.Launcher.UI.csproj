<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher.UI</AssemblyName>
    <!-- 表现层命名空间与程序集同名（ADR-043）：RootNamespace 因此是 Cafe.Launcher.UI，
         附带效果是 Resources/*.resx 的清单名推导为 Cafe.Launcher.UI.Resources.LauncherStrings，
         与生成的 Designer 完全对齐。 -->
    <RootNamespace>Cafe.Launcher.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cafe.Launcher.Core\Cafe.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时资产归表现层：/Assets/app-icon.ico 是窗口与托盘的图标（同时拷到输出目录供磁盘路径读取），
         launcher-background.png 通过 avares 载入。app-icon-source.png（图标流水线输入）留在宿主。 -->
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MarkView.Avalonia" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Shirasagi0012.MaterialColorUtilities" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
