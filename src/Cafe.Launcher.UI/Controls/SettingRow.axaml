<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:fluent="using:FluentAvalonia.UI.Controls"
             x:Class="Cafe.Launcher.UI.Controls.SettingRow"
             x:Name="Root"
             x:DataType="controls:SettingRow">
    <fluent:FASettingsExpanderItem Description="{Binding #Root.Description}"
                                   Footer="{Binding #Root.Action}"
                                   HorizontalContentAlignment="Stretch">
        <StackPanel>
            <TextBlock x:Name="RowTitle" Text="{Binding #Root.Title}" TextWrapping="Wrap" Classes="section-title"/>
            <TextBlock x:Name="RowHint"
                       Text="{Binding #Root.Hint}"
                       TextWrapping="Wrap"
                       Theme="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="#Root.Hint" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                        <Binding Path="#Root.IsHintVisible"/>
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
        </StackPanel>
    </fluent:FASettingsExpanderItem>
</UserControl>
