<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             x:Class="Cafe.Launcher.UI.Controls.SettingRow"
             x:Name="Root"
             x:DataType="controls:SettingRow">
    <!-- 首行填满最小行高，让文案与操作共享整行的垂直中心；第二行仅在窄布局承载操作。 -->
    <Grid x:Name="RowLayout" Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
        <Border x:Name="TopDivider"
                Classes="settings-row-divider"
                Grid.ColumnSpan="2"
                IsVisible="{Binding ShowTopDivider, ElementName=Root}"/>
        <StackPanel x:Name="RowCopy" Classes="dialog-heading-copy settings-row-copy"
                    MinWidth="{StaticResource Launcher.Component.Settings.Row.Content.MinWidth}"
                    HorizontalAlignment="Stretch"
                    Margin="{StaticResource Launcher.Component.Settings.Row.Content.Padding}">
            <TextBlock x:Name="RowTitle" Text="{Binding Title, ElementName=Root}" Classes="section-title" TextWrapping="Wrap"/>
            <TextBlock x:Name="RowDescription" Text="{Binding Description, ElementName=Root}" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding Description, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock x:Name="RowHint"
                       Text="{Binding Hint, ElementName=Root}"
                       Classes="caption"
                       TextWrapping="Wrap">
                <TextBlock.IsVisible>
                    <!-- 空文本与显式关闭任一成立即折叠；设置 Hint 无需再显式开启提示。 -->
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Hint" ElementName="Root" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                        <Binding Path="IsHintVisible" ElementName="Root"/>
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
        </StackPanel>
        <ContentPresenter Grid.Column="1"
                          x:Name="ActionPresenter"
                          Content="{Binding Action, ElementName=Root}"/>
    </Grid>
</UserControl>
