<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Cafe.Launcher.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.UI.Controls.GameOperationsSplitButton"
             x:DataType="viewModels:MainWindowViewModel">
    <!-- 统一面板的上下文主操作与管理入口。 -->
    <SplitButton Classes="launcher-control start primary-operation"
            Theme="{StaticResource GameOperationsSplitButtonTheme}"
            Command="{Binding Operations.PrimaryActionCommand}"
            IsEnabled="{Binding Operations.CanUsePrimaryAction}"
            ToolTip.Tip="{Binding Operations.PrimaryActionText}"
            AutomationProperties.Name="{Binding Operations.PrimaryActionText}">
        <StackPanel Classes="button-content">
            <materialIcons:MaterialIcon Kind="{Binding Operations.PrimaryActionIcon}" Width="{StaticResource Launcher.Icon.Xxl}" Height="{StaticResource Launcher.Icon.Xxl}"/>
            <TextBlock Text="{Binding Operations.PrimaryActionText}"/>
        </StackPanel>
        <SplitButton.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight"
                        VerticalOffset="{StaticResource Launcher.Component.LaunchSplit.Menu.VerticalOffset}">
                <MenuItem IsEnabled="{Binding Operations.CanManageGame}" Header="{Binding Shell.I18n[gameCheckUpdate]}"
                          Command="{Binding Operations.CheckForGameUpdateCommand}"
                          AutomationProperties.Name="{Binding Shell.I18n[gameCheckUpdate]}">
                    <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem IsEnabled="{Binding Operations.CanManageGame}" Header="{Binding Shell.I18n[gameCreateShortcut]}"
                          Command="{Binding Operations.CreateGameShortcutCommand}"
                          AutomationProperties.Name="{Binding Shell.I18n[gameCreateShortcut]}">
                    <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="Monitor" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem IsEnabled="{Binding Operations.CanManageGame}" Header="{Binding Shell.I18n[gameOpenFolder]}"
                          Command="{Binding Operations.OpenGameFolderCommand}"
                          AutomationProperties.Name="{Binding Shell.I18n[gameOpenFolder]}">
                    <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem IsEnabled="{Binding Operations.CanRepairGame}" Header="{Binding Shell.I18n[repair]}"
                          Command="{Binding Operations.RequestRepairCommand}"
                          AutomationProperties.Name="{Binding Shell.I18n[repair]}">
                    <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem IsEnabled="{Binding Operations.CanUninstallGame}" Classes="danger-menu-item" Header="{Binding Shell.I18n[uninstall]}"
                          Command="{Binding Operations.RequestUninstallCommand}"
                          AutomationProperties.Name="{Binding Shell.I18n[uninstall]}">
                    <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuFlyout>
        </SplitButton.Flyout>
    </SplitButton>
</UserControl>
