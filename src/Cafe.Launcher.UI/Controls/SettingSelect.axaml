<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:models="using:Cafe.Launcher.UI.Models"
             x:Class="Cafe.Launcher.UI.Controls.SettingSelect"
             x:Name="Root"
             x:DataType="controls:SettingSelect">
    <controls:SettingRow ShowTopDivider="{Binding ShowTopDivider, ElementName=Root}"
                         Title="{Binding Title, ElementName=Root}"
                         Description="{Binding Description, ElementName=Root}"
                         Hint="{Binding Hint, ElementName=Root}"
                         IsHintVisible="{Binding IsHintVisible, ElementName=Root}"
                         MinimumCopyWidth="{Binding MinimumCopyWidth, ElementName=Root}"
                         ContentSpacing="{Binding ContentSpacing, ElementName=Root}">
        <controls:SettingRow.Action>
            <ComboBox Classes="setting-control"
                      AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"
                      ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      SelectedValue="{Binding SelectedValue, ElementName=Root, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Code, DataType={x:Type models:SelectableOption}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SelectableOption">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"
                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingRow.Action>
    </controls:SettingRow>
</UserControl>
