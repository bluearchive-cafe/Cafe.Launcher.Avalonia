<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Cafe.Launcher.UI.Views"
        xmlns:viewModels="using:Cafe.Launcher.UI.ViewModels"
        xmlns:helpers="using:Cafe.Launcher.UI.Helpers"
        xmlns:controls="using:Cafe.Launcher.UI.Controls"
        xmlns:fluent="using:FluentAvalonia.UI.Controls"
        xmlns:glyphs="using:Cafe.Launcher.UI.Constants">
    <Style Selector="TextBlock.caption">
        <Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Theme" Value="{StaticResource BodyTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.progress-title">
        <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}"/>
    </Style>
    <Style Selector="ComboBox.setting-control">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 行内法律链接与 caption 同行同行高：不占用 Fluent 默认按钮的 32 DIP 命中高，
         字号与 caption 同档（12 DIP），悬停/焦点仍由默认模板的下划线表达（LegalLinks 契约）。 -->
    <Style Selector="HyperlinkButton.inline-legal-link, HyperlinkButton.inline-link">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Control.Size.None}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Size.None}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Label.Sm}"/>
    </Style>
    <Style Selector="Button.icon-link">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Size.Swatch}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon-button.carousel-navigation">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <Style Selector="Button.flat-action.icon-only">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <Style Selector="Button.bottom-action">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.BottomAction.MinWidth}"/>
    </Style>
    <Style Selector="WrapPanel.dialog-actions">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="ItemSpacing" Value="{StaticResource Launcher.Spacing.Sm}"/>
        <Setter Property="LineSpacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
    </Style>
    <Style Selector="Button.dialog-action">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Dialog.Action.MinWidth}"/>
    </Style>
    <Style Selector="Button.dialog-close">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.operation-status-title">
        <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
        <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}"/>
    </Style>
    <Style Selector="Border.game-sidebar">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Glass.Rail.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Glass.Edge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.GameSidebar.Divider}"/>
    </Style>
    <Style Selector="ListBox.game-rail">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Layout.Home.Rail.Padding}"/>
    </Style>
    <Style Selector="ListBox.game-rail > ListBoxItem">
        <Setter Property="Width" Value="{StaticResource Launcher.Layout.Home.Rail.Item.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Layout.Home.Rail.Item.Size}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ToolTip.Placement" Value="Right"/>
        <Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True"/>
    </Style>
    <Style Selector="ListBox.game-rail > ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Hover}"/>
    </Style>
    <Style Selector="ListBox.game-rail > ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.SecondaryContainer}"/>
    </Style>
    <Style Selector="ListBox.game-rail > ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.SecondaryContainer.Hover}"/>
    </Style>
    <Style Selector="ListBox.game-rail > ListBoxItem:focus">
        <Setter Property="ToolTip.IsOpen" Value="True"/>
    </Style>
    <Style Selector="Border.rail-selection-indicator">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.GameSidebar.Indicator.Width}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.GameSidebar.Indicator.Height}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Xs}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.FocusRing}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.GameSidebar.Indicator.Margin}"/>
    </Style>
    <!-- 官方图标是方形位图；按关于页应用图标的同一 8 DIP 圆角裁切，避免直角与圆角选中底冲突。 -->
    <Style Selector="Border.game-rail-icon-frame">
        <Setter Property="Width" Value="{StaticResource Launcher.Layout.Home.Rail.Icon.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Layout.Home.Rail.Icon.Size}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Image.game-rail-icon">
        <Setter Property="Width" Value="{StaticResource Launcher.Layout.Home.Rail.Icon.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Layout.Home.Rail.Icon.Size}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.rail-task-badge">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Rail.Badge.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Rail.Badge.Size}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Full}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Rail.Badge.Margin}"/>
    </Style>
    <Style Selector="Border.rail-task-badge.error">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Error}"/>
    </Style>
    <Style Selector="Border.rail-task-badge controls|FluentIcon">
        <Setter Property="FontSize" Value="{StaticResource Launcher.Icon.Xs}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.rail-task-badge.error controls|FluentIcon">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnError}"/>
    </Style>
    <Style Selector="Button.rail-action">
        <Setter Property="Width" Value="{StaticResource Launcher.Layout.Home.Rail.Item.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Layout.Home.Rail.Item.Size}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="ToolTip.Placement" Value="Right"/>
        <Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True"/>
    </Style>
    <!-- 设置整窗页打开时齿轮保持选中态（ADR-070）：与游戏图标选中同语言。 -->
    <Style Selector="Button.rail-action.settings-open">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
    </Style>
    <Style Selector="Button.rail-action:focus">
        <Setter Property="ToolTip.IsOpen" Value="True"/>
    </Style>
    <Style Selector="Border.game-header">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
    </Style>
    <Style Selector="Border.header-scrim">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Header.Scrim}"/>
    </Style>
    <Style Selector="TextBlock.game-title-brand">
        <Setter Property="Theme" Value="{StaticResource TitleTextBlockStyle}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Hero}"/>
    </Style>
    <Style Selector="Border.remote-surface">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.RemoteSurface.Margin}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Component.RemoteSurface.Width}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.RemoteSurface.MinHeight}"/>
        <Setter Property="MaxHeight" Value="{StaticResource Launcher.Component.RemoteSurface.MaxHeight}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Glass.Strong.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Glass.Edge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="BoxShadow" Value="{helpers:BoxShadows {StaticResource Launcher.Elevation.Shadow.Surface}}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>
    <Style Selector="StackPanel.remote-content-stack">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Border.remote-content-card">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Glass.Strong.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Glass.Edge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>
    <Style Selector="Border.info-strip">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="Border.notice-card">
        <Setter Property="MaxHeight" Value="{StaticResource Launcher.Component.NoticeCard.MaxHeight}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.NoticeCard.Margin}"/>
    </Style>
    <Style Selector="WrapPanel.social-actions">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.SocialActions.Margin}"/>
    </Style>
    <Style Selector="Border.media-placeholder">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Background}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="Border.loading-overlay">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="UserControl.remote-content-loading-overlay">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ScrollViewer.remote-content-layout-host">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="Border.remote-content-load-error">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Xl}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.media-placeholder-text">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.path-field">
        <Setter Property="Height" Value="{StaticResource Launcher.Control.Height.Field}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.PathField.Padding}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="Grid.motion-overlay">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-surface">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector=":is(UserControl).motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="StackPanel.motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-bottom">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-shell">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-shell.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{StaticResource Launcher.Color.Overlay.Scrim.Md}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.NormalDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{StaticResource Launcher.Color.Overlay.Scrim.Md}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > controls|DialogSurface.motion-surface">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.NormalDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > controls|DialogSurface.motion-surface">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(UserControl).motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="StackPanel.motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.motion-bottom.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.NormalDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Bottom}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.control-panel">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.ControlPanel.MinHeight}"/>
    </Style>
    <Style Selector="Border.content-row">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.ContentRow.Margin}"/>
    </Style>
    <Style Selector="Border.content-row.news-content-row">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Sm}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
    </Style>
    <Style Selector="Button.content-link">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.banner-link">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>
    <Style Selector="Grid.banner-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.banner-media">
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.banner-frame">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>
    <Style Selector="Border.banner-frame.joined-below">
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Component.RemoteContent.JoinedUpper.CornerRadius}"/>
    </Style>
    <Style Selector="Border.remote-content-card.news-card">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="Border.news-card.joined-above">
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Component.RemoteContent.JoinedLower.CornerRadius}"/>
    </Style>
    <Style Selector="Grid.banner-stage">
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Button.banner-control">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>
    <Style Selector="Button.banner-control.carousel-navigation">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.Sm}"/>
    </Style>
    <Style Selector="Border.banner-edge-gradient">
        <Setter Property="Width" Value="{StaticResource Launcher.Layout.Banner.EdgeGradient.Width}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>
    <Style Selector="Grid.banner-control">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>
    <Style Selector="Grid.banner-stage.active > Button.banner-control">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Grid.banner-stage.active > Grid.banner-control">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Grid.banner-stage.active > Border.banner-edge-gradient">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.banner-control:disabled">
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Grid.banner-stage.active > Button.banner-control:disabled">
        <Setter Property="Opacity" Value="{StaticResource Launcher.StateLayer.Disabled.Content}"/>
    </Style>
    <Style Selector="Border.appearance-preview-toolbar">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Glass.Background}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>

    <!-- ADR-070 第二批：设置整窗页（标题栏以下、图标栏右侧的实心页面）。
         根网格不再铺遮罩：图标栏与页头保持可命中，页面表面自己承担底色；
         初始不可见由 MotionVisibility 按 IsOpen 接管。 -->
    <Style Selector="Grid.settings-overlay">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
        <Setter Property="views:OverlayFocusBehavior.IsEnabled" Value="True"/>
    </Style>
    <Style Selector="Grid.settings-overlay.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.settings-overlay.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.settings-page">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Grid.settings-workspace">
        <Setter Property="ColumnSpacing" Value="{StaticResource Launcher.Spacing.None}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="Border.settings-header">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Settings.Header.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.Settings.Head.MinHeight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Border.settings-navigation-pane">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.GameSidebar.Divider}"/>
    </Style>
    <Style Selector="ListBox.settings-navigation">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Settings.Navigation.List.Padding}"/>
    </Style>
    <Style Selector="ListBox.settings-navigation > ListBoxItem">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Navigation.Item.Margin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Settings.Navigation.Item.Padding}"/>
    </Style>
    <!-- 选中分类加粗：导航文字经继承获得 DemiBold（Typography 契约）。 -->
    <Style Selector="ListBox.settings-navigation > ListBoxItem:selected">
        <Setter Property="FontWeight" Value="{StaticResource Launcher.Typography.FontWeight.Strong}"/>
    </Style>
    <Style Selector="TextBlock.settings-navigation-item">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.settings-content-actions">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Settings.Footer.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.Settings.Footer.MinHeight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="ProgressBar.settings-save-progress">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.dialog-close.content-header-action">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="Grid.settings-content-heading">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Content.Padding}"/>
    </Style>
    <Style Selector="StackPanel.settings-content-heading-copy">
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.settings-sections">
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.None}"/>
    </Style>
    <Style Selector="StackPanel.settings-group">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Group.Margin}"/>
    </Style>
    <!-- 分组卡片：组标题在卡外，卡内行间由 settings-row-divider 分隔。 -->
    <Style Selector="Border.settings-group-card">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Xs}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Border.settings-row-divider">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <!-- 原生单选组：替代已退场的分段按钮（ADR-070），仅保留间距与最小命中高。 -->
    <Style Selector="WrapPanel.setting-radio-group">
        <Setter Property="ItemSpacing" Value="{StaticResource Launcher.Spacing.Xl}"/>
        <Setter Property="LineSpacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
    </Style>
    <Style Selector="RadioButton.setting-radio">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Chip}"/>
    </Style>
    <Style Selector="ScrollViewer.settings-content-scroll">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Settings.Content.Scroll.Padding}"/>
    </Style>
    <Style Selector="Grid.settings-appearance-media">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Row.Content.Padding}"/>
    </Style>
    <Style Selector="Grid.settings-volume-value">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.settings-appearance-thumbnail">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Settings.Appearance.Thumbnail.Width}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Settings.Appearance.Thumbnail.Height}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>
    <Style Selector="Grid.settings-appearance-warning">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Row.Content.Padding}"/>
    </Style>
    <Style Selector="Expander.settings-appearance-expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="Grid.dialog-overlay">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
        <Setter Property="views:OverlayFocusBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}"/>
    </Style>
    <Style Selector="Grid.setup-wizard-overlay">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
        <Setter Property="views:OverlayFocusBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}"/>
    </Style>
    <Style Selector="StackPanel.dialog-title-row">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Md}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Dialog.Title.Margin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ScrollViewer.dialog-scroll">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="StackPanel.dialog-heading-copy">
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 卸载对话框正文内的水平分隔线：1 DIP 填充条，像素对齐（DecorativeBorders 契约）。 -->
    <Style Selector="Border.uninstall-divider">
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Menu.Separator.Height}"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Border.dialog-alert">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="StackPanel.dialog-alert-heading">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
    </Style>
    <Style Selector="TextBlock.dialog-alert-content">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.dialog-card">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Lg}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Border.dialog-card.compact">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Sm}"/>
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}"/>
    </Style>
    <!-- 设置行标题复用 section-title 标记，但按 ADR-056 保持普通字重（Typography 契约）。 -->
    <Style Selector="controls|SettingRow TextBlock.section-title">
        <Setter Property="Theme" Value="{StaticResource BodyTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.group-title">
        <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}"/>
    </Style>
    <Style Selector="StackPanel.settings-group > TextBlock.group-title">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Settings.Group.Title.Margin}"/>
    </Style>
    <Style Selector="TextBlock.category-title">
        <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}"/>
    </Style>
    <Style Selector="TextBlock.chip-text">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.button-content">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Sm}"/>
    </Style>
    <Style Selector="StackPanel.button-content > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.card-heading">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Sm}"/>
    </Style>
    <Style Selector="Border.about-identity-card">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Lg}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="TextBlock.about-product-name">
        <Setter Property="Theme" Value="{StaticResource TitleTextBlockStyle}"/>
    </Style>
    <Style Selector="Border.about-kv-list">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Grid.about-kv-row">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.About.KvRow.MinHeight}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.About.KvRow.Margin}"/>
        <Setter Property="ColumnSpacing" Value="{StaticResource Launcher.Spacing.Md}"/>
    </Style>
    <Style Selector="Grid.about-kv-row > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.about-kv-value">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource Launcher.Typography.FontFamily.Monospace}"/>
    </Style>
    <Style Selector="Border.about-app-icon-frame">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.About.AppIcon.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.About.AppIcon.Size}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Component.About.AppIcon.CornerRadius}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Button.about-identity-action">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.About.IdentityAction.Margin}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.About.IdentityAction.MinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.About.IdentityAction.Padding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
    </Style>
    <!-- 法律行的文字与行内链接共用一行；网格与 kv 行同密度，但类名分开，
         避免 kv 行的计数契约把法律行也算进去。 -->
    <Style Selector="Grid.about-legal-row">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.About.KvRow.MinHeight}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.About.KvRow.Margin}"/>
        <Setter Property="ColumnSpacing" Value="{StaticResource Launcher.Spacing.Md}"/>
    </Style>
    <Style Selector="Grid.about-legal-row > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.about-kv-footer">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.About.KvRow.Margin}"/>
    </Style>
    <Style Selector="Button.about-kv-copy">
        <Setter Property="Width" Value="{StaticResource Launcher.Icon.Lg}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Icon.Lg}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Xs}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Focus}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Color.Transparent}"/>
    </Style>
    <Style Selector="Button.about-kv-copy:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.FocusRing}"/>
    </Style>
    <Style Selector="ItemsControl.about-link-list">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="Button.about-link-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- 键盘焦点环占用常驻描边槽：静止透明，:focus-visible 显形（CreditRows 契约），
             指针悬停仍由默认模板的透明按钮状态层表达。 -->
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Focus}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Color.Transparent}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Xs}"/>
    </Style>
    <Style Selector="Button.about-link-item:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.FocusRing}"/>
    </Style>
    <Style Selector="Border.about-credit-avatar">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.About.CreditAvatar.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.About.CreditAvatar.Size}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.about-credit-divider">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="ItemsControl.about-credit-list ContentPresenter:nth-child(n+2) > Grid > Border.about-credit-divider">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="TextBlock.about-community-thanks">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.About.KvRow.Margin}"/>
    </Style>
    <Style Selector="ColorPicker.setting-control">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.field-input">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Input.MinWidth}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.color-swatch">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Size.Swatch}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Control.Size.Swatch}"/>
    </Style>
    <Style Selector="RadioButton.color-swatch-button">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ScrollViewer.scroll-pad">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Scroll.Pad}"/>
    </Style>
    <Style Selector="Border.color-swatch-preview">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
    </Style>
    <Style Selector="Border.theme-color-dot">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="SplitButton.primary-operation /template/ Button#PART_PrimaryButton" x:DataType="viewModels:MainWindowViewModel">
        <Setter Property="AutomationProperties.Name" Value="{Binding Operations.PrimaryActionText}"/>
    </Style>
    <Style Selector="SplitButton.primary-operation /template/ Button#PART_SecondaryButton" x:DataType="viewModels:MainWindowViewModel">
        <Setter Property="AutomationProperties.Name" Value="{Binding Shell.I18n[gameManagement]}"/>
    </Style>
    <Style Selector="Expander.settings-appearance-advanced /template/ ToggleButton" x:DataType="viewModels:MainWindowViewModel">
        <Setter Property="AutomationProperties.Name" Value="{Binding Shell.I18n[settingsAdvancedColors]}"/>
    </Style>
    <Style Selector="Border.dialog-alert.danger">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.dialog-alert.warning">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.status-chip.ready">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.status-chip.failed">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="Theme" Value="{StaticResource BodyTextBlockStyle}"/>
    </Style>
    <Style Selector="Image.settings-appearance-thumbnail-image.video">
        <Setter Property="Effect">
            <BlurEffect Radius="{StaticResource Launcher.Component.Settings.Appearance.Thumbnail.VideoBlurRadius}"/>
        </Setter>
    </Style>
    <Style Selector="Border.settings-appearance-video-shade">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Overlay.Scrim.Sm}"/>
    </Style>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/Diagnostics.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/RemoteContent.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/SetupWizard.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/Toast.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/DialogSurface.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/ResourcePanel.axaml"/>
    <StyleInclude Source="avares://Cafe.Launcher.UI/Views/Styles/GameTask.axaml"/>
</Styles>
