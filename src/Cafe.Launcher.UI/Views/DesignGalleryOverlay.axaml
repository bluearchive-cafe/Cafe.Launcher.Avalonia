<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.UI.ViewModels"
             xmlns:h="using:Cafe.Launcher.UI.Helpers"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:glyphs="using:Cafe.Launcher.UI.Constants"
             x:Class="Cafe.Launcher.UI.Views.DesignGalleryOverlay"
             x:Name="GalleryRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="dialog-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsDesignGalleryInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding Dialogs.Gallery.IsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <!-- Panel 形态：调试工具同样走统一外壳；尺寸自适应（token 封顶）。 -->
        <controls:DialogSurface
            Form="Panel"
            Classes="motion-surface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
            MaxWidth="{StaticResource Launcher.Layout.DesignGallery.Width}"
            MaxHeight="{StaticResource Launcher.Layout.DesignGallery.Height}"
            Title="{Binding Shell.I18n[designGalleryTitle]}"
            CloseCommand="{Binding Dialogs.Gallery.CloseCommand}"
            CloseAutomationName="{Binding Shell.I18n[close]}"
            CloseToolTip="{Binding Shell.I18n[close]}">
            <controls:DialogSurface.RenderTransform>
                <TranslateTransform/>
            </controls:DialogSurface.RenderTransform>
            <controls:DialogSurface.Content>
            <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}">
                        <TextBlock Text="{Binding Shell.I18n[designGalleryHint]}" Classes="caption"/>
                        <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}"
                                   LineSpacing="{StaticResource Launcher.Spacing.Sm}">
                            <Button Classes="gallery-button accent" IsTabStop="False"
                                    Content="{Binding Shell.I18n[designMatrixFilledButton]}"/>
                            <Button Classes="gallery-button" IsTabStop="False"
                                    Content="{Binding Shell.I18n[designMatrixOutlinedButton]}"/>
                            <Button Classes="gallery-button" IsTabStop="False" Theme="{StaticResource TransparentButton}"
                                    Content="{Binding Shell.I18n[designMatrixTextButton]}"/>
                            <Button Classes="gallery-button" IsTabStop="False" IsEnabled="False"
                                    Content="{Binding Shell.I18n[designStateDisabled]}"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Dialogs.Gallery.Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Lg}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="h:DesignTokenGroup">
                                    <Border Classes="dialog-card">
                                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="section-title"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="h:DesignTokenItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="{StaticResource Launcher.Control.Size.Swatch}"
                                                                    Height="{StaticResource Launcher.Control.Size.Swatch}"
                                                                    CornerRadius="{StaticResource Launcher.Radius.Xs}"
                                                                    Background="{Binding Swatch}"
                                                                    BorderBrush="{DynamicResource Launcher.Color.Card.Border}"
                                                                    BorderThickness="{StaticResource Launcher.Border.Thickness.Default}"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Key}"
                                                                       Classes="caption"
                                                                       FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="{StaticResource Launcher.Spacing.Thickness.Sm}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                                       Classes="caption"
                                                                       FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </controls:DialogSurface.Content>
            <controls:DialogSurface.Footer>
                <WrapPanel Classes="dialog-actions">
                    <Button Classes="primary-action dialog-action accent" Command="{Binding Dialogs.Gallery.CloseCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <StackPanel Classes="button-content">
                            <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Check}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[close]}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </controls:DialogSurface.Footer>
        </controls:DialogSurface>
    </Grid>
</UserControl>
