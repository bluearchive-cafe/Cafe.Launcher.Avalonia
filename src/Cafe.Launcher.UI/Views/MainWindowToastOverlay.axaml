<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.UI.ViewModels"
            xmlns:models="using:Cafe.Launcher.UI.Models"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:fluent="using:FluentAvalonia.UI.Controls"
             x:Class="Cafe.Launcher.UI.Views.MainWindowToastOverlay"
             x:Name="ToastOverlayRoot"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <!-- 通知卡固定使用资讯级（中性）表面，严重级别只由左缘语义条与标题表达；
             其它 FAInfoBar 仍在各自位置保留语义底色。 -->
    </UserControl.Resources>
    <!-- Toast notification overlay -->
    <!-- Toast 通知层：区域命名 + LiveSetting 让辅助技术感知卡片增删（§8）。 -->
    <Grid Classes="toast-host"
          AutomationProperties.Name="{Binding Shell.I18n[toastRegionName]}"
          AutomationProperties.LiveSetting="Polite">
        <ItemsControl ItemsSource="{Binding Toasts.ActiveToasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="toast-list"
                                controls:ToastStackMotion.IsEnabled="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).IsMotionEnabled}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ToastNotification">
                    <Border Classes="toast-card"
                            Classes.toast-severity-informational="{Binding IsInformational}"
                            Classes.toast-severity-success="{Binding IsSuccess}"
                            Classes.toast-severity-warning="{Binding IsWarning}"
                            Classes.toast-severity-error="{Binding IsError}"
                            Classes.motion-enabled="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).IsMotionEnabled}"
                            Classes.motion-exit="{Binding IsExiting}"
                            controls:MotionEntrance.IsTriggered="True"
                            IsHitTestVisible="True"
                            PropertyChanged="OnToastCardPropertyChanged">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="toast-accent-bar"/>
                            <fluent:FAInfoBar Grid.Column="1"
                                              Title="{Binding Title}"
                                              Message="{Binding Message}"
                                              Severity="Informational"
                                              IsIconVisible="False"
                                              CornerRadius="{StaticResource OverlayCornerRadius}"
                                              IsOpen="True"
                                              CloseButtonCommand="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.DismissToastCommand}"
                                              CloseButtonCommandParameter="{Binding Id}">
                                <fluent:FAInfoBar.Styles>
                                    <Style Selector="fluent|FAInfoBar /template/ Button#CloseButton">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n[close]}"/>
                                    </Style>
                                </fluent:FAInfoBar.Styles>
                                <StackPanel Classes="toast-action-area" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <StackPanel.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="HasPrimaryAction"/>
                                            <Binding Path="HasSecondaryAction"/>
                                            <Binding Path="IsActionExecuting"/>
                                        </MultiBinding>
                                    </StackPanel.IsVisible>
                                    <WrapPanel Classes="toast-actions" HorizontalAlignment="Right">
                                        <Button Classes="accent toast-primary-action"
                                                IsVisible="{Binding HasPrimaryAction}"
                                                IsEnabled="{Binding !IsActionExecuting}"
                                                Command="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.ExecutePrimaryToastActionCommand}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding PrimaryActionLabel}">
                                            <TextBlock Text="{Binding PrimaryActionLabel}" TextWrapping="Wrap"/>
                                        </Button>
                                        <Button Classes="toast-secondary-action"
                                                Theme="{StaticResource TransparentButton}"
                                                IsVisible="{Binding HasSecondaryAction}"
                                                IsEnabled="{Binding !IsActionExecuting}"
                                                Command="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.ExecuteSecondaryToastActionCommand}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding SecondaryActionLabel}">
                                            <TextBlock Text="{Binding SecondaryActionLabel}" TextWrapping="Wrap"/>
                                        </Button>
                                    </WrapPanel>
                                    <ProgressBar Classes="toast-progress"
                                                 IsVisible="{Binding IsActionExecuting}"
                                                 IsIndeterminate="True"/>
                                </StackPanel>
                            </fluent:FAInfoBar>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
