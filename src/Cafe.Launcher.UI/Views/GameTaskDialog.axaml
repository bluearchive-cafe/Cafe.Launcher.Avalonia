<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.UI.ViewModels"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             x:Class="Cafe.Launcher.UI.Views.GameTaskDialog"
             x:DataType="vm:MainWindowViewModel">
    <Grid x:Name="GameTaskLayer" Classes="dialog-overlay motion-overlay"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding Operations.IsTaskDialogVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <controls:DialogSurface x:Name="GameTaskSurface" Form="Panel" Classes="motion-surface"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
                                Width="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"
                                MaxWidth="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"
                                Title="{Binding Operations.TaskTitle}"
                                CloseCommand="{Binding Operations.CloseTaskCommand}"
                                CloseAutomationName="{Binding Operations.TaskCloseText}"
                                CloseToolTip="{Binding Operations.TaskCloseText}">
            <controls:DialogSurface.RenderTransform><TranslateTransform/></controls:DialogSurface.RenderTransform>
            <controls:DialogSurface.Content>
                <StackPanel Spacing="{StaticResource Launcher.Spacing.Lg}">
                    <StackPanel IsVisible="{Binding Operations.IsInstallPreparing}" Spacing="{StaticResource Launcher.Spacing.Md}">
                        <TextBlock Text="{Binding Shell.I18n[taskInstallSelectPath]}" Classes="dialog-alert-content"/>
                        <Border Classes="task-install-path">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock x:Name="InstallPathLabel" Text="{Binding Operations.InstallPathDraft}"
                                           Classes="dialog-alert-content" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Operations.InstallPathDraft}"/>
                                <HyperlinkButton Grid.Column="1" Classes="inline-link" VerticalAlignment="Center"
                                        IsEnabled="{Binding Operations.CanChooseInstallPath}"
                                        Content="{Binding Shell.I18n[taskInstallChangePath]}" AutomationProperties.Name="{Binding Shell.I18n[taskInstallChangePath]}"
                                        Command="{Binding Operations.ChooseInstallPathCommand}"/>
                            </Grid>
                        </Border>
                        <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}" LineSpacing="{StaticResource Launcher.Spacing.Xs}">
                            <TextBlock Text="{Binding Operations.InstallDownloadSizeText}" Classes="caption"/>
                            <TextBlock Text="|" Classes="caption"/>
                            <TextBlock Text="{Binding Operations.InstallRequiredSizeText}" Classes="caption"/>
                        </WrapPanel>
                        <CheckBox x:Name="InstallShortcutCheckBox" Classes="setting-checkbox"
                                  IsChecked="{Binding Operations.CreateInstallDesktopShortcut}"
                                  IsEnabled="{Binding Operations.CanChooseInstallPath}"
                                  AutomationProperties.Name="{Binding Shell.I18n[taskInstallDesktopShortcut]}">
                            <TextBlock Text="{Binding Shell.I18n[taskInstallDesktopShortcut]}" Classes="dialog-alert-content" TextWrapping="Wrap"/>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </controls:DialogSurface.Content>
            <controls:DialogSurface.Footer>
                <StackPanel Classes="confirm-actions">
                    <Button Classes="flat-action dialog-action" IsVisible="{Binding Operations.IsInstallPreparing}"
                            IsEnabled="{Binding Operations.CanChooseInstallPath}"
                            Content="{Binding Shell.I18n[taskIdentifyInstallation]}" AutomationProperties.Name="{Binding Shell.I18n[taskIdentifyInstallation]}"
                            Command="{Binding Operations.IdentifyInstalledGameCommand}"/>
                    <Button Classes="primary-action dialog-action" IsVisible="{Binding Operations.IsInstallPreparing}"
                            IsEnabled="{Binding Operations.CanStartInstall}"
                            Content="{Binding Shell.I18n[taskStartInstall]}" AutomationProperties.Name="{Binding Shell.I18n[taskStartInstall]}"
                            Command="{Binding Operations.ConfirmInstallCommand}"
                            ToolTip.Tip="{Binding Operations.InstallButtonToolTip}" ToolTip.ShowOnDisabled="True"
                            AutomationProperties.HelpText="{Binding Operations.InstallButtonToolTip}"/>
                </StackPanel>
            </controls:DialogSurface.Footer>
        </controls:DialogSurface>
    </Grid>
</UserControl>
