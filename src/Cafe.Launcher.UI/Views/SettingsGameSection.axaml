<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             x:Class="Cafe.Launcher.UI.Views.SettingsGameSection"
             x:Name="SettingsRoot"
             Classes="settings-section"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel>
        <StackPanel Classes="settings-group">
            <TextBlock Text="{Binding Shell.I18n[settingsGroupGameFiles]}" Classes="group-title"/>

            <controls:SettingRow ShowTopDivider="False"
                                 Title="{Binding Shell.I18n[gamePath]}"
                                 Description="{Binding Settings.GamePathDisplay}">
                <controls:SettingRow.Action>
                    <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}" LineSpacing="{StaticResource Launcher.Spacing.Sm}" VerticalAlignment="Center">
                        <Button Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[choose]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingSelect Title="{Binding Shell.I18n[launchCheck]}"
                                    Description="{Binding Shell.I18n[launchCheckDescription]}"
                                    AutomationName="{Binding Shell.I18n[launchCheck]}"
                                    ItemsSource="{Binding Settings.Options.LaunchCheckMode}"
                                    SelectedValue="{Binding Settings.Editor.Current.LaunchCheckMode, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Classes="settings-group">
            <TextBlock Text="{Binding Shell.I18n[settingsCurrentInstallation]}" Classes="group-title"/>
            <TextBlock Text="{Binding Shell.I18n[gameManagementDescription]}" Classes="caption" TextWrapping="Wrap"/>
            <controls:SettingRow Title="{Binding Shell.I18n[gameManagement]}" ShowTopDivider="False"
                                 Description="{Binding Operations.GameManagementPath}"
                                 Hint="{Binding Shell.I18n[settingsGamePathPending]}"
                                 IsHintVisible="{Binding Settings.HasGamePathChanges}">
                <controls:SettingRow.Action>
                    <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}" LineSpacing="{StaticResource Launcher.Spacing.Sm}" VerticalAlignment="Center" IsEnabled="{Binding !Settings.HasGamePathChanges}">
                        <Button Classes="flat-action" Command="{Binding Operations.OpenGameFolderCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[gameOpenFolder]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[gameOpenFolder]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action" Command="{Binding Operations.RequestRepairCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[repair]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[repair]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action danger-action" Command="{Binding Operations.RequestUninstallCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[uninstall]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[uninstall]}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </controls:SettingRow.Action>
            </controls:SettingRow>
        </StackPanel>

        <StackPanel Classes="settings-group" IsVisible="{Binding IsPlatformSpecificSettingsVisible}">
            <TextBlock Text="{Binding Shell.I18n[settingsGroupGameRuntime]}" Classes="group-title"/>

            <controls:SettingSelect ShowTopDivider="False"
                                    Title="{Binding Shell.I18n[gameRuntimeRunner]}"
                                    Description="{Binding Shell.I18n[gameRuntimeRunnerDescription]}"
                                    AutomationName="{Binding Shell.I18n[gameRuntimeRunner]}"
                                    ItemsSource="{Binding Settings.Options.GameRuntimeRunner}"
                                    SelectedValue="{Binding Settings.Editor.Current.GameRuntime.Runner, Mode=TwoWay}"/>

            <controls:SettingRow Title="{Binding Shell.I18n[gameRuntimeRunnerPath]}"
                                 Description="{Binding Shell.I18n[gameRuntimeRunnerPathDescription]}">
                <controls:SettingRow.Action>
                    <TextBox Classes="field-input"
                             Width="{StaticResource Launcher.Component.Settings.Control.MinWidth}"
                             Text="{Binding Settings.Editor.Current.GameRuntime.RunnerPath, Mode=TwoWay}"
                             PlaceholderText="{Binding Shell.I18n[gameRuntimeRunnerPathPlaceholder]}"
                             AutomationProperties.Name="{Binding Shell.I18n[gameRuntimeRunnerPath]}"
                             IsEnabled="{Binding Settings.GameRuntime.IsRunnerPathEnabled}"/>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingRow Title="{Binding Shell.I18n[gameRuntimePrefixPath]}"
                                 Description="{Binding Shell.I18n[gameRuntimePrefixPathDescription]}">
                <controls:SettingRow.Action>
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                        <TextBox Classes="field-input"
                                 Width="{StaticResource Launcher.Component.Settings.Control.MinWidth}"
                                 Text="{Binding Settings.Editor.Current.GameRuntime.PrefixPath, Mode=TwoWay}"
                                 PlaceholderText="{Binding Shell.I18n[gameRuntimePrefixPathPlaceholder]}"
                                 AutomationProperties.Name="{Binding Shell.I18n[gameRuntimePrefixPath]}"/>
                        <Button Classes="flat-action" Command="{Binding Settings.GameRuntime.ChoosePrefixPathCommand}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{Binding Shell.I18n[choose]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingRow Title="{Binding Shell.I18n[gameRuntimeProtonPath]}"
                                 Description="{Binding Shell.I18n[gameRuntimeProtonPathDescription]}">
                <controls:SettingRow.Action>
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                        <TextBox Classes="field-input"
                                 Width="{StaticResource Launcher.Component.Settings.Control.MinWidth}"
                                 Text="{Binding Settings.Editor.Current.GameRuntime.ProtonPath, Mode=TwoWay}"
                                 PlaceholderText="{Binding Shell.I18n[gameRuntimeProtonPathPlaceholder]}"
                                 AutomationProperties.Name="{Binding Shell.I18n[gameRuntimeProtonPath]}"/>
                        <Button Classes="flat-action" Command="{Binding Settings.GameRuntime.ChooseProtonPathCommand}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{Binding Shell.I18n[choose]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingSelect IsVisible="{Binding Settings.GameRuntime.HasBuilds}"
                                    Title="{Binding Shell.I18n[gameRuntimeInstalledProton]}"
                                    AutomationName="{Binding Shell.I18n[gameRuntimeInstalledProton]}"
                                    ItemsSource="{Binding Settings.GameRuntime.Builds}"
                                    SelectedValue="{Binding Settings.GameRuntime.SelectedBuild, Mode=TwoWay}"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Launcher.Spacing.Sm}"
                  IsVisible="{Binding Settings.GameRuntime.BuildDiscoveryFailed}">
                <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                <TextBlock Grid.Column="1" Text="{Binding Shell.I18n[gameRuntimeProtonDiscoveryFailed]}" Classes="caption" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>

            <controls:SettingRow x:Name="MangoHudSetting"
                                 IsVisible="{Binding Shell.IsLinuxPlatform}"
                                 Title="{Binding Shell.I18n[gameRuntimeMangoHud]}"
                                 Description="{Binding Shell.I18n[gameRuntimeMangoHudDescription]}">
                <controls:SettingRow.Action>
                    <CheckBox Classes="setting-checkbox"
                              AutomationProperties.Name="{Binding Shell.I18n[gameRuntimeMangoHud]}"
                              IsChecked="{Binding Settings.Editor.Current.GameRuntime.EnableMangoHud, Mode=TwoWay}"/>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingRow Title="{Binding Shell.I18n[gameRuntimeStatusTitle]}"
                                 Description="{Binding Settings.GameRuntime.StatusSummary}">
                <controls:SettingRow.Action>
                    <Button Classes="flat-action" Command="{Binding Settings.GameRuntime.RefreshStatusCommand}"
                            Content="{Binding Shell.I18n[refresh]}"
                            AutomationProperties.Name="{Binding Shell.I18n[refresh]}"
                            IsEnabled="{Binding Settings.GameRuntime.IsStatusRefreshing, Converter={x:Static BoolConverters.Not}}"/>
                </controls:SettingRow.Action>
            </controls:SettingRow>
        </StackPanel>
    </StackPanel>
</UserControl>
