<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.UI.ViewModels"
             xmlns:glyphs="using:Cafe.Launcher.UI.Constants"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             x:Class="Cafe.Launcher.UI.Views.SettingsGameSection"
             x:Name="SettingsRoot"
             Classes="settings-section"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel>
        <StackPanel Classes="settings-group">
            <TextBlock Text="{Binding Shell.I18n[settingsGroupGameFiles]}" Classes="group-title"/>

            <Border Classes="settings-group-card">
                <controls:SettingRow
                                     Title="{Binding Shell.I18n[gamePath]}"
                                     Description="{Binding Settings.GamePathDisplay}">
                    <controls:SettingRow.Action>
                        <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}" LineSpacing="{StaticResource Launcher.Spacing.Sm}" VerticalAlignment="Center">
                            <Button Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                                    AutomationProperties.Name="{Binding Shell.I18n[choose]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Folder}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </controls:SettingRow.Action>
                </controls:SettingRow>
            </Border>
        </StackPanel>

        <StackPanel Classes="settings-group">
            <TextBlock Text="{Binding Shell.I18n[settingsCurrentInstallation]}" Classes="group-title"/>
            <TextBlock Text="{Binding Shell.I18n[gameManagementDescription]}" Classes="caption" TextWrapping="Wrap"/>
            <Border Classes="settings-group-card">
                <StackPanel>
                    <controls:SettingRow Title="{Binding Shell.I18n[gameManagement]}"
                                         Description="{Binding Operations.GameManagementPath}"
                                         Hint="{Binding Shell.I18n[settingsGamePathPending]}"
                                         IsHintVisible="{Binding Settings.HasGamePathChanges}"/>
                    <Border Classes="settings-row-divider"/>
                    <StackPanel x:Name="MaintenanceActions" Spacing="{StaticResource Launcher.Spacing.Sm}"
                                IsEnabled="{Binding !Settings.HasGamePathChanges}">
                        <WrapPanel ItemSpacing="{StaticResource Launcher.Spacing.Sm}" LineSpacing="{StaticResource Launcher.Spacing.Sm}">
                            <Button Classes="flat-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="identify"
                                    AutomationProperties.Name="{Binding Shell.I18n[selectInstalledGame]}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Search}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[selectInstalledGame]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="update"
                                    AutomationProperties.Name="{Binding Shell.I18n[gameCheckUpdate]}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Update}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[gameCheckUpdate]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="shortcut"
                                    AutomationProperties.Name="{Binding Shell.I18n[gameCreateShortcut]}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Monitor}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[gameCreateShortcut]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="folder"
                                    AutomationProperties.Name="{Binding Shell.I18n[gameOpenFolder]}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.FolderOpen}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[gameOpenFolder]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="repair"
                                    AutomationProperties.Name="{Binding Shell.I18n[repair]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                <StackPanel Classes="button-content">
                                    <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Tools}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[repair]}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Button Classes="flat-action danger-action" Command="{Binding ManageGameFromSettingsCommand}" CommandParameter="uninstall"
                                AutomationProperties.Name="{Binding Shell.I18n[uninstall]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <controls:FluentIcon Glyph="{x:Static glyphs:FluentGlyphs.Delete}" FontSize="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[uninstall]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
