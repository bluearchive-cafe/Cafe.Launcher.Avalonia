<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Cafe.Launcher.UI.Controls"
        xmlns:fluent="using:FluentAvalonia.UI.Controls"
        xmlns:helpers="using:Cafe.Launcher.UI.Helpers"
        xmlns:glyphs="using:Cafe.Launcher.UI.Constants">

  <Style Selector="controls|DialogSurface.confirmation-surface">
    <Setter Property="MaxWidth" Value="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"/>
  </Style>

  <Style Selector="Border.task-install-path">
    <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Field}"/>
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.Input.Padding}"/>
  <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        </Style>
</Styles>
