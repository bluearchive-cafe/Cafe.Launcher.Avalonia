<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:Cafe.Launcher.UI.Helpers"
        xmlns:fluent="using:FluentAvalonia.UI.Controls">
    <Style Selector="Border.toast-card">
        <!-- 外壳：中性实心底 + 1 DIP 中性描边。底色与资讯级 InfoBar 同源，使整卡（含
             左侧语义条所在的列）都落在同一表面上；严重级别只由语义条与本地化标题承担
             （ADR-070 2026-11-21 修订）。 -->
        <Setter Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Toast.Width}"/>
        <Setter Property="MaxWidth" Value="{StaticResource Launcher.Component.Toast.Width}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
    </Style>
    <!-- 左缘语义条：颜色是唯一的严重级别信号，宽度固定 4 DIP；整卡由中性底色承载。 -->
    <Style Selector="Border.toast-accent-bar">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Toast.AccentBar.Width}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.toast-card.toast-severity-informational Border.toast-accent-bar">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Info}"/>
    </Style>
    <Style Selector="Border.toast-card.toast-severity-error Border.toast-accent-bar">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Danger}"/>
    </Style>
    <Style Selector="Border.toast-card.toast-severity-warning Border.toast-accent-bar">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Warning}"/>
    </Style>
    <Style Selector="Border.toast-card.toast-severity-success Border.toast-accent-bar">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Success}"/>
    </Style>
    <Style Selector="Border.toast-card.motion-enabled.motion-enter:not(.motion-exit)">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.PointToPoint}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="{StaticResource Launcher.Motion.Offset.Toast}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.toast-card.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="{x:Static helpers:MotionTokens.FastDuration}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="{StaticResource Launcher.Motion.Offset.Toast}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.toast-host">
        <Setter Property="IsHitTestVisible" Value="True"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Toast.Host.Margin}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="StackPanel.toast-list">
        <Setter Property="Spacing" Value="{StaticResource Launcher.Spacing.Sm}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="StackPanel.toast-action-area">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Toast.Action.Area.Margin}"/>
    </Style>
    <Style Selector="WrapPanel.toast-actions">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Toast.Action.RowMargin}"/>
        <Setter Property="ItemSpacing" Value="{StaticResource Launcher.Spacing.Sm}"/>
        <Setter Property="LineSpacing" Value="{StaticResource Launcher.Spacing.Xs}"/>
    </Style>
    <Style Selector="Button.toast-primary-action, Button.toast-secondary-action">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.Toast.Action.MinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ProgressBar.toast-progress">
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Toast.Action.Progress.Height}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
</Styles>
