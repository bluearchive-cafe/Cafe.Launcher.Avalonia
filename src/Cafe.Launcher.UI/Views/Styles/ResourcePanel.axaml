<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Cafe.Launcher.UI.Controls">
  <Style Selector="Border.resource-card">
    <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
  </Style>
  <!-- 发丝分隔线（ADR-070 第二批像素对齐契约）：仅上缘描边，配合 UseLayoutRounding。 -->
  <Style Selector="Border.uid-section-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style Selector="Border.resource-row-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Divider.Top}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style Selector="TextBlock.uid-value">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.resource-row">
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.ResourcePanel.Row.Padding}"/>
  </Style>
  <Style Selector="Border.status-chip">
    <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.ResourcePanel.StatusChip.Height}"/>
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.ResourcePanel.StatusChip.Padding}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        </Style>
  <Style Selector="controls|FluentIcon.status-chip-icon">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.status-chip-text">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="controls|FluentIcon.info-strip-icon">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="controls|FluentIcon.status-strip-icon">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
</Styles>
