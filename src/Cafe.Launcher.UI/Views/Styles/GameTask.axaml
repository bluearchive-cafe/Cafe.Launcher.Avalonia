<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:Cafe.Launcher.UI.Helpers">
    <Style Selector="Border.game-task-card">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Background}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Lg}"/>
        <Setter Property="BoxShadow" Value="{helpers:BoxShadows {StaticResource Launcher.Elevation.Shadow.Dialog}}"/>
    </Style>
</Styles>
