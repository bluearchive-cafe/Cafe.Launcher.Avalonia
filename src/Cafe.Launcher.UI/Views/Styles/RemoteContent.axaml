<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Carousel.banner-carousel ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.banner-dot">
        <Setter Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Spacing.Xs}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Spacing.Xs}"/>
    </Style>
    <Style Selector="Border.banner-dot.active">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Spacing.Md}"/>
    </Style>
    <Style Selector="Button.social-action">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <Style Selector="TabControl.news-tabs">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TabControl.news-tabs TabItem">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Action.Compact.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <Style Selector="TextBlock.news-tab-label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Tabs.Header.Margin}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Body.Md}"/>
    </Style>
</Styles>
