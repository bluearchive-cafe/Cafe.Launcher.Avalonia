<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="StackPanel.log-filter-bar">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.LogViewer.FilterBar.Margin}"/>
    </Style>
    <Style Selector="Button.filter-tab">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.log-empty-state">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Background}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        </Style>
    <Style Selector="ListBox.log-entry-list">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Dialog.Content.BottomMargin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.log-export-warning">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.Md}"/>
    </Style>
</Styles>
