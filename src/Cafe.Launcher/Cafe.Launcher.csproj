<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher</AssemblyName>
    <RootNamespace>Cafe.Launcher</RootNamespace>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Cafe Launcher</Product>
    <Title>Cafe Launcher</Title>
    <Company>BlueArchive Cafe</Company>
    <Copyright>Copyright © BlueArchive Cafe contributors</Copyright>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- AVLN 码由 Avalonia XAML 编译器任务发出，TreatWarningsAsErrors（csc 范围）覆盖不到。 -->
    <MSBuildWarningsAsErrors>AVLN3001</MSBuildWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Cafe.Launcher.UI\Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">

    <SelfContained>true</SelfContained>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cafe.Launcher.UI\Cafe.Launcher.UI.csproj" />
    <ProjectReference Include="..\Cafe.Launcher.Core\Cafe.Launcher.Core.csproj" />
    <ProjectReference Include="..\Cafe.Launcher.Updater.Core\Cafe.Launcher.Updater.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="MarkView.Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Shirasagi0012.MaterialColorUtilities" />
  </ItemGroup>

  <Target Name="AddGitCommitMetadata" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=7 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitSha" />
    </Exec>
    <!-- 提交时间要按平台各写一份，因为百分号要穿过三层不同的处理：
         MSBuild 只认 %25（它会把 %25 还原成一个百分号，孤立的 % 会被它吃掉），
         Windows 的 cmd 会把 %% 折成一个百分号，而 Unix 的 sh 两者都不处理。
         因此 Windows 写 %%cI（cmd 折成 %cI），Unix 写 %25cI（MSBuild 还原成 %cI）：
         两边交给 git 的都是「一个百分号 + cI」。写成同一个 %%cI 会让 Linux 上的 git 收到
         两个字面百分号并原样输出 "%cI"（linux-unit-tests 抓到过）。 -->
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="git show -s --format=%%cI HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitTime" />
    </Exec>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="git show -s --format=%25cI HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitTime" />
    </Exec>
    <PropertyGroup>
      <GitCommitSha Condition="'$(GitCommitSha)' == ''">unknown</GitCommitSha>
      <GitCommitTime Condition="'$(GitCommitTime)' == ''">unknown</GitCommitTime>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="CommitSha" Value="$(GitCommitSha)" />
      <AssemblyMetadata Include="BuildTime" Value="$(GitCommitTime)" />
    </ItemGroup>
  </Target>
</Project>
