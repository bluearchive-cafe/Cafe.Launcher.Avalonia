            <x:Double x:Key="Launcher.Component.Settings.Appearance.Thumbnail.VideoBlurRadius">3</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Log.Path.MaxWidth">300</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Log.Level.MinWidth">110</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.SettingsPreview.MaxHeight">160</x:Double>
            <x:Double x:Key="Launcher.Control.Size.None">0</x:Double>
            <x:Double x:Key="Launcher.Control.Size.Swatch">28</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Chip">32</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Field">32</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Title.Height">56</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Confirm.MaxHeight">480</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Confirm.MaxWidth">440</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Confirm.MinWidth">392</x:Double>
            <!-- 内容型对话框（公告、错误、安装准备、卸载、更新说明）宽度档；
                 与确认框分开，避免用确认框的窄档挤压长正文。 -->
            <x:Double x:Key="Launcher.Component.Dialog.Content.MaxWidth">560</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Notice.MaxHeight">110</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Update.MaxWidth">560</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Update.MinWidth">480</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Update.MinHeight">320</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Update.ReleaseNotes.MaxHeight">240</x:Double>
            <!-- 对话框家族表面档案（ADR-015 / ADR-069）：实心中性表面 + 1 DIP 描边 + 8 圆角
                 + 双层阴影；不再使用壁纸玻璃。面板档（日志/资源/调试/画廊）沿用各自宽度。 -->
            <x:String x:Key="Launcher.Elevation.Shadow.Dialog">0 16 40 0 #330F1222, 0 2 6 0 #140F1222</x:String>
            <CornerRadius x:Key="Launcher.Component.Dialog.CornerRadius">8</CornerRadius>
            <!-- 警示由语义图标、文字和背景表达；无需额外强调左边框。 -->
            <CornerRadius x:Key="Launcher.Component.Dialog.Alert.CornerRadius">8</CornerRadius>
            <x:Double x:Key="Launcher.Component.Dialog.Badge.Size">32</x:Double>
            <CornerRadius x:Key="Launcher.Component.Dialog.Badge.CornerRadius">16</CornerRadius>
            <Thickness x:Key="Launcher.Component.Dialog.Panel.Head.Padding">20,0,10,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Panel.Body.Padding">24,18,24,18</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Panel.Footer.Padding">24,14,24,20</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Basic.Head.Padding">28,28,28,8</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Basic.Content.Padding">28,0,28,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Basic.Actions.Padding">28,16,28,24</Thickness>
            <x:Double x:Key="Launcher.Layout.LogViewer.Width">720</x:Double>
            <x:Double x:Key="Launcher.Layout.LogViewer.Height">592</x:Double>
            <!-- 日志正文顶端无边距（列表贴过滤栏下方），左右与底边保持对话框内缩。 -->
            <Thickness x:Key="Launcher.Component.LogViewer.Body.Padding">24,0,24,18</Thickness>
            <x:Double x:Key="Launcher.Component.LogViewer.Search.MinWidth">160</x:Double>
            <x:Double x:Key="Launcher.Component.LogViewer.EntryDetails.MaxHeight">120</x:Double>
            <x:Double x:Key="Launcher.Layout.LogExport.Width">560</x:Double>
            <x:Double x:Key="Launcher.Layout.LogExport.MaxHeight">640</x:Double>
            <!-- 资源面板 MD3 重设计（ADR-041）：状态 chip 与条目行密度。
                 ADR-070 第二批：分段按钮随整窗页一并退场，仅保留 chip 与行度量。 -->
            <x:Double x:Key="Launcher.Component.ResourcePanel.StatusChip.Height">24</x:Double>
            <Thickness x:Key="Launcher.Component.ResourcePanel.StatusChip.Padding">9,0</Thickness>
            <Thickness x:Key="Launcher.Component.ResourcePanel.Row.Padding">14,16</Thickness>
            <x:Double x:Key="Launcher.Component.SetupWizard.Select.MinWidth">280</x:Double>
            <Thickness x:Key="Launcher.Component.Dialog.Content.BottomMargin">0,0,0,8</Thickness>
            <x:Double x:Key="Launcher.Layout.DesignGallery.Width">1000</x:Double>
            <x:Double x:Key="Launcher.Layout.DesignGallery.Height">680</x:Double>
            <x:Double x:Key="Launcher.Component.DesignGallery.StateCell.Width">132</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Row.Content.MinWidth">0</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Control.MinWidth">220</x:Double>
            <x:Double x:Key="Launcher.Component.Input.MinWidth">160</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Action.MinWidth">80</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.BasicAction.MinWidth">80</x:Double>
            <x:Double x:Key="Launcher.Component.PrimaryAction.MinWidth">150</x:Double>
            <x:Double x:Key="Launcher.Component.BottomAction.MinWidth">156</x:Double>
            <x:Double x:Key="Launcher.Component.LauncherControl.Width">190</x:Double>
            <x:Double x:Key="Launcher.Component.Menu.Separator.Height">1</x:Double>
            <Thickness x:Key="Launcher.Component.Menu.Separator.Margin">8,4</Thickness>
            <x:Double x:Key="Launcher.Component.LaunchSplit.Separator.Width">1</x:Double>
            <Thickness x:Key="Launcher.Component.LaunchSplit.Separator.Margin">0,12</Thickness>
            <x:Double x:Key="Launcher.Component.LaunchSplit.Menu.VerticalOffset">-8</x:Double>
            <x:Double x:Key="Launcher.Component.LaunchSplit.MinWidth">180</x:Double>
            <x:Double x:Key="Launcher.Component.RemoteSurface.Width">476</x:Double>
            <x:Double x:Key="Launcher.Component.RemoteSurface.MinHeight">160</x:Double>
            <x:Double x:Key="Launcher.Component.RemoteSurface.MaxHeight">480</x:Double>
            <x:Double x:Key="Launcher.Component.NoticeCard.MaxHeight">160</x:Double>
            <x:Double x:Key="Launcher.Component.ControlPanel.MinHeight">156</x:Double>
            <x:Double x:Key="Launcher.Component.ColorSwatch.Preview.Size">16</x:Double>
            <!-- 设置向导舞台（ADR-059）：全幅头部 + 左引导 / 右面板 + 全幅动作带；
                 六个步骤共用同一解剖，仅右面板内容随步骤变化。 -->
            <x:Double x:Key="Launcher.Component.Wizard.Stage.MaxWidth">680</x:Double>
            <Thickness x:Key="Launcher.Component.Wizard.Stage.Margin">24,0</Thickness>
            <Thickness x:Key="Launcher.Component.Wizard.Header.Padding">24,16,24,14</Thickness>
            <Thickness x:Key="Launcher.Component.Wizard.Body.Margin">0,20,0,16</Thickness>
            <Thickness x:Key="Launcher.Component.Wizard.Footer.Padding">24,0</Thickness>
            <x:Double x:Key="Launcher.Component.Wizard.Footer.Height">64</x:Double>
            <x:Double x:Key="Launcher.Component.Wizard.Progress.Height">3</x:Double>
            <!-- 动作带两枚动作的最小宽度：大于共享 80 DIP，使不同文案与语言下
                 上一步、下一步保持同宽（ADR-059 的表面级例外，角色外观仍走共享主题）。 -->
            <x:Double x:Key="Launcher.Component.Wizard.Action.MinWidth">100</x:Double>
            <!-- 协议步骤：版次 pill 在左引导，同意项固定在文档面板底栏。
                 左右留白与文档阅读器同取 20，保持面板内边距一致。 -->
            <Thickness x:Key="Launcher.Component.Wizard.Agreement.Version.Padding">8,2</Thickness>
            <x:Double x:Key="Launcher.Component.Wizard.Agreement.Panel.MaxHeight">260</x:Double>
            <Thickness x:Key="Launcher.Component.Wizard.Agreement.Consent.Padding">20,12</Thickness>
            <x:Double x:Key="Launcher.Component.Wizard.Divider.Height">1</x:Double>
            <!-- 复核页图标摘要行的度量。 -->
            <x:Double x:Key="Launcher.Component.Wizard.Summary.Row.MinHeight">56</x:Double>
            <x:Double x:Key="Launcher.Component.Wizard.Summary.IconChip.Size">36</x:Double>
            <!-- 欢迎页配置概览：五行紧凑清单的行高与图标块尺寸。 -->
            <x:Double x:Key="Launcher.Component.Wizard.Welcome.Row.MinHeight">42</x:Double>
            <x:Double x:Key="Launcher.Component.Wizard.Welcome.Icon.Size">34</x:Double>
            <!-- M3 选项行：两行内容（标题 + 说明）的最小命中行高与内容内边距。 -->
            <x:Double x:Key="Launcher.Component.Wizard.Option.MinHeight">64</x:Double>
            <Thickness x:Key="Launcher.Component.Wizard.Option.Padding">14,13</Thickness>
            <Thickness x:Key="Launcher.Component.Wizard.Option.Label.Margin">12,0,0,0</Thickness>
            <x:Double x:Key="Launcher.Component.Settings.Row.MinHeight">48</x:Double>
            <Thickness x:Key="Launcher.Component.Settings.Row.Content.Padding">0,8</Thickness>
            <x:Double x:Key="Launcher.Component.Settings.Row.Action.MaxWidth">440</x:Double>
            <!-- 折叠标题是独立可点表面：比设置行略矮，左右内缩让文字与箭头不贴边。 -->
            <x:Double x:Key="Launcher.Component.Settings.Expander.Header.MinHeight">48</x:Double>
            <Thickness x:Key="Launcher.Component.Settings.Expander.Header.Padding">12,6</Thickness>
            <x:Double x:Key="Launcher.Component.Loading.Bar.Width">120</x:Double>
            <x:Double x:Key="Launcher.Component.Loading.Bar.Height">4</x:Double>
            <x:Double x:Key="Launcher.Component.Progress.Bar.Height">8</x:Double>
            <x:Double x:Key="Launcher.Component.Tabs.Indicator.Height">2</x:Double>
            <x:Double x:Key="Launcher.Component.Tabs.Header.MinHeight">36</x:Double>
            <Thickness x:Key="Launcher.Border.Thickness.Default">1</Thickness>
            <Thickness x:Key="Launcher.Border.Thickness.Focus">2</Thickness>
            <x:Double x:Key="Launcher.Component.Toast.Action.Progress.Height">3</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.Width">392</x:Double>
            <x:Double x:Key="Launcher.Component.ToolTip.MinHeight">24</x:Double>
            <x:Double x:Key="Launcher.Component.ToolTip.MaxWidth">320</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Toast">12</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Surface">8</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Bottom">12</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.StepForward">14</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.StepBackward">-14</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.CarouselManual">18</x:Double>
            <!-- Windows 语义曲线（与已确认的原型一致）：进入减速 / 退出加速 / 点到点位移。 -->
            <SplineEasing x:Key="Launcher.Motion.Easing.Enter" X1="0" Y1="0" X2="0" Y2="1"/>
            <SplineEasing x:Key="Launcher.Motion.Easing.Exit" X1="1" Y1="0" X2="1" Y2="1"/>
            <SplineEasing x:Key="Launcher.Motion.Easing.PointToPoint" X1="0.55" Y1="0.55" X2="0" Y2="1"/>
            <!-- Elevation (阴影 0–3 档；颜色/偏移/模糊 token 化；P2 全面消费) -->
            <!-- 注：BoxShadow 为值类型，只能经转换器加载（AVLN3000），故以 x:String 存储，
                 由 Helpers.BoxShadowsExtension 在加载期解析（DialogSurface 主题已消费）。 -->
            <x:String x:Key="Launcher.Elevation.Shadow.None">0 0 0 0 #00000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Sm">0 4 8 0 #26000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Md">0 12 32 0 #33000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Lg">0 22 55 0 #66000000</x:String>
            <!-- StateLayer (状态层不透明度 8/12/16/24%；P2 状态矩阵消费) -->
            <x:Double x:Key="Launcher.StateLayer.Hover">0.08</x:Double>
            <x:Double x:Key="Launcher.StateLayer.Focus">0.12</x:Double>
            <x:Double x:Key="Launcher.StateLayer.Pressed">0.16</x:Double>
            <x:Double x:Key="Launcher.StateLayer.Selected">0.24</x:Double>
            <x:Double x:Key="Launcher.StateLayer.Disabled.Content">0.38</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Label.Sm">12</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Label.Md">12</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Sm">13</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Md">14</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Lg">15</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Title.Md">16</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Title.Lg">17</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Headline.Md">20</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Headline.Lg">20</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Display">22</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Hero">42</x:Double>
            <FontWeight x:Key="Launcher.Typography.FontWeight.Normal">Normal</FontWeight>
            <FontWeight x:Key="Launcher.Typography.FontWeight.Strong">SemiBold</FontWeight>
            <FontFamily x:Key="Launcher.Typography.FontFamily.Monospace">Consolas</FontFamily>
            <!-- 协议正文固定为简体中文；显式 CJK 族避免按界面语言继承时把中文交给
                 字体回退链，回退选择随进程内已加载字体变化，截图与实机都可能漂移。 -->
            <FontFamily x:Key="Launcher.Typography.FontFamily.Document">Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, PingFang SC, sans-serif</FontFamily>
            <!-- LetterSpacing (字距角色键；P1 仅提供刻度，消费与取值校准随 P2 字阶) -->
            <x:Double x:Key="Launcher.Typography.LetterSpacing.None">0</x:Double>
            <x:Double x:Key="Launcher.Typography.LetterSpacing.Sm">0.5</x:Double>
            <x:Double x:Key="Launcher.Typography.LetterSpacing.Md">1</x:Double>
            <x:Double x:Key="Launcher.Typography.LetterSpacing.Lg">2</x:Double>
            <SolidColorBrush x:Key="Launcher.Color.Primary" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Hover" Color="{DynamicResource SystemAccentColorLight1}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Pressed" Color="{DynamicResource SystemAccentColorDark1}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Soft" Color="{DynamicResource SystemAccentColor}" Opacity="0.10"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Border" Color="{DynamicResource SystemAccentColor}" Opacity="0.40"/>
            <SolidColorBrush x:Key="Launcher.Color.Settings.Select.Selected.Foreground" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.Settings.Select.Selected.Foreground.Hover" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.Settings.Select.Selected.Foreground.Pressed" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.OnPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Text.OnChrome" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Text.OnDark" Color="#D9FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Transparent" Color="#00000000"/>
            <SolidColorBrush x:Key="Launcher.Color.Chrome.Hover" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Chrome.Pressed" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger" Color="#FFD93840"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger.Hover" Color="#FFD32F35"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger.Pressed" Color="#FFC9353A"/>
            <SolidColorBrush x:Key="Launcher.Color.Error" Color="#FFD93840"/>
            <SolidColorBrush x:Key="Launcher.Color.Error.Hover" Color="#FFD32F35"/>
            <SolidColorBrush x:Key="Launcher.Color.Error.Pressed" Color="#FFC9353A"/>
            <SolidColorBrush x:Key="Launcher.Color.OnError" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Overlay.Scrim.Sm" Color="#40000000"/>
            <SolidColorBrush x:Key="Launcher.Color.Overlay.Scrim.Md" Color="#99000000"/>
            <SolidColorBrush x:Key="Launcher.Color.Overlay.Scrim.Lg" Color="#E6000000"/>
            <SolidColorBrush x:Key="Launcher.Color.FocusRing" Color="{DynamicResource SystemAccentColor}" Opacity="0.60"/>
            <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Active" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Inactive" Color="#99D0D4DA"/>
            <SolidColorBrush x:Key="Launcher.Color.Warning" Color="#FFB45309"/>
            <SolidColorBrush x:Key="Launcher.Color.Info" Color="#FF2E7DF6"/>
            <SolidColorBrush x:Key="Launcher.Color.Media.Placeholder" Color="#FF2A3A5C"/>
            <SolidColorBrush x:Key="Launcher.Text.Media.Placeholder" Color="#99FFFFFF"/>
            <!-- M3 scheme 角色占位/回退值（运行时由 ApplyScheme 经 DynamicScheme 覆盖；spec §2.3：声明值仅为占位） -->
            <SolidColorBrush x:Key="Launcher.Color.Secondary" Color="#FF625B71"/>
            <SolidColorBrush x:Key="Launcher.Color.OnSecondary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.SecondaryContainer" Color="#FFE8DEF8"/>
            <SolidColorBrush x:Key="Launcher.Color.OnSecondaryContainer" Color="#FF1D192B"/>
            <SolidColorBrush x:Key="Launcher.Color.OnSecondaryContainer.Hover" Color="#FF1D192B"/>
            <SolidColorBrush x:Key="Launcher.Color.OnSecondaryContainer.Pressed" Color="#FF1D192B"/>
            <SolidColorBrush x:Key="Launcher.Color.SecondaryContainer.Hover" Color="#FFD8CEE8"/>
            <SolidColorBrush x:Key="Launcher.Color.SecondaryContainer.Pressed" Color="#FFC8BED7"/>
            <SolidColorBrush x:Key="Launcher.Color.Tertiary" Color="#FF7D5260"/>
            <SolidColorBrush x:Key="Launcher.Color.OnTertiary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.TertiaryContainer" Color="#FFFFD8E4"/>
            <SolidColorBrush x:Key="Launcher.Color.OnTertiaryContainer" Color="#FF31111D"/>
            <SolidColorBrush x:Key="Launcher.Color.PrimaryContainer" Color="#FFEADDFF"/>
            <SolidColorBrush x:Key="Launcher.Color.OnPrimaryContainer" Color="#FF21005D"/>
            <SolidColorBrush x:Key="Launcher.Color.Surface" Color="#FFFEF7FF"/>
            <SolidColorBrush x:Key="Launcher.Color.OnSurface" Color="#FF1D1B20"/>
            <SolidColorBrush x:Key="Launcher.Color.Outline" Color="#FF79747E"/>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 模板构建阶段某些资源请求不带具体变体（Default）；Avalonia 不会把
                     Default 回退到 Light/Dark，因此这里给 ColorPicker 旧键留一份中性兜底。 -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="SystemControlForegroundListLowBrush" Color="#FF5F5F5F"/>
                    <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Launcher.Color.Primary.Soft"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Launcher.Color.InverseSurface" Color="#FF333333"/>
                    <SolidColorBrush x:Key="Launcher.Color.InverseOnSurface" Color="#FFF2F2F2"/>
                    <SolidColorBrush x:Key="Launcher.Text.Primary" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="#FF5F5F5F"/>
                    <SolidColorBrush x:Key="Launcher.Text.Body" Color="#FF454545"/>
                    <SolidColorBrush x:Key="Launcher.Text.Link" Color="#FF313233"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Background" Color="#EAF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Bottom.Background" Color="#F2F3F3F3"/>
                    <!-- 壁纸上的半透明表面：主界面边框与浮层 90%，嵌套内容卡 94%；
                         不透明度下限保证极端明暗壁纸下正文仍满足 AA。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Background" Color="#E6F3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Card.Background" Color="#F0FFFFFF"/>
                    <!-- 首页浮层：左侧图标栏与强档内容表面（任务卡、菜单、工具提示）。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Rail.Background" Color="#EBF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Strong.Background" Color="#C9FFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Edge" Color="#191F3755"/>
                    <LinearGradientBrush x:Key="Launcher.Color.Header.Scrim" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#00F3F3F3"/>
                        <GradientStop Offset="1" Color="#D9F3F3F3"/>
                    </LinearGradientBrush>
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="Launcher.Color.Glass.Strong.Background"/>
                    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="Launcher.Color.Glass.Edge"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Border" Color="#FFE5E5E5"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Background" Color="#FFF3F3F3"/>
                    <!-- FluentAvalonia 的资讯级 InfoBar 底色（SystemFillColorAttentionBackground）
                         是半透明（浅色 50%、深色 3%），叠在壁纸上会像透明卡。Toast 契约要求
                         实心语义表面（ADR-070），改用同主题的 SolidAttentionBackground。 -->
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FFF7F7F7"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Header" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Footer" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Hover" Color="#FFE9E9E9"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Pressed" Color="#FFDEDEDE"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Border" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Background" Color="#FFFBFBFB"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Hover" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Pressed" Color="#FFEDEDED"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.Background" Color="#FFDCEFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Notice.Background" Color="#FFFFF6D8"/>
                    <SolidColorBrush x:Key="Launcher.Color.Warning.Background" Color="#FFFFF2C2"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.Soft" Color="#FFFFECEE"/>
                    <!-- soft 底色上的状态文字/图标：与 *Soft 成对，保证 4.5:1（ADR-041）。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Danger.OnSoft" Color="#FFC42B33"/>
                    <SolidColorBrush x:Key="Launcher.Color.Success.OnSoft" Color="#FF126B33"/>
                    <!-- 壁纸玻璃上的语义前景：玻璃会透出任意明暗壁纸，根档在极端组合下不足 3:1/4.5:1。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Danger.OnGlass" Color="#FFA3222A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.OnGlass" Color="#FF1A56B8"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row" Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row.Hover" Color="#0A000000"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Border" Color="#FFD1D1D1"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Hover" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Pressed" Color="#FFEDEDED"/>
                    <!-- 对话框动作带的标准（次要）动作底色：Fluent 标准按钮有静止填充，不是透明描边。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Action.Background" Color="#FFFBFBFB"/>
                    <SolidColorBrush x:Key="Launcher.Color.SocialChip.Hover" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.SocialChip.Pressed" Color="#FFEDEDED"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Border" Color="#FFE5E5E5"/>
                    <SolidColorBrush x:Key="Launcher.Text.Info" Color="#FF24415E"/>
                    <SolidColorBrush x:Key="Launcher.Color.Success" Color="#FF15803D"/>
                    <!-- 状态 chip（Ready）的浅色底色；与 Success 前景成对（ADR-041）。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Success.Soft" Color="#FFD9F4E9"/>
                    <!-- 对话框正文内的发丝分隔线：弱于 Card.Border 的一阶（ADR-041）。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Section.Divider" Color="#FFE5E5E5"/>
                    <!-- ADR-070 第二批：设置折叠区与设置下拉走 FA 原生模板，状态色经资源键覆盖收口。
                         声明值与 Field/Error 档占位一致，运行时由 MaterialSchemeGenerator 随方案重写：
                         折叠区静止表面保持安静、悬停/按压描边取 Field.Border；下拉为实心 Field 底
                         与同色描边，悬停不换底，:error 取应用错误档。 -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="ExpanderBorderPressedBrush" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFD93840"/>
                    <!-- Avalonia.Controls.ColorPicker 的 Fluent 主题仍引用 WinUI 2 旧键；
                         缺少兼容的 Fluent 资源时这些键不存在，会直接抛 KeyNotFound。 -->
                    <StaticResource x:Key="SystemControlBackgroundBaseLowBrush" ResourceKey="Launcher.Color.Content.Row.Hover"/>
                    <StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="Launcher.Text.Primary"/>
                    <StaticResource x:Key="SystemControlForegroundListLowBrush" ResourceKey="Launcher.Text.Secondary"/>
                    <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Launcher.Color.Primary.Soft"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Launcher.Color.InverseSurface" Color="#FFF2F2F2"/>
                    <SolidColorBrush x:Key="Launcher.Color.InverseOnSurface" Color="#FF333333"/>
                    <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Inactive" Color="#FF5A6270"/>
                    <SolidColorBrush x:Key="Launcher.Text.Primary" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="#FFC5C5C5"/>
                    <SolidColorBrush x:Key="Launcher.Text.Body" Color="#FFD0D0D0"/>
                    <SolidColorBrush x:Key="Launcher.Text.Link" Color="#FFDDE7F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Background" Color="#E81E1E1E"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Bottom.Background" Color="#F21E1E1E"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Background" Color="#E6202020"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Card.Background" Color="#F02B2B2B"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Rail.Background" Color="#EB202020"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Strong.Background" Color="#D12B2B2B"/>
                    <SolidColorBrush x:Key="Launcher.Color.Glass.Edge" Color="#1FFFFFFF"/>
                    <LinearGradientBrush x:Key="Launcher.Color.Header.Scrim" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#00202020"/>
                        <GradientStop Offset="1" Color="#D9202020"/>
                    </LinearGradientBrush>
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="Launcher.Color.Glass.Strong.Background"/>
                    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="Launcher.Color.Glass.Edge"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Background" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Border" Color="#FF3A3A3A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Background" Color="#FF202020"/>
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FF2E2E2E"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Header" Color="#FF202020"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Footer" Color="#FF202020"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Hover" Color="#FF2E2E2E"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Pressed" Color="#FF383838"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Background" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Border" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Background" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Hover" Color="#FF383838"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Secondary.Pressed" Color="#FF424242"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.Background" Color="#FF19324D"/>
                    <SolidColorBrush x:Key="Launcher.Color.Notice.Background" Color="#FF352D17"/>
                    <SolidColorBrush x:Key="Launcher.Color.Warning.Background" Color="#FF463817"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.Soft" Color="#FF3A1D22"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.OnSoft" Color="#FFE4676F"/>
                    <SolidColorBrush x:Key="Launcher.Color.Success.OnSoft" Color="#FF4ADE80"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.OnGlass" Color="#FFF58A91"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.OnGlass" Color="#FF6EA8FF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row" Color="#FF272727"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row.Hover" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Border" Color="#FF3A3A3A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Hover" Color="#FF383838"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Pressed" Color="#FF424242"/>
                    <!-- 对话框动作带的标准（次要）动作底色：Fluent 标准按钮有静止填充，不是透明描边。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Action.Background" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="Launcher.Color.SocialChip.Hover" Color="#FF383838"/>
                    <SolidColorBrush x:Key="Launcher.Color.SocialChip.Pressed" Color="#FF424242"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Background" Color="#FF192232"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Border" Color="#FF3A3A3A"/>
                    <SolidColorBrush x:Key="Launcher.Text.Info" Color="#FFD6E8FF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Success" Color="#FF4ADE80"/>
                    <!-- 深色卡片上的警示前景：根档 #B45309 在 #2B2B2B 上不足 3:1。 -->
                    <SolidColorBrush x:Key="Launcher.Color.Warning" Color="#FFE9A23B"/>
                    <SolidColorBrush x:Key="Launcher.Color.Success.Soft" Color="#FF16302A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Section.Divider" Color="#FF3A3A3A"/>
                    <!-- 同 Light 档：设置折叠区与下拉的状态键覆盖，运行时随方案重写。 -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="ExpanderBorderPressedBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFD93840"/>
                    <!-- 同 Light 档：ColorPicker 旧 WinUI 2 资源键桥接。 -->
                    <StaticResource x:Key="SystemControlBackgroundBaseLowBrush" ResourceKey="Launcher.Color.Content.Row.Hover"/>
                    <StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="Launcher.Text.Primary"/>
                    <StaticResource x:Key="SystemControlForegroundListLowBrush" ResourceKey="Launcher.Text.Secondary"/>
                    <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Launcher.Color.Primary.Soft"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <fluentStyling:FluentAvaloniaTheme PreferUserAccentColor="True" />
        <!-- 启动器图标使用 FluentAvalonia 内置字体的矢量轮廓。 -->
        <Style Selector="controls|FluentIcon">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
        </Style>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml"/>
        <StyleInclude Source="avares://Cafe.Launcher.UI/Views/MainWindow.Styles.axaml"/>
    </Application.Styles>
</Application>
