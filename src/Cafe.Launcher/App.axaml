<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cafe.Launcher.App"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:fluentStyling="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Design Tokens — usage rules live in PROJECT_CONVENTIONS.md §2.3; gallery overlay shows live values -->
            <x:Double x:Key="Launcher.Spacing.None">0</x:Double>
            <x:Double x:Key="Launcher.Component.GameTask.Width">382</x:Double>
            <x:Double x:Key="Launcher.Component.GameTask.TitleWidth">220</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xs">4</x:Double>
            <x:Double x:Key="Launcher.Spacing.Sm">8</x:Double>
            <x:Double x:Key="Launcher.Spacing.Md">12</x:Double>
            <x:Double x:Key="Launcher.Spacing.Lg">16</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xl">20</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xxl">24</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xxxl">32</x:Double>
            <x:Double x:Key="Launcher.Spacing.Section">40</x:Double>
            <Thickness x:Key="Launcher.Spacing.Thickness.Xs">4</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Sm">8</Thickness>
