            <Thickness x:Key="Launcher.Spacing.Thickness.Lg">16</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Xxl">24</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Xxxl">32</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Section">40</Thickness>
            <Thickness x:Key="Launcher.Component.PathField.Padding">16,0,4,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.RowMargin">0,8,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.Area.Margin">0,0,0,12</Thickness>
            <!-- ADR-070：Toast 是 FAInfoBar 的唯一消费方。压掉其模板默认的中性描边，
                 1 DIP 中性描边由卡片外框绘制（Views/Styles/Toast.axaml）。 -->
            <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Alert.BorderThickness">0</Thickness>
            <Thickness x:Key="Launcher.Component.Markdown.Quote.BorderThickness">3,0,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Tabs.Header.Margin">0,0,0,8</Thickness>
            <Thickness x:Key="Launcher.Component.Tabs.Indicator.Margin">0,4,0,2</Thickness>
            <Thickness x:Key="Launcher.Component.DesignGallery.StateCell.Padding">8,4</Thickness>
            <Thickness x:Key="Launcher.Component.FilterTab.Padding">10,4</Thickness>
            <!-- 关于分区解剖（ADR-018 融合变体）：key-value/链接行密度。 -->
            <x:Double x:Key="Launcher.Component.About.KvRow.MinHeight">40</x:Double>
            <Thickness x:Key="Launcher.Component.About.KvRow.Margin">16,0,16,0</Thickness>
            <x:Double x:Key="Launcher.Component.About.CreditRow.MinHeight">64</x:Double>
            <Thickness x:Key="Launcher.Component.About.CreditRow.Padding">16,8</Thickness>
            <CornerRadius x:Key="Launcher.Component.About.CreditRow.CornerRadius">0</CornerRadius>
            <x:Double x:Key="Launcher.Component.About.CreditAvatar.Size">40</x:Double>
            <!-- 身份卡图标：48 DIP 位图按 8 圆角裁切；主操作与文字块拉开一档间距。 -->
            <x:Double x:Key="Launcher.Component.About.AppIcon.Size">48</x:Double>
            <CornerRadius x:Key="Launcher.Component.About.AppIcon.CornerRadius">8</CornerRadius>
            <Thickness x:Key="Launcher.Component.About.IdentityAction.Margin">0,16,0,0</Thickness>
            <x:Double x:Key="Launcher.Component.About.IdentityAction.MinHeight">40</x:Double>
            <Thickness x:Key="Launcher.Component.About.IdentityAction.Padding">20,0</Thickness>
            <Thickness x:Key="Launcher.Component.Input.Padding">12,5</Thickness>
            <!-- Fluent 2 菜单/下拉行：固定 32 DIP 行高，纵向不留内边距。 -->
            <Thickness x:Key="Launcher.Component.MenuItem.Padding">12,0</Thickness>
            <Thickness x:Key="Launcher.Component.WrapAction.Margin">0,0,8,8</Thickness>
            <!-- 过滤栏下边距承担与日志列表的间距：位于固定工具行，不随内容滚动。 -->
            <Thickness x:Key="Launcher.Component.LogViewer.FilterBar.Margin">24,12,24,18</Thickness>
            <Thickness x:Key="Launcher.Component.Select.Padding">12,0</Thickness>
            <!-- 设置整窗页（ADR-070）：标题栏以下、图标栏右侧的页面几何。 -->
            <Thickness x:Key="Launcher.Component.Settings.Page.Offset">64,48,0,0</Thickness>
            <!-- 跨表面共享的上缘发丝线：设置页框/页头/页脚、分组行分隔与资源面板分区。 -->
            <Thickness x:Key="Launcher.Component.Divider.Top">0,1,0,0</Thickness>
            <x:Double x:Key="Launcher.Component.Settings.Head.MinHeight">56</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Footer.MinHeight">64</x:Double>
            <Thickness x:Key="Launcher.Component.Settings.Header.Padding">24,0</Thickness>
            <x:Double x:Key="Launcher.Component.Settings.Navigation.Width">216</x:Double>
            <Thickness x:Key="Launcher.Component.Settings.Content.Padding">24,16,24,8</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Content.Scroll.Padding">24,0,24,16</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Navigation.List.Padding">8,8,8,16</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Navigation.Item.Margin">0,2</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Navigation.Item.Padding">10,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Title.Margin">16,0,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Header.Panel.Padding">24,16,24,12</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Header.Basic.Padding">24,20,24,12</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Body.Padding">24,0,24,8</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Footer.Padding">24,16</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.Footer.BorderThickness">0,1,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.FooterLeading.Margin">0,0,12,0</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Group.Margin">0,20,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Settings.Group.Title.Margin">0,0,0,8</Thickness>
            <!-- 右缩进与 Content.Scroll.Padding 的滚动条槽位同宽，标题行在滚动区之外。 -->
            <Thickness x:Key="Launcher.Component.Settings.Footer.Padding">24,12</Thickness>
            <Thickness x:Key="Launcher.Component.ContentRow.Margin">0,0,0,4</Thickness>
            <Thickness x:Key="Launcher.Component.Scroll.Pad">0,0,8,0</Thickness>
            <Thickness x:Key="Launcher.Component.Action.Primary.Padding">20,12</Thickness>
            <Thickness x:Key="Launcher.Component.Action.Outlined.Padding">12,8</Thickness>
            <Thickness x:Key="Launcher.Component.Action.Dialog.Padding">16,0</Thickness>
            <Thickness x:Key="Launcher.Component.Dialog.BasicAction.Padding">12,0</Thickness>
            <Thickness x:Key="Launcher.Component.Action.Launcher.Padding">20,0</Thickness>
            <Thickness x:Key="Launcher.Component.Action.Compact.Padding">8,4</Thickness>
            <Thickness x:Key="Launcher.Component.ToolTip.Padding">8,4</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Host.Margin">0,84,24,16</Thickness>
            <!-- 横向条目行共享面板（主壳内容行 / 外观色板行）；值经 StaticResource 引用间距刻度。 -->
            <ItemsPanelTemplate x:Key="Launcher.Component.RowPanel.Sm">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}"/>
            </ItemsPanelTemplate>
            <CornerRadius x:Key="Launcher.Radius.Xs">4</CornerRadius>
            <CornerRadius x:Key="Launcher.Radius.Sm">8</CornerRadius>
            <CornerRadius x:Key="Launcher.Radius.Md">8</CornerRadius>
            <CornerRadius x:Key="Launcher.Radius.Lg">8</CornerRadius>
            <!-- 整圆（分段按钮端头 / 状态 chip / pill 形状）；ADR-041 资源面板重设计引入。 -->
            <CornerRadius x:Key="Launcher.Radius.Full">999</CornerRadius>
            <CornerRadius x:Key="Launcher.Component.Banner.Indicator.CornerRadius">1</CornerRadius>
            <!-- 横幅与信息卡无缝拼接：接缝侧平角，外缘保留 Radius.Sm。 -->
            <CornerRadius x:Key="Launcher.Component.RemoteContent.JoinedUpper.CornerRadius">8,8,0,0</CornerRadius>
            <CornerRadius x:Key="Launcher.Component.RemoteContent.JoinedLower.CornerRadius">0,0,8,8</CornerRadius>
            <x:Double x:Key="Launcher.Icon.Xs">9</x:Double>
            <x:Double x:Key="Launcher.Icon.Sm">16</x:Double>
            <x:Double x:Key="Launcher.Icon.Md">18</x:Double>
            <x:Double x:Key="Launcher.Icon.Lg">20</x:Double>
            <x:Double x:Key="Launcher.Icon.Xl">22</x:Double>
            <x:Double x:Key="Launcher.Icon.Xxl">24</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Setting">32</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Dialog">32</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Bottom">48</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Launch">58</x:Double>
            <x:Double x:Key="Launcher.Control.MinWidth.None">0</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.Action.MinHeight">32</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.AccentBar.Width">4</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Width">720</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Height">540</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.RailWidth">64</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.Rail.Item.Size">44</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.Rail.Icon.Size">30</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.LogoHeight">80</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.LogoWidth">222</x:Double>
            <x:Double x:Key="Launcher.Layout.Home.Header.Height">48</x:Double>
            <Thickness x:Key="Launcher.Layout.Home.Header.Margin">12,0,138,0</Thickness>
            <Thickness x:Key="Launcher.Layout.Home.Rail.Padding">10,8</Thickness>
