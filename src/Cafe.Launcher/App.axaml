            <Thickness x:Key="Launcher.Component.GameSidebar.Indicator.Margin">2,0,0,0</Thickness>
            <x:Double x:Key="Launcher.Component.Rail.Badge.Size">16</x:Double>
            <Thickness x:Key="Launcher.Component.Rail.Badge.Margin">0,0,1,1</Thickness>
            <Thickness x:Key="Launcher.Component.NoticeCard.Margin">12,12,12,0</Thickness>
            <Thickness x:Key="Launcher.Component.SocialActions.Margin">12,0,12,12</Thickness>
            <Thickness x:Key="Launcher.Component.RemoteSurface.Margin">0</Thickness>
            <x:String x:Key="Launcher.Elevation.Shadow.Surface">0 5 18 0 #30000000</x:String>
            <x:Double x:Key="Launcher.Layout.Home.Header.Scrim.Width">360</x:Double>
            <x:Double x:Key="Launcher.Layout.Window.Width">1300</x:Double>
            <x:Double x:Key="Launcher.Layout.Window.Height">754</x:Double>
            <x:Double x:Key="Launcher.Layout.Window.MinWidth">1024</x:Double>
            <x:Double x:Key="Launcher.Layout.Window.MinHeight">640</x:Double>
            <x:Double x:Key="Launcher.Layout.Banner.Height">220</x:Double>
            <x:Double x:Key="Launcher.Layout.Banner.EdgeGradient.Width">180</x:Double>
            <x:Double x:Key="Launcher.Layout.News.Viewport.Height">184</x:Double>
            <Thickness x:Key="Launcher.Component.Banner.Indicator.Margin">0,0,0,16</Thickness>
            <x:Double x:Key="Launcher.Layout.SetupWizard.Width">920</x:Double>
            <x:Double x:Key="Launcher.Layout.SetupWizard.Height">560</x:Double>
            <x:Double x:Key="Launcher.Layout.ResourcePanel.Width">720</x:Double>
            <x:Double x:Key="Launcher.Layout.ResourcePanel.Height">592</x:Double>
            <x:Double x:Key="Launcher.Layout.Appearance.Preview.Width">212</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Appearance.Thumbnail.Width">64</x:Double>
