<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.UI.Controls"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="Cafe.Launcher.CrashReportApp"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferUserAccentColor="False"/>
        <Style Selector="controls|FluentIcon">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
        </Style>
    </Application.Styles>
</Application>
