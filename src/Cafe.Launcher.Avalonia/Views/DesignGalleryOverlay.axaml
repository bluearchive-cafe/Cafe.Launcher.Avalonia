<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.DesignGalleryOverlay"
             x:Name="GalleryRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="dialog-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsDebugInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding Gallery.IsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <Border Width="{StaticResource Launcher.Layout.DesignGallery.Width}"
                Height="{StaticResource Launcher.Layout.DesignGallery.Height}"
                Classes="dialog overlay-dialog motion-surface">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid RowDefinitions="Auto,*,Auto" Classes="motion-surface-content">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Classes="dialog-header">
                    <StackPanel Classes="dialog-title-row">
                        <TextBlock Text="{Binding Shell.I18n[designGalleryTitle]}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dialog-close header-action" Command="{Binding Gallery.CloseCommand}"
                            ToolTip.Tip="{Binding Shell.I18n[close]}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </Button>
                </Grid>

                <!-- Scrollable token inventory -->
                <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}" Margin="{StaticResource Launcher.Spacing.Thickness.Xl}">
                        <TextBlock Text="{Binding Shell.I18n[designGalleryHint]}" Classes="caption"/>
                        <Border Classes="dialog-card design-state-matrix-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[designGalleryTitle]}" Classes="section-title"/>
                                <TextBlock Text="{Binding Shell.I18n[designGalleryHint]}" Classes="caption"/>
                                <Grid Classes="design-state-matrix"
                                      ColumnDefinitions="Auto,*,*,*,*,*,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[designGalleryTitle]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[themeColorDefault]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[working]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[startGame]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[statusLaunchCheckNone]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="5" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[settingsGroupDisplay]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="6" Classes="design-state-header"
                                               Text="{Binding Shell.I18n[toastError]}"/>

                                    <TextBlock Grid.Row="1" Classes="design-state-component"
                                               Text="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="gallery-button state-normal" IsTabStop="False"
                                            Content="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Classes="gallery-button state-hover" IsTabStop="False"
                                            Content="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="3" Classes="gallery-button state-pressed" IsTabStop="False"
                                            Content="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="4" Classes="gallery-button state-disabled" IsTabStop="False"
                                            IsEnabled="False" Content="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="5" Classes="gallery-button state-focus" IsTabStop="False"
                                            Content="{Binding Shell.I18n[startGame]}"/>
                                    <Button Grid.Row="1" Grid.Column="6" Classes="gallery-button state-invalid" IsTabStop="False"
                                            Content="{Binding Shell.I18n[startGame]}"/>

                                    <TextBlock Grid.Row="2" Classes="design-state-component"
                                               Text="{Binding Shell.I18n[themeColor]}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Classes="gallery-select state-normal" IsTabStop="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="2" Grid.Column="2" Classes="gallery-select state-hover" IsTabStop="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="2" Grid.Column="3" Classes="gallery-select state-pressed" IsTabStop="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="2" Grid.Column="4" Classes="gallery-select state-disabled" IsTabStop="False" IsEnabled="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="2" Grid.Column="5" Classes="gallery-select state-focus" IsTabStop="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="2" Grid.Column="6" Classes="gallery-select state-invalid" IsTabStop="False" SelectedIndex="0">
                                        <ComboBoxItem Content="{Binding Shell.I18n[themeColorDefault]}"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="3" Classes="design-state-component"
                                               Text="{Binding Shell.I18n[settingsGroupDisplay]}"/>
                                    <Border Grid.Row="3" Grid.Column="1" Classes="gallery-card state-normal">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2" Classes="gallery-card state-hover">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="3" Classes="gallery-card state-pressed">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="4" Classes="gallery-card state-disabled">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="5" Classes="gallery-card state-focus">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="6" Classes="gallery-card state-invalid">
                                        <TextBlock Text="{Binding Shell.I18n[settingsGroupDisplay]}" Classes="caption"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Gallery.Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Lg}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DesignTokenGroup">
                                    <Border Classes="dialog-card">
                                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="section-title"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DesignTokenItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="{StaticResource Launcher.Control.Size.Swatch}"
                                                                    Height="{StaticResource Launcher.Control.Size.Swatch}"
                                                                    CornerRadius="{StaticResource Launcher.Radius.Sm}"
                                                                    Background="{Binding Swatch}"
                                                                    BorderBrush="{DynamicResource Launcher.Color.Card.Border}"
                                                                    BorderThickness="{StaticResource Launcher.Border.Thickness.Default}"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Key}"
                                                                       Classes="caption"
                                                                       FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="{StaticResource Launcher.Spacing.Thickness.Sm}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                                       Classes="caption"
                                                                       FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Classes="dialog-footer">
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="primary-action dialog-action" Command="{Binding Gallery.CloseCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[close]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[close]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
