<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
        xmlns:models="using:Cafe.Launcher.Avalonia.Models"
        xmlns:services="using:Cafe.Launcher.Avalonia.Services"
        xmlns:views="using:Cafe.Launcher.Avalonia.Views"
        xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="754"
        x:Class="Cafe.Launcher.Avalonia.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="{Binding Shell.ProductName}"
        FontFamily="{Binding Shell.FontFamily}"
        Width="1300"
        Height="754"
        MinWidth="1024"
        MinHeight="640"
        CanResize="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource LauncherMediaPlaceholderBrush}">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Rectangle Fill="{Binding Background.BackgroundFillBrush}"/>
        <Image Source="{Binding Background.BackgroundImageSource}" Stretch="{Binding Background.BackgroundStretch}"/>

        <Grid RowDefinitions="Auto,*"
              IsEnabled="{Binding ModalHost.IsBaseLayerInteractive}">
            <Grid ColumnDefinitions="*,Auto" Height="48">
                <Grid.Background>
                    <StaticResource ResourceKey="LauncherTitleBarGradient"/>
                </Grid.Background>
                <!-- W3: Right-click context menu on title bar -->
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Shell.I18n[showLauncher]}" Command="{Binding WindowChrome.ExecuteRestoreWindowCommand}"/>
                        <MenuItem Header="{Binding Shell.I18n[settings]}" Command="{Binding WindowChrome.ShowSettingsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Shell.I18n[close]}" Command="{Binding WindowChrome.CloseCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel Classes="titlebar-brand-row">
                    <TextBlock Text="{Binding Shell.ProductName}" Classes="titlebar-brand"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="titlebar-actions">
                    <Button Classes="chrome" Command="{Binding WindowChrome.OpenDebugPanelCommand}" ToolTip.Tip="{Binding Shell.I18n[debugPanel]}"
                            IsVisible="{Binding IsDebugFeaturesEnabled}"
                            AutomationProperties.Name="{Binding Shell.I18n[debugPanel]}">
                        <materialIcons:MaterialIcon Kind="BugOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnChromeBrush}"/>
                    </Button>
                    <Button Classes="chrome" Command="{Binding ResourcePanel.OpenResourcePanelCommand}" ToolTip.Tip="{Binding Shell.I18n[resourcePanel]}"
                            AutomationProperties.Name="{Binding Shell.I18n[resourcePanel]}">
                        <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnChromeBrush}"/>
                    </Button>
                    <Button Classes="chrome settings" Command="{Binding WindowChrome.ShowSettingsCommand}" ToolTip.Tip="{Binding Shell.I18n[settings]}"
                            AutomationProperties.Name="{Binding Shell.I18n[settings]}">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnChromeBrush}"/>
                    </Button>
                    <Button Classes="chrome" Command="{Binding WindowChrome.MinimizeCommand}" ToolTip.Tip="{Binding Shell.I18n[minimize]}"
                            AutomationProperties.Name="{Binding Shell.I18n[minimize]}">
                        <materialIcons:MaterialIcon Kind="Minus" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnChromeBrush}"/>
                    </Button>
                    <Button Classes="chrome close" Command="{Binding WindowChrome.CloseCommand}" ToolTip.Tip="{Binding Shell.I18n[close]}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnChromeBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*,Auto">
                <Border Classes="remote-surface"
                        IsVisible="{Binding RemoteContent.IsPanelVisible}">
                    <Panel>
                        <Border Classes="remote-content-layout-host">
                            <StackPanel Spacing="{StaticResource LauncherSpacingXxl}">
                            <Border IsVisible="{Binding RemoteContent.HasNotice}"
                                    Classes="remote-content-card notice-card">
                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                    <TextBlock Text="{Binding Shell.I18n[notice]}" Classes="panel-title"/>
                                    <TextBlock Text="{Binding RemoteContent.NoticeText}"
                                               Classes="body"
                                               MaxHeight="110"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="BannerStage"
                                  Classes="banner-stage"
                                  IsVisible="{Binding RemoteContent.HasBannerItems}"
                                  PointerEntered="OnBannerPointerEntered"
                                  PointerExited="OnBannerPointerExited"
                                  GotFocus="OnBannerGotFocus"
                                  LostFocus="OnBannerLostFocus">
                                <!-- Banner carousel with horizontal page-slide transition -->
                                <Carousel x:Name="BannerCarousel"
                                          ItemsSource="{Binding RemoteContent.BannerItems}"
                                          SelectedIndex="{Binding RemoteContent.CarouselSelectedIndex, Mode=TwoWay}"
                                          PageTransition="{Binding RemoteContent.CarouselTransition}"
                                          Height="220"
                                          CornerRadius="{StaticResource LauncherRadiusSm}" ClipToBounds="True">
                                    <Carousel.Styles>
                                        <Style Selector="ContentControl">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </Carousel.Styles>
                                    <Carousel.ItemTemplate>
                                        <DataTemplate x:DataType="models:RemoteContentItem">
                                            <Button Classes="banner-link"
                                                    Cursor="Hand"
                                                    Width="{Binding #BannerCarousel.Bounds.Width}"
                                                    Height="{Binding #BannerCarousel.Bounds.Height}"
                                                    AutomationProperties.Name="{Binding #Root.((vm:MainWindowViewModel)DataContext).Shell.I18n[banner]}"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                    CommandParameter="{Binding Url}">
                                                <Border Classes="banner-media">
                                                    <Panel>
                                                        <Border Classes="media-placeholder"
                                                                IsVisible="{Binding IsImageLoadFailed}">
                                                            <TextBlock Text="{Binding #Root.((vm:MainWindowViewModel)DataContext).Shell.I18n[bannerLoadingFailed]}"
                                                                       Classes="media-placeholder-text"/>
                                                        </Border>
                                                        <Image Source="{Binding BannerBitmap}"
                                                               Stretch="UniformToFill"/>
                                                        <controls:LoadingOverlay IsVisible="{Binding IsImageLoading}"
                                                                                  Text="{Binding #Root.((vm:MainWindowViewModel)DataContext).Shell.I18n[bannerLoading]}"/>
                                                    </Panel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </Carousel.ItemTemplate>
                                </Carousel>
                                <TextBlock Classes="banner-control banner-page-indicator"
                                           Text="{Binding RemoteContent.CarouselPageText}"
                                           AutomationProperties.Name="{Binding RemoteContent.CarouselPageText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="{StaticResource LauncherSpacingSmThickness}"/>
                                <Button Classes="icon-button banner-control carousel-navigation banner-previous"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding RemoteContent.HasMultipleBanners}"
                                        Command="{Binding RemoteContent.SelectPreviousBannerCommand}"
                                        ToolTip.Tip="{Binding Shell.I18n[previousBanner]}"
                                        AutomationProperties.Name="{Binding Shell.I18n[previousBanner]}">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"
                                                                Foreground="{DynamicResource LauncherTextSecondaryBrush}"/>
                                </Button>
                                <Grid Classes="banner-control banner-indicators"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="{StaticResource LauncherSpacingSmThickness}">
                                    <ItemsControl ItemsSource="{Binding RemoteContent.BannerDots}">
                                        <ItemsControl.ItemsPanel>
                                            <StaticResource ResourceKey="HorizontalSpacingSmPanel"/>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BannerDot">
                                                <Button Classes="icon-button dot"
                                                        Cursor="Hand"
                                                        IsEnabled="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.HasMultipleBanners}"
                                                        ToolTip.Tip="{Binding AccessibleName}"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.SelectBannerCommand}"
                                                        CommandParameter="{Binding Index}">
                                                    <Border Classes="banner-dot"
                                                            Classes.active="{Binding IsActive}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Button Classes="icon-button banner-control carousel-navigation banner-next"
                                        Cursor="Hand"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding RemoteContent.HasMultipleBanners}"
                                        Command="{Binding RemoteContent.SelectNextBannerCommand}"
                                        ToolTip.Tip="{Binding Shell.I18n[nextBanner]}"
                                        AutomationProperties.Name="{Binding Shell.I18n[nextBanner]}">
                                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"
                                                                Foreground="{DynamicResource LauncherTextSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <Border Classes="remote-content-card news-card"
                                    IsVisible="{Binding RemoteContent.HasNewsItems}">
                                <TabControl Classes="news-tabs"
                                            ItemsSource="{Binding RemoteContent.NewsCategories}"
                                            SelectedItem="{Binding RemoteContent.SelectedNewsCategory, Mode=TwoWay}"
                                            TabStripPlacement="Top"
                                            PageTransition="{x:Null}">
                                    <TabControl.Theme>
                                        <ControlTheme TargetType="TabControl"
                                                      BasedOn="{StaticResource {x:Type TabControl}}">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{TemplateBinding CornerRadius}"
                                                            Background="{TemplateBinding Background}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalAlignment}">
                                                        <DockPanel>
                                                            <ScrollViewer DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                                                                          HorizontalScrollBarVisibility="Auto"
                                                                          VerticalScrollBarVisibility="Disabled">
                                                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                                            </ScrollViewer>
                                                            <Panel ClipToBounds="True">
                                                                <ContentPresenter Name="PART_SelectedContentHost2"
                                                                                  Margin="{TemplateBinding Padding}"
                                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  IsVisible="False"/>
                                                                <ContentPresenter Name="PART_SelectedContentHost"
                                                                                  Margin="{TemplateBinding Padding}"
                                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                            </Panel>
                                                        </DockPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                            <Setter Property="ItemsPanel">
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="{StaticResource LauncherSpacingXs}"/>
                                                </ItemsPanelTemplate>
                                            </Setter>
                                        </ControlTheme>
                                    </TabControl.Theme>
                                    <TabControl.ItemContainerTheme>
                                        <ControlTheme TargetType="TabItem"
                                                      BasedOn="{StaticResource {x:Type TabItem}}">
                                            <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
                                            <Setter Property="BorderThickness" Value="{StaticResource LauncherThicknessNone}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="{DynamicResource LauncherFontSizeMd}"/>
                                            <Setter Property="Padding" Value="{StaticResource LauncherSpacingXsThickness}"/>
                                            <Setter Property="MinHeight" Value="{StaticResource LauncherControlHeightSetting}"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Margin" Value="{StaticResource LauncherTabHeaderMargin}"/>
                                            </Style>
                                            <Style Selector="^:selected">
                                                <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                                                <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                                                <Setter Property="Background" Value="{DynamicResource LauncherAccentBrush}"/>
                                            </Style>
                                            <Style Selector="^[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe">
                                                <Setter Property="Margin" Value="{StaticResource LauncherTabIndicatorMargin}"/>
                                            </Style>
                                            <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                                                <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
                                                <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            </Style>
                                        </ControlTheme>
                                    </TabControl.ItemContainerTheme>
                                    <TabControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NewsCategory">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate x:DataType="models:NewsCategory">
                                            <ScrollViewer Classes="news-viewport"
                                                          Height="{StaticResource LauncherNewsViewportHeight}"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="{StaticResource LauncherSpacingSm}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:RemoteContentItem">
                                                            <Button Classes="content-link news-row"
                                                                    Cursor="Hand"
                                                                    Height="{StaticResource LauncherNewsRowHeight}"
                                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                                    CommandParameter="{Binding Url}">
                                                                <Border Classes="content-row news-content-row">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingLg}">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Classes="value"
                                                                                   MaxLines="2"
                                                                                   TextWrapping="Wrap"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip.Tip="{Binding Title}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Subtitle}"
                                                                                   HorizontalAlignment="Right"
                                                                                   TextAlignment="Right"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Classes="caption"/>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </Border>

                            <Border Classes="remote-content-card social-media-card"
                                    IsVisible="{Binding RemoteContent.HasSocialMediaItems}">
                                <StackPanel Spacing="{StaticResource LauncherSpacingLg}">
                                    <TextBlock Text="{Binding Shell.I18n[socialMedia]}" Classes="panel-title"/>
                                    <ItemsControl ItemsSource="{Binding RemoteContent.SocialMediaItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RemoteContentItem">
                                            <Button Classes="social-chip"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                    CommandParameter="{Binding Url}">
                                                <StackPanel Classes="button-content">
                                                    <materialIcons:MaterialIcon Kind="{Binding SocialIconKind}" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"
                                                                                Foreground="{DynamicResource LauncherTextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Title}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </Border>
                        <Border Classes="remote-content-load-error"
                                IsVisible="{Binding RemoteContent.HasLoadError}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource LauncherSpacingMd}">
                                <materialIcons:MaterialIcon Kind="AlertCircle"
                                                            Width="{StaticResource LauncherIconMd}"
                                                            Height="{StaticResource LauncherIconMd}"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{DynamicResource LauncherDangerBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n[remoteContentLoadFailed]}"
                                           Classes="body"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <controls:LoadingOverlay Classes="remote-content-loading-overlay"
                                                  IsVisible="{Binding RemoteContent.IsLoading}"
                                                  Text="{Binding Shell.I18n[remoteContentLoading]}"/>
                    </Panel>
                </Border>

                <Border Grid.Row="1"
                        Classes="bottom-panel motion-bottom"
                        Classes.motion-enabled="{Binding IsMotionEnabled}"
                        Classes.motion-enter="{Binding Operations.IsInstallPanelVisible}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Operations.IsInstallPanelVisible"/>
                            <Binding Path="IsBottomPanelVisible"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <!-- Compact layout -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingXl}"
                          IsVisible="{Binding IsStatusDetailHidden, Converter={x:Static BoolConverters.Not}}">
                        <StackPanel Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingLg}">
                                <TextBlock Classes="caption" Text="{Binding Shell.VersionText}"/>
                                <TextBlock Classes="caption" Text="{Binding Shell.DiskSpaceText}"/>
                                <TextBlock Classes="caption" Text="{Binding Shell.NetworkText}"/>
                            </StackPanel>
                            <Border Classes="path-field">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Text="{Binding Shell.I18n[path]}" Classes="value" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Shell.PathText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Classes="icon-link secondary-operation" Command="{Binding Settings.ChangePersistedGamePathCommand}" VerticalAlignment="Center"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                            ToolTip.Tip="{Binding Shell.I18n[changePath]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[changePath]}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n[changePath]}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="icon-link secondary-operation" Command="{Binding Settings.SelectInstalledGameCommand}" VerticalAlignment="Center"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                            ToolTip.Tip="{Binding Shell.I18n[selectInstalledGame]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[selectInstalledGame]}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n[selectInstalledGame]}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingMd}" VerticalAlignment="Center">
                            <Button Classes="flat-action bottom-action secondary-operation" Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="{Binding Shell.I18n[refreshTooltip]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Shell.I18n[refresh]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                                    <TextBlock Text="{Binding Shell.I18n[refresh]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary-action bottom-action primary-operation" Command="{Binding Operations.InstallOrUpdateCommand}"
                                    ToolTip.Tip="{Binding Operations.InstallButtonToolTip}"
                                    ToolTip.ShowOnDisabled="True"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Operations.InstallButtonText}"
                                    AutomationProperties.HelpText="{Binding Operations.InstallButtonToolTip}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"/>
                                    <TextBlock Text="{Binding Operations.InstallButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding Operations.IsProgressPanelVisible}"
                        Classes="bottom-panel">
                    <Grid Classes="operation-layout" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingXl}" VerticalAlignment="Center">
                        <Grid Classes="operation-status"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="{StaticResource LauncherSpacingMd}"
                              RowSpacing="{StaticResource LauncherSpacingSm}"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource LauncherIconXxl}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Title + percentage -->
                            <materialIcons:MaterialIcon Kind="{Binding Operations.ProgressIconKind}"
                                                        Width="{StaticResource LauncherIconLg}"
                                                        Height="{StaticResource LauncherIconLg}"
                                                        Foreground="{DynamicResource LauncherAccentBrush}"
                                                        VerticalAlignment="Center"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource LauncherSpacingSm}">
                                <TextBlock Text="{Binding Operations.ProgressTitle}" Classes="progress-title operation-status-title" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operations.ProgressValue, StringFormat={}{0}%}"
                                           Classes="progress-title" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LauncherAccentBrush}"/>
                            </Grid>
                            <!-- Progress bar -->
                            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Operations.ProgressValue}" Minimum="0" Maximum="100" Height="8"/>
                            <!-- Stage | Speed | Size | ETA -->
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource LauncherSpacingMd}">
                                <TextBlock Text="{Binding Operations.ProgressDetail}" Classes="caption"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operations.ProgressSpeed}" Classes="caption"
                                           IsVisible="{Binding Operations.ProgressSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Operations.ProgressSize}" Classes="caption"
                                           IsVisible="{Binding Operations.ProgressSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Operations.ProgressEstimated}" Classes="caption"
                                           Foreground="{DynamicResource LauncherAccentBrush}"
                                           IsVisible="{Binding Operations.ProgressEstimated, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" Classes="operation-actions" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                            <Button Classes="flat-action bottom-action secondary-operation" Command="{Binding Operations.PauseResumeCommand}" VerticalAlignment="Center"
                                    IsVisible="{Binding Operations.CanPauseOperation}"
                                    ToolTip.Tip="{Binding Operations.PauseResumeText}"
                                    AutomationProperties.Name="{Binding Operations.PauseResumeText}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="{Binding Operations.PauseResumeIcon}" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                                    <TextBlock Text="{Binding Operations.PauseResumeText}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action bottom-action secondary-operation" Command="{Binding Operations.StopOperationCommand}" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Shell.I18n[stop]}"
                                    AutomationProperties.Name="{Binding Shell.I18n[stop]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                                    <TextBlock Text="{Binding Shell.I18n[stop]}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Classes="bottom-panel control-panel motion-bottom"
                        Classes.motion-enabled="{Binding IsMotionEnabled}"
                        Classes.motion-enter="{Binding Operations.IsControlPanelVisible}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Operations.IsControlPanelVisible"/>
                            <Binding Path="IsBottomPanelVisible"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Panel>
                    <!-- Compact layout -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingXxl}"
                          IsVisible="{Binding IsStatusDetailHidden, Converter={x:Static BoolConverters.Not}}">
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingLg}" VerticalAlignment="Center">
                            <Button Classes="launcher-control site secondary-operation" Command="{Binding WindowChrome.OpenOfficialSiteCommand}" ToolTip.Tip="{Binding Shell.I18n[officialSite]}"
                                    AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"/>
                                    <TextBlock Text="{Binding Shell.I18n[officialSite]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="launcher-control start primary-operation" Command="{Binding Operations.StartGameCommand}" ToolTip.Tip="{Binding Shell.I18n[startGame]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Shell.I18n[startGame]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="PlayCircle" Width="{StaticResource LauncherIconXxl}" Height="{StaticResource LauncherIconXxl}"/>
                                    <TextBlock Text="{Binding Shell.I18n[startGame]}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource LauncherSpacingLg}">
                            <TextBlock Text="{Binding Shell.VersionText}" Classes="on-dark-caption"/>
                            <TextBlock Text="{Binding Shell.LaunchCheckText}" Classes="on-dark-caption"/>
                            <TextBlock Text="{Binding Shell.NetworkText}" Classes="on-dark-caption"/>
                        </StackPanel>
                    </Grid>
                    <!-- Hidden layout (buttons only) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource LauncherSpacingLg}"
                                IsVisible="{Binding IsStatusDetailHidden}"
                                VerticalAlignment="Center">
                        <Button Classes="launcher-control site secondary-operation" Command="{Binding WindowChrome.OpenOfficialSiteCommand}" ToolTip.Tip="{Binding Shell.I18n[officialSite]}"
                                AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"/>
                                <TextBlock Text="{Binding Shell.I18n[officialSite]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="launcher-control start primary-operation" Command="{Binding Operations.StartGameCommand}" ToolTip.Tip="{Binding Shell.I18n[startGame]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                AutomationProperties.Name="{Binding Shell.I18n[startGame]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="PlayCircle" Width="{StaticResource LauncherIconXxl}" Height="{StaticResource LauncherIconXxl}"/>
                                <TextBlock Text="{Binding Shell.I18n[startGame]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Grid>

        <views:MainWindowSettingsOverlay/>
        <views:MainWindowDebugOverlay/>
        <views:MainWindowLogViewerOverlay/>
        <views:MainWindowDialogsOverlay/>
        <views:MainWindowToastOverlay/>
    </Grid>
</Window>
