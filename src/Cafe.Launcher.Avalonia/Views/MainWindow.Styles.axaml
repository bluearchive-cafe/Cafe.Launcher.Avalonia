    <!-- Operation panels share 40px horizontal alignment and common padding. -->
    <Style Selector="Border.bottom-panel">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.BottomPanel.MinHeight}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Panel.Bottom.Background}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.BottomPanel.Padding}"/>
    </Style>
    <Style Selector="Grid.motion-overlay">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-surface">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-surface-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector=":is(UserControl).motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="StackPanel.motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-bottom">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Fast}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Transparent}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Overlay.Scrim.Md}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Normal}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > Border.motion-surface > Grid.motion-surface-content">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Normal}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Fast}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Overlay.Scrim.Md}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Transparent}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Fast}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Surface}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > Border.motion-surface > Grid.motion-surface-content">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Fast}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(UserControl).motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Content}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Content}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="StackPanel.motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Content}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Content}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.motion-bottom.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Launcher.Motion.Duration.Normal}" FillMode="Forward" Easing="{StaticResource Launcher.Motion.Easing.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Launcher.Motion.Offset.Bottom}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
