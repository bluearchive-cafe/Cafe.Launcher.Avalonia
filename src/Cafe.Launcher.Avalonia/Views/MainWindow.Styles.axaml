        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
    </Style>
    <Style Selector="Border.gallery-card.toast.state-pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
    </Style>
    <Style Selector="Border.gallery-card.toast.state-focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.FocusRing}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Focus}"/>
    </Style>
    <Style Selector="ColorPicker.setting-control">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Component.Settings.Control.MinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Field}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.uid-input">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Field.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Field.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Input.Padding}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Body.Md}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Input.MinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Field}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="TextBox.uid-input:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="TextBox.uid-input:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="ToggleSwitch.setting-toggle">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked:pressed /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Fill" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="Border.color-swatch">
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Size.Swatch}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Control.Size.Swatch}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
    </Style>
    <Style Selector="Button.color-swatch-button">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Control.Height.Setting}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Control.Height.Setting}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.wrap-action">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.WrapAction.Margin}"/>
    </Style>
    <!-- Shared utility styles for repeated inline patterns -->
    <Style Selector="ScrollViewer.scroll-pad">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Scroll.Pad}"/>
    </Style>
    <Style Selector="Border.color-swatch-preview">
        <Setter Property="Width" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
        <Setter Property="Height" Value="{StaticResource Launcher.Component.ColorSwatch.Preview.Size}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
