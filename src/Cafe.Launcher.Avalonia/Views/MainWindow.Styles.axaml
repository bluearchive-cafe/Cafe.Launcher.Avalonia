    <!-- Operation panels share 40px horizontal alignment and common padding. -->
    <Style Selector="Border.bottom-panel">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="MinHeight" Value="132"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Panel.Bottom.Background}"/>
