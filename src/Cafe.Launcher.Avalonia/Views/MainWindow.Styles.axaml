    </Style>
    <Style Selector="TextBlock.operation-status-title.on-dark-title">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.OnChrome}"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Body.Md}"/>
        <Setter Property="FontWeight" Value="{StaticResource Launcher.Typography.FontWeight.Strong}"/>
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Surface}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.Lg}"/>
        <!-- 阴影值集中见 Launcher.Elevation.Shadow.Md；BoxShadow 为无 TypeConverter 的结构体，
             无法经 {StaticResource} 在 Setter 处运行时转换（Avalonia 12.1.1 限制，详见 spec §3.1）。 -->
        <Setter Property="BoxShadow" Value="0 12 32 0 #33000000"/>
    </Style>
    <Style Selector="Border.remote-surface">
