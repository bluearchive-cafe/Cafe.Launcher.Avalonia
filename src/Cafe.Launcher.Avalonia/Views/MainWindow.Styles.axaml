        <Setter Property="Margin" Value="{StaticResource Launcher.Component.RemoteSurface.Margin}"/>
        <Setter Property="Width" Value="{StaticResource Launcher.Component.RemoteSurface.Width}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.RemoteSurface.MinHeight}"/>
        <Setter Property="MaxHeight" Value="{StaticResource Launcher.Component.RemoteSurface.MaxHeight}"/>
    </Style>
    <Style Selector="ItemsControl.social-actions">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.Xl}"/>
