        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.loading-overlay">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Overlay.Scrim.Md}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
