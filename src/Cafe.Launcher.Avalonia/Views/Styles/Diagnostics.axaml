<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="StackPanel.log-filter-bar">
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.LogViewer.FilterBar.Margin}"/>
    </Style>
    <!-- 筛选 chip 基础样式直接以 RadioButton 为目标：Avalonia 类型选择器不匹配派生类型，
         Button.* 选择器不会命中 RadioButton 实例（2026-09 复核回归）。 -->
    <Style Selector="RadioButton.filter-tab">
        <Setter Property="Template" Value="{StaticResource LauncherBorderToggleButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Body.Sm}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.FilterTab.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Chip}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Sm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="RadioButton.filter-tab.log-filter">
        <Setter Property="Height" Value="{StaticResource Launcher.Control.Height.Setting}"/>
    </Style>
    <!-- 未选中态悬停/按压只铺低透明状态层（8%/12% primary 预合成），保留 Text.Primary
         前景；选中态由 :checked 呈现 filled 容器（Primary + OnPrimary），与 M3 状态模型一致。 -->
    <Style Selector="RadioButton.filter-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Hover}"/>
    </Style>
    <Style Selector="RadioButton.filter-tab:pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Pressed}"/>
    </Style>
    <Style Selector="RadioButton.filter-tab:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.FocusRing}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Focus}"/>
    </Style>
    <Style Selector="RadioButton.filter-tab:disabled">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}"/>
        <Setter Property="Opacity" Value="{StaticResource Launcher.StateLayer.Disabled.Content}"/>
    </Style>
    <!-- 筛选语义：RadioButton 承载真实选择状态（ADR-014 同款用法），选中外观走 :checked。 -->
    <Style Selector="RadioButton.filter-tab:checked">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="RadioButton.filter-tab:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="RadioButton.filter-tab:checked:pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="Border.log-empty-state">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.log-empty-state TextBlock.media-placeholder-text">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list">
        <Setter Property="Margin" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="Margin" Value="{StaticResource Launcher.Component.Dialog.Content.BottomMargin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
    </Style>
</Styles>
