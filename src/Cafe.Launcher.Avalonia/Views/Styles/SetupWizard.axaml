<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox.settings-navigation.wizard-navigation">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Wizard.Navigation.Padding}"/>
    </Style>
    <Style Selector="TextBlock.wizard-step-number">
        <Setter Property="MinWidth" Value="{StaticResource Launcher.Component.Wizard.StepNumber.MinWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.wizard-review-row">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Dialog}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.wizard-review-divider">
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Wizard.Divider.Height}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Border}"/>
    </Style>
    <Style Selector="Button.wizard-choice">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Wizard.Choice.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.Wizard.Choice.MinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.wizard-choice:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
    </Style>
    <Style Selector="Button.wizard-choice:pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Button.Flat.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
    </Style>
    <Style Selector="Button.wizard-choice:disabled">
        <Setter Property="Opacity" Value="{StaticResource Launcher.StateLayer.Disabled.Content}"/>
    </Style>
    <Style Selector="Button.wizard-choice.active">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.checking">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.ready">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.Success}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.corrupted">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Danger}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.inaccessible">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Danger}"/>
    </Style>
</Styles>
