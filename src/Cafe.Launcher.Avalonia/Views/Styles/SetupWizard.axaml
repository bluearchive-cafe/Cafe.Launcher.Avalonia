<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 外壳模式自管留白：内容三行块消费 Panel 正文内边距（视图禁止内联 Padding）。 -->
    <Style Selector="Border.wizard-body">
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Dialog.Panel.Body.Padding}"/>
    </Style>
    <!-- 实验台向导动作钮（ADR-017，并入内容区）：非主按钮为中性 tonal
         （Content.Row 底色 + Text.Primary 前景，悬停/按压取对话框表面中性变体），
         主按钮叠加 primary-action 转为 filled；几何沿用 dialog-action，图标行经 button-content。 -->
    <Style Selector="Button.wizard-action">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
        <Setter Property="FontWeight" Value="{StaticResource Launcher.Typography.FontWeight.Strong}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Xs}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource LauncherBorderButtonTemplate}"/>
    </Style>
    <Style Selector="Button.wizard-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Close.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
    </Style>
    <Style Selector="Button.wizard-action:pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Close.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
    </Style>
    <Style Selector="Button.wizard-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.wizard-action.primary-action">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="Button.wizard-action.primary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <Style Selector="Button.wizard-action.primary-action:pressed">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Primary.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.OnPrimary}"/>
    </Style>
    <!-- filled 型禁用态须后置覆盖 primary 填充（与主样式 Button.primary-action:disabled 同配方：
         Content.Row 预混底 + Card.Border 描边 + Text.Secondary 前景）。 -->
    <Style Selector="Button.wizard-action.primary-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}"/>
    </Style>
    <!-- 实验台向导解剖（ADR-017）：步骤标题居中、完成态标题以 Success 色标识，
         步骤面板的顺序换页由后置代码驱动，不使用声明式动画类。 -->
    <Style Selector="TextBlock.wizard-step-title">
        <Setter Property="FontSize" Value="{StaticResource Launcher.Typography.FontSize.Display}"/>
        <Setter Property="FontWeight" Value="{StaticResource Launcher.Typography.FontWeight.Strong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.wizard-step-title.wizard-complete">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.Success}"/>
    </Style>
    <!-- M3 选项行：单选组按列表行呈现，整行为命中目标，悬停铺状态层圆角底。
         选项语义仍由 RadioButton 承载（ADR-014：不用卡片按钮改写语义）。 -->
    <Style Selector="RadioButton.wizard-option">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Component.Wizard.Option.MinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Launcher.Component.Wizard.Option.Padding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Launcher.Radius.Md}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="RadioButton.wizard-option:pointerover">
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Content.Row.Hover}"/>
    </Style>
    <!-- §8: 选项行经键盘聚焦时铺 token 焦点环（根 Border 承载描边，与导航列表行同配方）。 -->
    <Style Selector="RadioButton.wizard-option:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.FocusRing}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Launcher.Border.Thickness.Focus}"/>
    </Style>
    <Style Selector="Grid.wizard-review-row">
        <Setter Property="MinHeight" Value="{StaticResource Launcher.Control.Height.Dialog}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.wizard-review-divider">
        <Setter Property="Height" Value="{StaticResource Launcher.Component.Wizard.Divider.Height}"/>
        <Setter Property="Background" Value="{DynamicResource Launcher.Color.Card.Border}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.checking">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.Primary}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.ready">
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Color.Success}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.corrupted">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Danger}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.inaccessible">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Danger}"/>
    </Style>
</Styles>
