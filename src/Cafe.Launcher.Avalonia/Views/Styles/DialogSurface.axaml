<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
        xmlns:helpers="using:Cafe.Launcher.Avalonia.Helpers"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- 对话框家族 v2 的视觉契约（ADR-015）。表面档案：组件圆角 20 + 双层阴影，
       模态表面比页面常驻面板高一档。两种形态共享同一模板骨架，解剖差异
       全部由 :panel 与状态伪类驱动；使用方不得自带几何、色彩或阴影值。 -->

  <!-- 表面对外语义 = 标题文本（§8）；无标题外壳（设置/向导/调试）由使用方显式给名。 -->
  <Style Selector="controls|DialogSurface" x:DataType="controls:DialogSurface">
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Launcher.Component.Dialog.CornerRadius}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <!-- BoxShadows 缺少 TypeConverter，经 BoxShadowsExtension 消费单一 token。 -->
    <Setter Property="BoxShadow" Value="{helpers:BoxShadows {StaticResource Launcher.Elevation.Shadow.Dialog}}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_SurfaceBorder"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="{TemplateBinding ClipToBounds}"
                BoxShadow="{TemplateBinding BoxShadow}">
          <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Panel 头带：徽章 + 标题列（副标题可选）+ ✕ 关闭钮 -->
            <Border x:Name="PART_PanelHead"
                    Background="{DynamicResource Launcher.Color.Dialog.Header}"
                    MinHeight="{StaticResource Launcher.Component.Dialog.Title.Height}"
                    Padding="{StaticResource Launcher.Component.Dialog.Panel.Head.Padding}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter x:Name="PART_BadgePresenter"
                                  Grid.Column="0"
                                  Width="{StaticResource Launcher.Component.Dialog.Badge.Size}"
                                  Height="{StaticResource Launcher.Component.Dialog.Badge.Size}"
                                  Margin="{StaticResource Launcher.Component.Dialog.Badge.Margin}"
                                  CornerRadius="{StaticResource Launcher.Component.Dialog.Badge.CornerRadius}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource Launcher.Color.Primary.Soft}"
                                  Foreground="{DynamicResource Launcher.Color.Primary}"
                                  Focusable="False"/>
                <StackPanel Grid.Column="1"
                            Spacing="{StaticResource Launcher.Spacing.Xs}"
                            VerticalAlignment="Center">
                  <TextBlock x:Name="PART_TitleTextBlock"
                             Text="{TemplateBinding Title}"
                             FontSize="{StaticResource Launcher.Typography.FontSize.Title.Lg}"
                             FontWeight="{StaticResource Launcher.Typography.FontWeight.Strong}"
                             Foreground="{DynamicResource Launcher.Text.Primary}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="PART_SubtitleTextBlock"
                             Text="{TemplateBinding Subtitle}"
                             FontSize="{StaticResource Launcher.Typography.FontSize.Label.Md}"
                             Foreground="{DynamicResource Launcher.Text.Secondary}"/>
                </StackPanel>
                <Button x:Name="PART_CloseButton"
                        Grid.Column="2"
                        Classes="dialog-close"
                        VerticalAlignment="Center"
                        Command="{TemplateBinding CloseCommand}"
                        AutomationProperties.Name="{TemplateBinding CloseAutomationName}"
                        ToolTip.Tip="{TemplateBinding CloseToolTip}">
                  <materialIcons:MaterialIcon Kind="Close"
                                              Width="{StaticResource Launcher.Icon.Lg}"
                                              Height="{StaticResource Launcher.Icon.Lg}"/>
                </Button>
              </Grid>
            </Border>

            <!-- Basic 流式头部：裸图标（可选）+ 标题 + 支撑文案 -->
            <Border x:Name="PART_BasicHead"
                    Padding="{StaticResource Launcher.Component.Dialog.Basic.Head.Padding}">
              <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                <ContentPresenter x:Name="PART_BasicIconPresenter"
                                  HorizontalAlignment="Left"
                                  Focusable="False"/>
                <TextBlock x:Name="PART_BasicTitleTextBlock"
                           Text="{TemplateBinding Title}"
                           FontSize="{StaticResource Launcher.Typography.FontSize.Headline.Lg}"
                           FontWeight="{StaticResource Launcher.Typography.FontWeight.Strong}"
                           Foreground="{DynamicResource Launcher.Text.Primary}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="PART_BasicSupportTextBlock"
                           Text="{TemplateBinding Subtitle}"
                           FontSize="{StaticResource Launcher.Typography.FontSize.Body.Md}"
                           Foreground="{DynamicResource Launcher.Text.Secondary}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- 固定工具行（可选）：位于头带与滚动区之间，如日志过滤栏 -->
            <ContentPresenter x:Name="PART_ToolbarPresenter" Grid.Row="1" Focusable="False"/>

            <!-- 共享内容区：常规形态经滚动脚手架；无头带外壳模式由直连
                 展示器绕过无限高度，交给内部布局自管（如设置工作区）。 -->
            <ScrollViewer x:Name="PART_ScrollViewer" Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <!-- 对象型插槽内容由 DialogSurface.SyncSlotContents() 装配，不走模板绑定。 -->
              <ContentPresenter x:Name="PART_ScrollContentPresenter"/>
            </ScrollViewer>
            <ContentPresenter x:Name="PART_DirectContentPresenter" Grid.Row="2" Focusable="False"/>

            <!-- 动作带：Basic 为无装饰动作行，Panel 升级为发丝底带（含左侧辅助槽） -->
            <Border x:Name="PART_FooterBand" Grid.Row="3">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter x:Name="PART_FooterLeadingPresenter"
                                  Grid.Column="0"
                                  Margin="{StaticResource Launcher.Component.Dialog.FooterLeading.Margin}"
                                  VerticalAlignment="Center"
                                  Focusable="False"/>
                <ContentPresenter x:Name="PART_FooterPresenter"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Focusable="False"/>
              </Grid>
            </Border>

          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- 形态切换：解剖可见性由 DialogSurface.RefreshChrome() 管理
       （含头带折叠与自管留白外壳）；正文内边距由形态样式直接消费 token。 -->
  <Style Selector="controls|DialogSurface /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.Dialog.Basic.Content.Padding}"/>
  </Style>

  <Style Selector="controls|DialogSurface:panel /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.Dialog.Panel.Body.Padding}"/>
  </Style>

  <Style Selector="controls|DialogSurface /template/ Border#PART_FooterBand">
    <Setter Property="Background" Value="{StaticResource Launcher.Color.Transparent}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Launcher.Spacing.Thickness.None}"/>
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.Dialog.Basic.Actions.Padding}"/>
  </Style>

  <Style Selector="controls|DialogSurface:panel /template/ Border#PART_FooterBand">
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Dialog.Footer}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Color.Card.Border}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Launcher.Component.Dialog.Footer.BorderThickness}"/>
    <Setter Property="Padding" Value="{StaticResource Launcher.Component.Dialog.Panel.Footer.Padding}"/>
  </Style>

  <Style Selector="controls|DialogSurface.settings-surface:panel /template/ Border#PART_FooterBand">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- 状态修饰：仅重染徽章语调，不改变几何。 -->
  <Style Selector="controls|DialogSurface:info /template/ ContentPresenter#PART_BadgePresenter">
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Info.Background}"/>
    <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Info}"/>
  </Style>
  <Style Selector="controls|DialogSurface:warning /template/ ContentPresenter#PART_BadgePresenter">
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Warning.Background}"/>
    <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Warning}"/>
  </Style>
  <Style Selector="controls|DialogSurface:danger /template/ ContentPresenter#PART_BadgePresenter">
    <Setter Property="Background" Value="{DynamicResource Launcher.Color.Danger.Soft}"/>
    <Setter Property="Foreground" Value="{StaticResource Launcher.Color.Danger}"/>
  </Style>

</Styles>
