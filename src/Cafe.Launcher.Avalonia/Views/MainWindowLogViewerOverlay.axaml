<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
        xmlns:feat="using:Cafe.Launcher.Avalonia.Features.Diagnostics"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowLogViewerOverlay"
             x:Name="LogViewerRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="dialog-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsLogViewerInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding LogViewer.IsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <!-- Panel 形态：过滤栏走固定工具行，导出/关闭分居发丝底带左右槽。 -->
        <controls:DialogSurface
            Form="Panel"
            Classes="motion-surface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
            MaxWidth="{StaticResource Launcher.Layout.LogViewer.Width}"
            MaxHeight="{StaticResource Launcher.Layout.LogViewer.Height}"
            Title="{Binding Shell.I18n[logViewerTitle]}"
            CloseCommand="{Binding LogViewer.CloseCommand}"
            CloseAutomationName="{Binding Shell.I18n[close]}"
            CloseToolTip="{Binding Shell.I18n[close]}">
            <controls:DialogSurface.RenderTransform>
                <TranslateTransform/>
            </controls:DialogSurface.RenderTransform>
            <controls:DialogSurface.HeaderIcon>
                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
            </controls:DialogSurface.HeaderIcon>
            <controls:DialogSurface.Toolbar>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}" Classes="log-filter-bar">
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterAllActive}"
                            Command="{Binding LogViewer.SetFilterAllCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterAll]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterAll]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterVerboseActive}"
                            Command="{Binding LogViewer.SetFilterVerboseCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterVerbose]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterVerbose]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterDebugActive}"
                            Command="{Binding LogViewer.SetFilterDebugCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterDebug]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterDebug]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterInfoActive}"
                            Command="{Binding LogViewer.SetFilterInfoCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterInfo]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterInfo]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterWarnActive}"
                            Command="{Binding LogViewer.SetFilterWarnCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterWarn]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterWarn]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterErrorActive}"
                            Command="{Binding LogViewer.SetFilterErrorCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterError]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterError]}"/>
                    </Button>
                    <Button Classes="filter-tab log-filter" Classes.active="{Binding LogViewer.IsFilterFatalActive}"
                            Command="{Binding LogViewer.SetFilterFatalCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logFilterFatal]}">
                        <TextBlock Text="{Binding Shell.I18n[logFilterFatal]}"/>
                    </Button>
                    <TextBox Text="{Binding LogViewer.FilterText, Mode=TwoWay}" PlaceholderText="{Binding Shell.I18n[logSearchPlaceholder]}"
                             Classes="uid-input log-search"
                             MinWidth="{StaticResource Launcher.Component.LogViewer.Search.MinWidth}"
                             AutomationProperties.Name="{Binding Shell.I18n[logSearchPlaceholder]}"
                             Height="{StaticResource Launcher.Control.Height.Setting}" VerticalAlignment="Center"/>
                </StackPanel>
            </controls:DialogSurface.Toolbar>
            <controls:DialogSurface.Content>
                <Grid RowDefinitions="Auto,*"
                      Classes="log-content">
                    <Button Grid.Row="0"
                            Classes="flat-action dialog-action log-load-earlier"
                            Margin="{StaticResource Launcher.Component.LogViewer.LoadEarlier.Margin}"
                            Command="{Binding LogViewer.LoadEarlierCommand}"
                            IsVisible="{Binding LogViewer.HasEarlierEntries}"
                            AutomationProperties.Name="{Binding Shell.I18n[logLoadEarlier]}">
                        <TextBlock Text="{Binding Shell.I18n[logLoadEarlier]}"/>
                    </Button>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogViewer.FilteredEntries}"
                             Classes="log-entry-list"
                             IsVisible="{Binding LogViewer.HasFilteredEntries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="feat:LogEntryDisplay">
                                <Border Classes="dialog-card">
                                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Xs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                            <TextBlock Text="{Binding TimestampText}" Classes="caption" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SeverityLabel}" Classes="chip-text" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Launcher.Color.Primary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Classes="section-title" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap"
                                                   IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"
                                                   MaxHeight="{StaticResource Launcher.Component.LogViewer.EntryDetails.MaxHeight}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1"
                            Classes="log-empty-state"
                            IsVisible="{Binding LogViewer.IsEmpty}">
                        <TextBlock Text="{Binding Shell.I18n[logNoMatchingEntries]}"
                                   Classes="media-placeholder-text"/>
                    </Border>
                </Grid>
            </controls:DialogSurface.Content>
            <controls:DialogSurface.FooterLeading>
                <Button Classes="flat-action dialog-action" Command="{Binding LogViewer.ExportCommand}"
                        AutomationProperties.Name="{Binding Shell.I18n[exportLogs]}">
                    <StackPanel Classes="button-content">
                        <materialIcons:MaterialIcon Kind="Export" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                        <TextBlock Text="{Binding Shell.I18n[exportLogs]}"/>
                    </StackPanel>
                </Button>
            </controls:DialogSurface.FooterLeading>
            <controls:DialogSurface.Footer>
                <StackPanel Classes="confirm-actions">
                    <Button Classes="flat-action dialog-action" Command="{Binding LogViewer.CloseCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[close]}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:DialogSurface.Footer>
        </controls:DialogSurface>
    </Grid>
</UserControl>
