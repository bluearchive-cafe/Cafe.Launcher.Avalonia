<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:services="using:Cafe.Launcher.Avalonia.Services"
             xmlns:converters="using:Cafe.Launcher.Avalonia.Converters"
             xmlns:constants="using:Cafe.Launcher.Avalonia.Constants"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowToastOverlay"
             x:Name="ToastOverlayRoot"
             x:DataType="vm:MainWindowViewModel">
    <!-- Toast notification overlay -->
    <Grid Classes="toast-host" ZIndex="{x:Static constants:LauncherConstants.ZIndexToast}">
        <ItemsControl ItemsSource="{Binding Toasts.ActiveToasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="toast-list"
                                controls:ToastStackMotion.IsEnabled="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).IsMotionEnabled}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:ToastNotification">
                    <Border Classes="toast-card"
                            Classes.motion-enabled="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).IsMotionEnabled}"
                            Classes.motion-exit="{Binding IsExiting}"
                            IsHitTestVisible="True">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <Grid RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0" Classes="toast-content">
                                <Grid Classes="toast-layout" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <materialIcons:MaterialIcon Grid.Row="0" Grid.Column="0"
                                                                Kind="{Binding IconKind}" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"
                                                                Foreground="{Binding Severity, Converter={x:Static converters:ToastSeverityToBrushConverter.Instance}}"
                                                                VerticalAlignment="Center"
                                                                Classes="toast-icon"
                                                                AutomationProperties.Name="{Binding SeverityLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               Classes="toast-title"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Message}"
                                               Classes="toast-message"/>
                                    <WrapPanel Grid.Row="2" Grid.Column="1"
                                               Classes="toast-actions"
                                               HorizontalAlignment="Left">
                                        <Button Classes="toast-primary-action"
                                                IsVisible="{Binding HasPrimaryAction}"
                                                IsEnabled="{Binding IsActionExecuting, Converter={x:Static BoolConverters.Not}}"
                                                Command="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.ExecutePrimaryToastActionCommand}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding PrimaryActionLabel}">
                                            <TextBlock Text="{Binding PrimaryActionLabel}"/>
                                        </Button>
                                        <Button Classes="toast-secondary-action"
                                                IsVisible="{Binding HasSecondaryAction}"
                                                IsEnabled="{Binding IsActionExecuting, Converter={x:Static BoolConverters.Not}}"
                                                Command="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.ExecuteSecondaryToastActionCommand}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding SecondaryActionLabel}">
                                            <TextBlock Text="{Binding SecondaryActionLabel}"/>
                                        </Button>
                                    </WrapPanel>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                            Classes="toast-close"
                                            Command="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Toasts.DismissToastCommand}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip.Tip="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n[close]}"
                                            AutomationProperties.Name="{Binding #ToastOverlayRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n[close]}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ProgressBar Grid.Row="1"
                                         Classes="toast-progress"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding AutoDismissProgress}"
                                         IsVisible="{Binding HasAutoDismissProgress}"
                                         Foreground="{Binding Severity, Converter={x:Static converters:ToastSeverityToBrushConverter.Instance}}"/>
                            <ProgressBar Grid.Row="1"
                                         Classes="toast-progress"
                                         IsVisible="{Binding IsActionExecuting}"
                                         IsIndeterminate="True"
                                         Foreground="{Binding Severity, Converter={x:Static converters:ToastSeverityToBrushConverter.Instance}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
