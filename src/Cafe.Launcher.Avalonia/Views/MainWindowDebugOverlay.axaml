<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowDebugOverlay"
             x:Name="DebugRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="dialog-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsDebugInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding Debug.IsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <Border Width="{StaticResource Launcher.Layout.Debug.Width}"
                Height="{StaticResource Launcher.Layout.Debug.Height}"
                Classes="dialog overlay-dialog motion-surface">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid RowDefinitions="Auto,*,Auto" Classes="motion-surface-content">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Classes="dialog-header">
                    <StackPanel Classes="dialog-title-row">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="BugOutline" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"
                                                       Foreground="{DynamicResource Launcher.Color.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n[debugPanel]}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dialog-close header-action" Command="{Binding Debug.CloseCommand}"
                            ToolTip.Tip="{Binding Shell.I18n[close]}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                    </Button>
                </Grid>

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}" Margin="{StaticResource Launcher.Spacing.Thickness.Xl}">

                        <!-- System Info -->
                        <Border Classes="dialog-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[debugSystemInfo]}" Classes="section-title"/>
                                <TextBlock Text="{Binding Debug.SystemInfoText}" Classes="caption"
                                           FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <TextBlock Text="{Binding Shell.I18n[logFiles]}" Classes="caption" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Debug.LogFilePath}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                MaxWidth="{StaticResource Launcher.Layout.Debug.Log.Path.MaxWidth}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <TextBlock Text="{Binding Shell.I18n[openDataDirectory]}" Classes="caption" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Debug.DataDirectoryPath}" Classes="caption" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Logs & Diagnostics -->
                        <Border Classes="dialog-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[settingsGroupDiagnostics]}" Classes="section-title"/>

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <TextBlock Text="{Binding Shell.I18n[logLevel]}" Classes="caption" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Debug.LogLevelOptions}"
                                              SelectedIndex="{Binding Debug.SelectedLogLevelIndex, Mode=TwoWay}"
                                               MinWidth="{StaticResource Launcher.Layout.Debug.Log.Level.MinWidth}" Height="{StaticResource Launcher.Control.Height.Setting}"
                                              VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding Shell.I18n[logLevel]}"/>
                                    <TextBlock Text="{Binding Debug.LogLevelDisplay}" Classes="caption" VerticalAlignment="Center"/>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Verbose"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelVerbose]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelVerbose]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Debug"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelDebug]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelDebug]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Info"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelInformation]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelInformation]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Warn"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelWarning]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelWarning]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Error"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelError]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelError]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.WriteTestLogCommand}"
                                            CommandParameter="Fatal"
                                            AutomationProperties.Name="{Binding Shell.I18n[logLevelFatal]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[logLevelFatal]}" Classes="button-content"/>
                                    </Button>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TestToastCommand}"
                                            CommandParameter="Info"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugTestInfoToast]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[debugTestInfoToast]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TestToastCommand}"
                                            CommandParameter="Success"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugTestSuccessToast]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[debugTestSuccessToast]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TestToastCommand}"
                                            CommandParameter="Warning"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugTestWarningToast]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[debugTestWarningToast]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TestToastCommand}"
                                            CommandParameter="Error"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugTestErrorToast]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[debugTestErrorToast]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TestActionToastCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugTestActionToast]}"
                                            Margin="{StaticResource Launcher.Spacing.Thickness.Xs}">
                                        <TextBlock Text="{Binding Shell.I18n[debugTestActionToast]}" Classes="button-content"/>
                                    </Button>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TriggerErrorDialogCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[errorDialogTitle]}">
                                        <TextBlock Text="{Binding Shell.I18n[errorDialogTitle]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.SimulateHandledErrorCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugSimulateError]}">
                                        <TextBlock Text="{Binding Shell.I18n[debugSimulateError]}" Classes="button-content"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Game Operations -->
                        <Border Classes="dialog-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[debugGameOperations]}" Classes="section-title"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <TextBlock Text="{Binding Shell.I18n[debugStatus]}" Classes="caption" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Debug.DownloadStatusText}" Classes="body" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Operations.ProgressDetail}" Classes="caption"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding Debug.IsDownloadRunning}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.RefreshStateCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[refresh]}">
                                        <TextBlock Text="{Binding Shell.I18n[refresh]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.TogglePauseResumeCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[debugPauseResume]}"
                                            IsVisible="{Binding Debug.IsDownloadRunning}">
                                        <TextBlock Text="{Binding Shell.I18n[debugPauseResume]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.StopDownloadCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[stopDownloadTitle]}"
                                            IsVisible="{Binding Debug.IsDownloadRunning}">
                                        <TextBlock Text="{Binding Shell.I18n[stop]}" Classes="button-content"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Settings -->
                        <Border Classes="dialog-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[settings]}" Classes="section-title"/>
                                <Border Classes="confirm-message" MaxHeight="{StaticResource Launcher.Layout.Debug.SettingsPreview.MaxHeight}" Background="{DynamicResource Launcher.Color.Info.Background}">
                                    <ScrollViewer>
                                        <TextBlock Text="{Binding Debug.SettingsJsonDisplay}" Classes="caption"
                                                   FontFamily="{StaticResource Launcher.Typography.FontFamily.Monospace}"
                                                   TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                                <Button Classes="flat-action dialog-action" Command="{Binding Debug.ResetSettingsCommand}"
                                        AutomationProperties.Name="{Binding Shell.I18n[debugResetSettingsConfirm]}">
                                    <TextBlock Text="{Binding Shell.I18n[debugResetSettingsConfirm]}" Classes="button-content"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Output -->
                        <Border Classes="dialog-card">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <TextBlock Text="{Binding Shell.I18n[debugOutput]}" Classes="section-title"/>
                                <Border Classes="dialog-card" Padding="{StaticResource Launcher.Spacing.Thickness.Sm}" Background="{DynamicResource Launcher.Color.Info.Background}">
                                    <TextBlock Text="{Binding Debug.LastActionResult}" Classes="caption"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                                    <Button Classes="flat-action dialog-action" Command="{Binding Gallery.OpenCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[openDesignGallery]}">
                                        <TextBlock Text="{Binding Shell.I18n[openDesignGallery]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.ExportLogsCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[exportLogs]}">
                                        <TextBlock Text="{Binding Shell.I18n[exportLogs]}" Classes="button-content"/>
                                    </Button>
                                    <Button Classes="flat-action dialog-action" Command="{Binding Debug.OpenDataDirectoryCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n[openDataDirectory]}">
                                        <TextBlock Text="{Binding Shell.I18n[openDataDirectory]}" Classes="button-content"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Classes="dialog-footer">
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="primary-action dialog-action" Command="{Binding Debug.CloseCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[close]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[close]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
