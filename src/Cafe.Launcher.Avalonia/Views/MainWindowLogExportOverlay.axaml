<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowLogExportOverlay"
             x:Name="LogExportRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="dialog-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsLogExportInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding LogExport.IsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <!-- Panel 形态：范围选择是表单而非决策，沿用面板外壳与发丝底带动作槽。 -->
        <controls:DialogSurface
            Form="Panel"
            Classes="motion-surface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
            MaxWidth="{StaticResource Launcher.Layout.LogExport.Width}"
            MaxHeight="{StaticResource Launcher.Layout.LogExport.MaxHeight}"
            Title="{Binding Shell.I18n[logExportTitle]}"
            CloseCommand="{Binding LogExport.CloseCommand}"
            CloseAutomationName="{Binding Shell.I18n[close]}"
            CloseToolTip="{Binding Shell.I18n[close]}">
            <controls:DialogSurface.RenderTransform>
                <TranslateTransform/>
            </controls:DialogSurface.RenderTransform>
            <controls:DialogSurface.HeaderIcon>
                <materialIcons:MaterialIcon Kind="ExitToApp" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
            </controls:DialogSurface.HeaderIcon>
            <controls:DialogSurface.Content>
                <StackPanel>
                    <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding Shell.I18n[logExportRangeGroup]}" Classes="group-title"/>

                        <controls:SettingSelect ShowTopDivider="False"
                                                Title="{Binding Shell.I18n[logExportRange]}"
                                                Description="{Binding Shell.I18n[logExportRangeDescription]}"
                                                AutomationName="{Binding Shell.I18n[logExportRange]}"
                                                ItemsSource="{Binding LogExport.RangeOptions}"
                                                SelectedValue="{Binding LogExport.SelectedRangeCode, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- 范围提示紧随范围组：它说的是所选范围里有没有日志，而不是内容清单。 -->
                    <Border Classes="dialog-card log-export-warning"
                            IsVisible="{Binding LogExport.IsEmptyRangeWarningVisible}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="{StaticResource Launcher.Spacing.Sm}">
                            <materialIcons:MaterialIcon Kind="AlertOutline"
                                                        Grid.Column="0"
                                                        Width="{StaticResource Launcher.Icon.Sm}"
                                                        Height="{StaticResource Launcher.Icon.Sm}"
                                                        Foreground="{DynamicResource Launcher.Color.Warning}"
                                                        VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Shell.I18n[logExportRangeEmpty]}"
                                       Grid.Column="1"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Classes="settings-group">
                        <TextBlock Text="{Binding Shell.I18n[logExportContentGroup]}" Classes="group-title"/>

                        <controls:SettingRow ShowTopDivider="False"
                                             Title="{Binding Shell.I18n[logExportIncludeLogs]}"
                                             Description="{Binding Shell.I18n[logExportIncludeLogsDescription]}">
                            <controls:SettingRow.Action>
                                <CheckBox Classes="setting-checkbox"
                                          AutomationProperties.Name="{Binding Shell.I18n[logExportIncludeLogs]}"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"/>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow Title="{Binding Shell.I18n[logExportIncludeSystemInfo]}"
                                             Description="{Binding Shell.I18n[logExportIncludeSystemInfoDescription]}">
                            <controls:SettingRow.Action>
                                <CheckBox Classes="setting-checkbox"
                                          AutomationProperties.Name="{Binding Shell.I18n[logExportIncludeSystemInfo]}"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"/>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow Title="{Binding Shell.I18n[logExportIncludeCrashReports]}"
                                             Description="{Binding Shell.I18n[logExportIncludeCrashReportsDescription]}">
                            <controls:SettingRow.Action>
                                <CheckBox Classes="setting-checkbox"
                                          AutomationProperties.Name="{Binding Shell.I18n[logExportIncludeCrashReports]}"
                                          IsChecked="{Binding LogExport.IncludeCrashReports, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow Title="{Binding Shell.I18n[logExportIncludeUserData]}"
                                             Description="{Binding Shell.I18n[logExportIncludeUserDataDescription]}">
                            <controls:SettingRow.Action>
                                <CheckBox Classes="setting-checkbox"
                                          AutomationProperties.Name="{Binding Shell.I18n[logExportIncludeUserData]}"
                                          IsChecked="{Binding LogExport.IncludeUserData, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>
                    </StackPanel>

                    <Border Classes="dialog-card log-export-warning"
                            IsVisible="{Binding LogExport.IsUserDataWarningVisible}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="{StaticResource Launcher.Spacing.Sm}">
                            <materialIcons:MaterialIcon Kind="AlertOutline"
                                                        Grid.Column="0"
                                                        Width="{StaticResource Launcher.Icon.Sm}"
                                                        Height="{StaticResource Launcher.Icon.Sm}"
                                                        Foreground="{DynamicResource Launcher.Color.Warning}"
                                                        VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Shell.I18n[logExportUserDataWarning]}"
                                       Grid.Column="1"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </controls:DialogSurface.Content>
            <controls:DialogSurface.Footer>
                <StackPanel Classes="confirm-actions">
                    <Button Classes="flat-action dialog-action"
                            Command="{Binding LogExport.CloseCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[cancel]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[cancel]}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary-action dialog-action"
                            Command="{Binding LogExport.ExportCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[logExportConfirm]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="ExitToApp" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[logExportConfirm]}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:DialogSurface.Footer>
        </controls:DialogSurface>
    </Grid>
</UserControl>
