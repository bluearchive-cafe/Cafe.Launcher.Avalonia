<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:setup="using:Cafe.Launcher.Avalonia.Features.SetupWizard"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:converters="using:Cafe.Launcher.Avalonia.Converters"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.SetupWizardOverlay"
             x:Name="WizardRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="setup-wizard-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsSetupWizardInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding Dialogs.IsSetupWizardVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MaxWidth="{StaticResource Launcher.Layout.SetupWizard.Width}"
                MaxHeight="{StaticResource Launcher.Layout.SetupWizard.Height}"
                Classes="dialog overlay-dialog confirm-panel motion-surface">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid ColumnDefinitions="Auto,*" Classes="motion-surface-content">
                <Grid Classes="settings-navigation-pane"
                      Width="{StaticResource Launcher.Component.SetupWizard.Navigation.Width}"
                      RowDefinitions="Auto,*">
                    <Border Classes="settings-navigation-header">
                        <StackPanel Classes="dialog-title-row">
                            <TextBlock Text="{Binding Shell.I18n[setupWizardStepTitle]}" Classes="dialog-title" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" Classes="settings-navigation wizard-navigation"
                             ItemsSource="{Binding Dialogs.SetupWizard.Steps}"
                             SelectedValue="{Binding Dialogs.SetupWizard.SelectedStep, Mode=TwoWay}"
                             SelectedValueBinding="{Binding Index}"
                             AutomationProperties.Name="{Binding Shell.I18n[setupWizardStepTitle]}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="setup:SetupWizardStepItem">
                                <Setter Property="IsEnabled" Value="{Binding CanNavigate}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="setup:SetupWizardStepItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Launcher.Spacing.Sm}">
                                    <TextBlock Text="{Binding DisplayNumber}" Classes="wizard-step-number"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Classes="settings-navigation-item"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="{Binding Title}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                <!-- Header row -->
                <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="dialog-icon" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="StarOutline"
                                                   Width="{StaticResource Launcher.Icon.Xl}"
                                                   Height="{StaticResource Launcher.Icon.Xl}"
                                                   Foreground="{DynamicResource Launcher.Color.Primary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                        <TextBlock Text="{Binding Dialogs.SetupWizard.StepProgress}" Classes="caption"/>
                        <TextBlock Text="{Binding Dialogs.SetupWizard.StepTitle}" Classes="dialog-title"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="flat-action dialog-action"
                            Command="{Binding Dialogs.RequestSetupWizardExitCommand}"
                            ToolTip.Tip="{Binding Shell.I18n[setupWizardSkip]}"
                            AutomationProperties.Name="{Binding Shell.I18n[setupWizardSkip]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="Close"
                                                       Width="{StaticResource Launcher.Icon.Sm}"
                                                       Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardSkip]}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Content row -->
                <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Lg}">

                        <!-- Step 0: Welcome & Language -->
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding Dialogs.SetupWizard.IsFirstStep}"
                                    Classes="motion-content"
                                    Classes.motion-enabled="{Binding IsMotionEnabled}"
                                    Classes.motion-enter="{Binding Dialogs.SetupWizard.IsFirstStep}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <Border Classes="info-strip">
                                <TextBlock Text="{Binding Shell.I18n[setupWizardWelcomeText]}"
                                           Classes="body"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardLanguage]}" Classes="section-title"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardLanguageHint]}" Classes="caption"/>
                            <ComboBox Classes="setting-control"
                                      ItemsSource="{Binding Dialogs.LanguageOptions}"
                                      SelectedValue="{Binding Dialogs.SetupWizard.Language, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Code}"
                                      HorizontalAlignment="Left"
                                      MinWidth="{StaticResource Launcher.Component.SetupWizard.Select.MinWidth}"
                                      AutomationProperties.Name="{Binding Shell.I18n[setupWizardLanguage]}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Step 1: Game Path -->
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding Dialogs.SetupWizard.IsStep1}"
                                    Classes="motion-content"
                                    Classes.motion-enabled="{Binding IsMotionEnabled}"
                                    Classes.motion-enter="{Binding Dialogs.SetupWizard.IsStep1}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardGamePath]}" Classes="section-title"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardGamePathHint]}"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                <TextBox Classes="uid-input"
                                         Text="{Binding Dialogs.SetupWizard.GamePath, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Shell.I18n[setupWizardGamePath]}"/>
                                <Button Grid.Column="1"
                                        Classes="flat-action dialog-action"
                                        Command="{Binding Dialogs.SetupWizard.BrowseGamePathCommand}"
                                        AutomationProperties.Name="{Binding Shell.I18n[setupWizardBrowse]}">
                                    <StackPanel Classes="button-content">
                                        <materialIcons:MaterialIcon Kind="FolderOpen"
                                                                   Width="{StaticResource Launcher.Icon.Sm}"
                                                                   Height="{StaticResource Launcher.Icon.Sm}"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardBrowse]}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Dialogs.SetupWizard.GamePathStatusText}"
                                       AutomationProperties.Name="{Binding Dialogs.SetupWizard.GamePathStatusText}"
                                       Classes="caption wizard-game-path-status"
                                       Classes.checking="{Binding Dialogs.SetupWizard.IsGamePathChecking}"
                                       Classes.ready="{Binding Dialogs.SetupWizard.IsGamePathReady}"
                                       Classes.corrupted="{Binding Dialogs.SetupWizard.IsGamePathCorruptedInstallation}"
                                       Classes.inaccessible="{Binding Dialogs.SetupWizard.IsGamePathInaccessible}"
                                       IsVisible="{Binding Dialogs.SetupWizard.IsGamePathEmpty, Converter={x:Static BoolConverters.Not}}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardGamePathEmpty]}"
                                       Classes="caption"
                                       Foreground="{StaticResource Launcher.Color.Danger}"
                                       IsVisible="{Binding Dialogs.SetupWizard.IsGamePathEmpty}"/>
                        </StackPanel>

                        <!-- Step 2: Download Source -->
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding Dialogs.SetupWizard.IsStep2}"
                                    Classes="motion-content"
                                    Classes.motion-enabled="{Binding IsMotionEnabled}"
                                    Classes.motion-enter="{Binding Dialogs.SetupWizard.IsStep2}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardDownloadSource]}" Classes="section-title"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardDownloadSourceHint]}"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <RadioButton GroupName="SetupWizardDownloadSource"
                                        IsChecked="{Binding Dialogs.SetupWizard.IsPatchUrlGroupCafe, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Shell.I18n[downloadSourceCafe]}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.I18n[downloadSourceCafe]}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardDownloadSourceCafeDescription]}" Classes="caption"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="SetupWizardDownloadSource"
                                        IsChecked="{Binding Dialogs.SetupWizard.IsPatchUrlGroupOfficial, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Shell.I18n[downloadSourceOfficial]}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.I18n[downloadSourceOfficial]}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardDownloadSourceOfficialDescription]}" Classes="caption"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 3: Proxy -->
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding Dialogs.SetupWizard.IsStep3}"
                                    Classes="motion-content"
                                    Classes.motion-enabled="{Binding IsMotionEnabled}"
                                    Classes.motion-enter="{Binding Dialogs.SetupWizard.IsStep3}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardProxy]}" Classes="section-title"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardProxyHint]}"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}">
                                <RadioButton GroupName="SetupWizardProxy"
                                        IsChecked="{Binding Dialogs.SetupWizard.IsProxyAuto, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Shell.I18n[proxyAuto]}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.I18n[proxyAuto]}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardProxyAutoDescription]}" Classes="caption"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="SetupWizardProxy"
                                        IsChecked="{Binding Dialogs.SetupWizard.IsProxyDirect, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Shell.I18n[proxyDirect]}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.I18n[proxyDirect]}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardProxyDirectDescription]}" Classes="caption"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="SetupWizardProxy"
                                        IsChecked="{Binding Dialogs.SetupWizard.IsProxySystem, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Shell.I18n[proxySystem]}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.I18n[proxySystem]}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardProxySystemDescription]}" Classes="caption"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 4: Review -->
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding Dialogs.SetupWizard.IsLastStep}"
                                    Classes="motion-content"
                                    Classes.motion-enabled="{Binding IsMotionEnabled}"
                                    Classes.motion-enter="{Binding Dialogs.SetupWizard.IsLastStep}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardReview]}" Classes="section-title"/>
                            <TextBlock Text="{Binding Shell.I18n[setupWizardReviewHint]}"
                                       Classes="body"
                                       TextWrapping="Wrap"/>
                            <Border Classes="info-strip">
                                <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}">
                                    <Grid Classes="wizard-review-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardLanguage]}" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Dialogs.SetupWizard.LanguageDisplayName}"
                                                   Classes="value"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="flat-action dialog-action wizard-review-edit"
                                                Command="{Binding Dialogs.SetupWizard.GoToStepCommand}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardEditStep]}">
                                            <Button.CommandParameter>
                                                <x:Int32>0</x:Int32>
                                            </Button.CommandParameter>
                                            <TextBlock Text="{Binding Shell.I18n[setupWizardEditStep]}"/>
                                        </Button>
                                    </Grid>
                                    <Border Classes="wizard-review-divider"/>
                                    <Grid Classes="wizard-review-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardDownloadSource]}" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Dialogs.SetupWizard.DownloadSourceDisplayName}"
                                                   Classes="value"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="flat-action dialog-action wizard-review-edit"
                                                Command="{Binding Dialogs.SetupWizard.GoToStepCommand}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardEditStep]}">
                                            <Button.CommandParameter>
                                                <x:Int32>2</x:Int32>
                                            </Button.CommandParameter>
                                            <TextBlock Text="{Binding Shell.I18n[setupWizardEditStep]}"/>
                                        </Button>
                                    </Grid>
                                    <Border Classes="wizard-review-divider"/>
                                    <Grid Classes="wizard-review-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardGamePath]}" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Dialogs.SetupWizard.GamePath}"
                                                   Classes="value"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="flat-action dialog-action wizard-review-edit"
                                                Command="{Binding Dialogs.SetupWizard.GoToStepCommand}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardEditStep]}">
                                            <Button.CommandParameter>
                                                <x:Int32>1</x:Int32>
                                            </Button.CommandParameter>
                                            <TextBlock Text="{Binding Shell.I18n[setupWizardEditStep]}"/>
                                        </Button>
                                    </Grid>
                                    <Border Classes="wizard-review-divider"/>
                                    <Grid Classes="wizard-review-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                        <TextBlock Text="{Binding Shell.I18n[setupWizardProxy]}" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Dialogs.SetupWizard.ProxyDisplayName}"
                                                   Classes="value"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="flat-action dialog-action wizard-review-edit"
                                                Command="{Binding Dialogs.SetupWizard.GoToStepCommand}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardEditStep]}">
                                            <Button.CommandParameter>
                                                <x:Int32>3</x:Int32>
                                            </Button.CommandParameter>
                                            <TextBlock Text="{Binding Shell.I18n[setupWizardEditStep]}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer row -->
                <Border Grid.Row="2" Classes="dialog-footer">
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action"
                                Command="{Binding Dialogs.SetupWizard.PreviousCommand}"
                                IsVisible="{Binding Dialogs.SetupWizard.CanGoPrevious}"
                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardPrevious]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ChevronLeft"
                                                           Width="{StaticResource Launcher.Icon.Sm}"
                                                           Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[setupWizardPrevious]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.SetupWizard.NextCommand}"
                                IsVisible="{Binding Dialogs.SetupWizard.IsLastStep, Converter={x:Static BoolConverters.Not}}"
                                IsEnabled="{Binding Dialogs.SetupWizard.CanGoNext}"
                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardNext]}">
                            <StackPanel Classes="button-content">
                                <TextBlock Text="{Binding Shell.I18n[setupWizardNext]}"/>
                                <materialIcons:MaterialIcon Kind="ChevronRight"
                                                           Width="{StaticResource Launcher.Icon.Sm}"
                                                           Height="{StaticResource Launcher.Icon.Sm}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.SetupWizard.CompleteCommand}"
                                IsVisible="{Binding Dialogs.SetupWizard.IsLastStep}"
                                AutomationProperties.Name="{Binding Shell.I18n[setupWizardFinish]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check"
                                                           Width="{StaticResource Launcher.Icon.Sm}"
                                                           Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[setupWizardFinish]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
