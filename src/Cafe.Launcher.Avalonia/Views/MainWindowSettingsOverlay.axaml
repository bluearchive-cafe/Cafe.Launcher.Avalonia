<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Cafe.Launcher.Avalonia.Views"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowSettingsOverlay"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="settings-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsSettingsInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding WindowChrome.IsSettingsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <Border MaxWidth="{StaticResource Launcher.Layout.Settings.MaxWidth}"
                MaxHeight="{StaticResource Launcher.Layout.Settings.MaxHeight}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="dialog overlay-dialog motion-surface">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid RowDefinitions="*,Auto" Classes="motion-surface-content">
                <Grid Classes="settings-workspace" ColumnDefinitions="216,*">
                    <Grid Classes="settings-navigation-pane" RowDefinitions="Auto,*">
                        <Border Classes="settings-navigation-header">
                            <StackPanel Classes="dialog-title-row">
                                <TextBlock Text="{Binding Shell.I18n[settings]}" Classes="dialog-title" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" Classes="settings-navigation"
                             x:Name="SettingsNavigation"
                             AutomationProperties.AutomationId="SettingsNavigation"
                             Focusable="True"
                             FocusAdorner="{x:Null}"
                             ItemsSource="{Binding Settings.Options.SettingsCategories}"
                             SelectedValue="{Binding Settings.SelectedCategory, Mode=TwoWay}"
                             SelectedValueBinding="{Binding Code}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SettingOption">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Launcher.Spacing.Sm}">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                Width="{StaticResource Launcher.Icon.Md}"
                                                                Height="{StaticResource Launcher.Icon.Md}"
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Classes="settings-navigation-item"
                                               ToolTip.Tip="{Binding DisplayName}"
                                               AutomationProperties.Name="{Binding DisplayName}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Column="1" Classes="settings-content">
                        <Border Classes="settings-content-padding">
                                <ScrollViewer Classes="dialog-scroll settings-content-scroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                                    <StackPanel Classes="category-header settings-category-header">
                                        <Grid Classes="settings-content-heading" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                            <StackPanel DataContext="{Binding SelectedItem, ElementName=SettingsNavigation}"
                                                        x:DataType="models:SettingOption"
                                                        Classes="settings-content-heading-copy">
                                                <TextBlock Classes="category-title"
                                                           Text="{Binding DisplayName}"
                                                           AutomationProperties.Name="{Binding DisplayName}"/>
                                                <TextBlock Classes="category-subtitle"
                                                           Text="{Binding Description}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="dialog-close content-header-action"
                                                    Command="{Binding WindowChrome.ShowSettingsCommand}"
                                                    IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}"
                                                    ToolTip.Tip="{Binding Shell.I18n[close]}"
                                                    AutomationProperties.Name="{Binding Shell.I18n[close]}"
                                                    VerticalAlignment="Top">
                                                <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                                            </Button>
                                        </Grid>
                                <views:SettingsGeneralSection IsVisible="{Binding Settings.IsGeneralCategorySelected}"
                                                              Classes="motion-content"
                                                              Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                              Classes.motion-enter="{Binding Settings.IsGeneralCategorySelected}">
                                    <views:SettingsGeneralSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsGeneralSection.RenderTransform>
                                </views:SettingsGeneralSection>
                                <views:SettingsGameSection IsVisible="{Binding Settings.IsGameCategorySelected}"
                                                           Classes="motion-content"
                                                           Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                           Classes.motion-enter="{Binding Settings.IsGameCategorySelected}">
                                    <views:SettingsGameSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsGameSection.RenderTransform>
                                </views:SettingsGameSection>
                                <views:SettingsDownloadNetworkSection IsVisible="{Binding Settings.IsDownloadNetworkCategorySelected}"
                                                                      Classes="motion-content"
                                                                      Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                                      Classes.motion-enter="{Binding Settings.IsDownloadNetworkCategorySelected}">
                                    <views:SettingsDownloadNetworkSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsDownloadNetworkSection.RenderTransform>
                                </views:SettingsDownloadNetworkSection>
                                <views:SettingsAppearanceSection IsVisible="{Binding Settings.IsAppearanceCategorySelected}"
                                                                 Classes="motion-content"
                                                                 Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                                 Classes.motion-enter="{Binding Settings.IsAppearanceCategorySelected}">
                                    <views:SettingsAppearanceSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAppearanceSection.RenderTransform>
                                </views:SettingsAppearanceSection>
                                <views:SettingsAdvancedSection IsVisible="{Binding Settings.IsAdvancedCategorySelected}"
                                                               Classes="motion-content"
                                                               Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                               Classes.motion-enter="{Binding Settings.IsAdvancedCategorySelected}">
                                    <views:SettingsAdvancedSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAdvancedSection.RenderTransform>
                                </views:SettingsAdvancedSection>
                                <views:SettingsAboutSection IsVisible="{Binding Settings.IsAboutCategorySelected}"
                                                            Classes="motion-content"
                                                            Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                            Classes.motion-enter="{Binding Settings.IsAboutCategorySelected}">
                                    <views:SettingsAboutSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAboutSection.RenderTransform>
                                </views:SettingsAboutSection>
                                    </StackPanel>
                                </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Classes="dialog-footer">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Launcher.Spacing.Sm}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Classes="flat-action dialog-action"
                                Command="{Binding WindowChrome.ShowSettingsCommand}"
                                IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}"
                                ToolTip.Tip="{Binding Shell.I18n[cancel]}"
                                AutomationProperties.Name="{Binding Shell.I18n[cancel]}">
                            <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CloseCircleOutline"
                                    Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[cancel]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Settings.SaveSettingsCommand}"
                                IsEnabled="{Binding Settings.CanSaveSettings}"
                                ToolTip.Tip="{Binding Shell.I18n[save]}"
                                AutomationProperties.Name="{Binding Shell.I18n[save]}">
                            <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ContentSave"
                                    Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[save]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
