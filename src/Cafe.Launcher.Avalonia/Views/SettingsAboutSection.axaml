<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:documents="using:Avalonia.Controls.Documents"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.SettingsAboutSection"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel"><StackPanel Classes="settings-group" Spacing="{StaticResource Launcher.Spacing.Md}">
        <!-- 身份卡：产品名 + 版本 caption + 副标题；操作行内收（ADR-018 融合变体） -->
        <Border Classes="about-identity-card">
            <StackPanel Spacing="{StaticResource Launcher.Spacing.Lg}">
                <StackPanel Spacing="{StaticResource Launcher.Spacing.Xs}">
                    <TextBlock Text="{Binding Shell.ProductName}" Classes="about-product-name"/>
                    <TextBlock Text="{Binding Shell.VersionCaptionText}" Classes="caption"/>
                    <TextBlock Text="{Binding Shell.I18n[aboutDescription]}" Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}">
                    <Button Classes="primary-action compact-action"
                            Command="{Binding Settings.CheckForUpdatesCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[checkUpdates]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[checkUpdates]}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="flat-action"
                            Command="{Binding WindowChrome.OpenOfficialSiteCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[officialSite]}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="flat-action"
                            Command="{Binding WindowChrome.OpenHelpDocsCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[helpDocs]}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[helpDocs]}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 版本详细信息：key-value 行 + inset hairline（值用等宽字体） -->
        <TextBlock Text="{Binding Shell.I18n[versionInfo]}" Classes="group-title"/>
        <Border Classes="about-kv-list">
            <StackPanel>
                <Grid Classes="about-kv-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Shell.I18n[aboutRowCommit]}" Classes="caption"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.CommitShaValue}" Classes="about-kv-value" TextWrapping="Wrap"/>
                </Grid>
                <Border Classes="settings-row-divider"/>
                <Grid Classes="about-kv-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Shell.I18n[aboutRowBuildConfig]}" Classes="caption"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.BuildConfigValue}" Classes="about-kv-value" TextWrapping="Wrap"/>
                </Grid>
                <Border Classes="settings-row-divider"/>
                <Grid Classes="about-kv-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Shell.I18n[aboutRowRuntime]}" Classes="caption"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.FrameworkVersionText}" Classes="about-kv-value" TextWrapping="Wrap"/>
                </Grid>
                <Border Classes="settings-row-divider"/>
                <Grid Classes="about-kv-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Shell.I18n[aboutRowAvalonia]}" Classes="caption"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.AvaloniaVersionText}" Classes="about-kv-value" TextWrapping="Wrap"/>
                </Grid>
                <Border Classes="settings-row-divider"/>
                <Grid Classes="about-kv-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Shell.I18n[aboutRowPlatform]}" Classes="caption"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.PlatformValue}" Classes="about-kv-value" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 无选择语义的操作列表：ItemsControl 负责排列，Button 负责交互与命令。 -->
        <TextBlock Text="{Binding Shell.I18n[aboutQuickLinks]}" Classes="group-title"/>
        <ItemsControl Classes="about-link-list">
            <Button Classes="about-link-item"
                    Command="{Binding WindowChrome.OpenGitHubRepositoryCommand}"
                    AutomationProperties.Name="{Binding Shell.I18n[gitHubRepository]}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                    <materialIcons:MaterialIcon Kind="Github" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}" Foreground="{DynamicResource Launcher.Text.Body}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.I18n[gitHubRepository]}" VerticalAlignment="Center"/>
                    <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}" Foreground="{DynamicResource Launcher.Text.Secondary}"/>
                </Grid>
            </Button>
            <Border Classes="settings-row-divider"/>
            <Button Classes="about-link-item"
                    Command="{Binding WindowChrome.OpenIssueTrackerCommand}"
                    AutomationProperties.Name="{Binding Shell.I18n[issueTracker]}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                    <materialIcons:MaterialIcon Kind="MessageAlertOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}" Foreground="{DynamicResource Launcher.Text.Body}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Shell.I18n[issueTracker]}" VerticalAlignment="Center"/>
                    <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}" Foreground="{DynamicResource Launcher.Text.Secondary}"/>
                </Grid>
            </Button>
        </ItemsControl>

        <!-- 法律信息：2 个内联链接（契约语义保留） -->
        <StackPanel Spacing="{StaticResource Launcher.Spacing.Xs}">
            <TextBlock Text="{Binding Shell.I18n[aboutLinks]}" Classes="group-title"/>
            <TextBlock Classes="caption" TextWrapping="Wrap">
                <Run Text="{Binding Shell.I18n[aboutCopyrightText]}"/><Run Text=" "/>
                <documents:InlineUIContainer>
                    <HyperlinkButton Classes="inline-legal-link"
                                     Content="{Binding Shell.I18n[privacyPolicy]}"
                                     Command="{Binding WindowChrome.OpenPrivacyPolicyCommand}"
                                     AutomationProperties.Name="{Binding Shell.I18n[privacyPolicy]}"/>
                </documents:InlineUIContainer>
            </TextBlock>
            <TextBlock Classes="caption" TextWrapping="Wrap">
                <Run Text="{Binding Shell.I18n[defaultBackgroundCopyrightText]}"/><Run Text=" "/>
                <documents:InlineUIContainer>
                    <HyperlinkButton Classes="inline-legal-link"
                                     Content="{Binding Shell.I18n[defaultBackgroundArtwork]}"
                                     Command="{Binding WindowChrome.OpenDefaultBackgroundArtworkCommand}"
                                     AutomationProperties.Name="{Binding Shell.I18n[defaultBackgroundArtwork]}"/>
                </documents:InlineUIContainer>
            </TextBlock>
            <TextBlock Text="{Binding Shell.I18n[aboutDisclaimerText]}" Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
