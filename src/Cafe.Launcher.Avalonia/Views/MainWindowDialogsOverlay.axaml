<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:converters="using:Cafe.Launcher.Avalonia.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:markdown="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:views="using:Cafe.Launcher.Avalonia.Views"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowDialogsOverlay"
             x:Name="DialogsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <!-- 资源面板（主叠层）宿主于此容器并占据 FirstChild：其层序位于对话框
             层之下依赖「首个子元素先渲染」这一顺序，勿移动或插入子项到其前。 -->
        <views:ResourcePanelOverlay/>

        <!-- Notice popup dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsNoticeDialogVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
                <!-- Basic 形态：裸图标（无容器）承载语调，动作即出口；修正旧的
                     ResourcePanel 内容限高错引，高度交由表面档案与滚动区接管。 -->
                <controls:DialogSurface
                    Form="Basic"
                    Classes="motion-surface"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
                    MaxWidth="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"
                    MaxHeight="{StaticResource Launcher.Component.Dialog.Confirm.MaxHeight}"
                    Title="{Binding Shell.I18n[notice]}">
                    <controls:DialogSurface.RenderTransform>
                        <TranslateTransform/>
                    </controls:DialogSurface.RenderTransform>
                    <controls:DialogSurface.BasicIcon>
                        <materialIcons:MaterialIcon Kind="InformationOutline"
                                                    Classes="dialog-alert-icon"
                                                    Width="{StaticResource Launcher.Icon.Xl}"
                                                    Height="{StaticResource Launcher.Icon.Xl}"/>
                    </controls:DialogSurface.BasicIcon>
                    <controls:DialogSurface.Content>
                        <Border Classes="dialog-alert">
                            <StackPanel Spacing="{StaticResource Launcher.Spacing.Xs}">
                                <StackPanel Classes="dialog-alert-heading">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Classes="dialog-alert-icon"
                                                                Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                    <TextBlock Text="{Binding Shell.I18n[notice]}" Classes="dialog-alert-title"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Dialogs.NoticeDialogContent}" Classes="dialog-alert-content"/>
                            </StackPanel>
                            </Border>
                    </controls:DialogSurface.Content>
                    <controls:DialogSurface.Footer>
                        <StackPanel Classes="confirm-actions">
                            <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.DismissNoticeCommand}"
                                    AutomationProperties.Name="{Binding Shell.I18n[noticeConfirm]}">
                                <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Dialogs.NoticeDialogConfirmText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:DialogSurface.Footer>
                </controls:DialogSurface>
        </Grid>

        <!-- Repair confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.RepairConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[repairConfirm]}"
                                Message="{Binding Dialogs.RepairConfirm.Message}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.RepairConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[repair]}"
                                ConfirmCommand="{Binding Dialogs.RepairConfirm.ConfirmCommand}"/>

        <!-- Resource Panel source confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.ResourcePanelSourceConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[resourcePanelCafeOnlyTitle]}"
                                Message="{Binding Dialogs.ResourcePanelSourceConfirm.Message}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.ResourcePanelSourceConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[resourcePanelCafeOnlySwitch]}"
                                ConfirmCommand="{Binding Dialogs.ResourcePanelSourceConfirm.ConfirmCommand}"/>

        <!-- Update available dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsUpdateAvailableVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <!-- Panel 形态（中号 620）：版本行进副标题，取消/下载保留在主动作组。 -->
            <controls:DialogSurface
                Form="Panel"
                Classes="motion-surface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
                MaxWidth="{StaticResource Launcher.Component.Dialog.Update.MaxWidth}"
                Title="{Binding Shell.I18n[launcherUpdateAvailableTitle]}"
                Subtitle="{Binding Dialogs.UpdateAvailableText}"
                CloseCommand="{Binding Dialogs.CancelUpdateAvailableCommand}"
                CloseAutomationName="{Binding Shell.I18n[close]}"
                CloseToolTip="{Binding Shell.I18n[close]}">
                <controls:DialogSurface.RenderTransform>
                    <TranslateTransform/>
                </controls:DialogSurface.RenderTransform>
                <controls:DialogSurface.HeaderIcon>
                    <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                </controls:DialogSurface.HeaderIcon>
                <controls:DialogSurface.Content>
                    <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}">
                        <markdown:MarkdownScrollViewer
                            IsVisible="{Binding Dialogs.HasUpdateReleaseNotes}"
                            Markdown="{Binding Dialogs.UpdateReleaseNotes}"
                            MaxHeight="240"/>
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Md}"
                                    IsVisible="{Binding !Dialogs.UpdateSupportsInAppApply}">
                        <StackPanel Classes="card-heading">
                            <materialIcons:MaterialIcon Kind="InformationOutline"
                                                       Width="{StaticResource Launcher.Icon.Sm}"
                                                       Height="{StaticResource Launcher.Icon.Sm}"
                                                       Foreground="{DynamicResource Launcher.Color.Primary}"
                                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Shell.I18n[launcherUpdateSelectFile]}"
                                       Classes="dialog-alert-content"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                            <ListBox ItemsSource="{Binding Dialogs.UpdateAvailableFiles}"
                                     SelectedItem="{Binding Dialogs.SelectedUpdateFile, Mode=TwoWay}"
                                     Classes="update-file-list"
                                     MaxHeight="{StaticResource Launcher.Component.Dialog.Update.FileList.MaxHeight}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReleaseFile">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="{StaticResource Launcher.Spacing.Md}">
                                            <Border Classes="update-file-icon">
                                                <materialIcons:MaterialIcon Kind="Download"
                                                                           Width="{StaticResource Launcher.Icon.Lg}"
                                                                           Height="{StaticResource Launcher.Icon.Lg}"
                                                                           Foreground="{DynamicResource Launcher.Color.Primary}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Spacing="{StaticResource Launcher.Spacing.Xs}"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Classes="update-file-name"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Url}"
                                                           Classes="caption"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"/>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Classes="update-file-size"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource Launcher.Spacing.Xs}">
                                                    <TextBlock Text="{Binding #DialogsRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n[launcherUpdateFileSize]}"
                                                               Classes="caption"/>
                                                    <TextBlock Text="{Binding DisplaySize}"
                                                               Classes="update-file-size-text"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Launcher.Spacing.Sm}"
                                    IsVisible="{Binding Dialogs.IsUpdateApplying}">
                            <TextBlock Text="{Binding Dialogs.UpdateStatusText}"
                                       Classes="dialog-alert-content"
                                       TextWrapping="Wrap"/>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Dialogs.UpdateProgress}"
                                         IsVisible="{Binding Dialogs.IsUpdateDownloading}"
                                         Height="{StaticResource Launcher.Component.Progress.Bar.Height}"/>
                        </StackPanel>
                    </StackPanel>
                </controls:DialogSurface.Content>
                <controls:DialogSurface.Footer>
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelUpdateAvailableCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[launcherUpdateLater]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[launcherUpdateLater]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.ConfirmUpdateAvailableCommand}"
                                IsEnabled="{Binding Dialogs.CanConfirmUpdate}"
                                IsVisible="{Binding !Dialogs.IsUpdateReadyToRestart}"
                                AutomationProperties.Name="{Binding Shell.I18n[launcherUpdateDownload]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[launcherUpdateDownload]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.ConfirmUpdateAvailableCommand}"
                                IsVisible="{Binding Dialogs.IsUpdateReadyToRestart}"
                                AutomationProperties.Name="{Binding Shell.I18n[launcherUpdateRestart]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[launcherUpdateRestart]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:DialogSurface.Footer>
            </controls:DialogSurface>
        </Grid>

        <!-- Stop download confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.StopConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[stopDownloadTitle]}"
                                Message="{Binding Dialogs.StopConfirm.Message}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.StopConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[stop]}"
                                ConfirmCommand="{Binding Dialogs.StopConfirm.ConfirmCommand}"
                                IsDangerConfirm="True"/>

        <!-- Download running close confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.DownloadRunningCloseConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[closeDownloadTitle]}"
                                Message="{Binding Dialogs.DownloadRunningCloseConfirm.Message}"
                                CancelText="{Binding Shell.I18n[continueDownload]}"
                                CancelCommand="{Binding Dialogs.DownloadRunningCloseConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[stopAndExit]}"
                                ConfirmCommand="{Binding Dialogs.DownloadRunningCloseConfirm.ConfirmCommand}"
                                IsDangerConfirm="True"/>

        <!-- Uninstall confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.UninstallConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[confirmUninstall]}"
                                Message="{Binding Dialogs.UninstallConfirm.Message}"
                                OptionText="{Binding Operations.ThoroughUninstallOptionText}"
                                IsOptionChecked="{Binding Operations.IsThoroughUninstallSelected, Mode=TwoWay}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.UninstallConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[uninstall]}"
                                ConfirmCommand="{Binding Dialogs.UninstallConfirm.ConfirmCommand}"
                                IsDangerConfirm="True"/>

        <!-- Unsaved changes confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Settings.IsUnsavedChangesVisible}"
                                Title="{Binding Shell.I18n[unsavedChanges]}"
                                Message="{Binding Shell.I18n[unsavedChangesMessage]}"
                                CancelText="{Binding Shell.I18n[keepEditing]}"
                                CancelCommand="{Binding WindowChrome.KeepEditingSettingsCommand}"
                                ConfirmText="{Binding Shell.I18n[discardChanges]}"
                                ConfirmCommand="{Binding WindowChrome.DiscardSettingsChangesCommand}"
                                IsDangerConfirm="True"/>

        <!-- Critical error dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsErrorDialogVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <!-- Panel 形态 + Danger 状态：徽章语调由伪类重染，诊断动作进左槽。 -->
            <controls:DialogSurface
                Form="Panel"
                Status="Danger"
                Classes="motion-surface"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="{StaticResource Launcher.Spacing.Thickness.Xxl}"
                MaxWidth="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"
                Title="{Binding Shell.I18n[errorDialogTitle]}"
                Subtitle="{Binding Shell.I18n[errorDialogDescription]}"
                CloseCommand="{Binding Dialogs.ContinueAfterErrorCommand}"
                CloseAutomationName="{Binding Shell.I18n[close]}"
                CloseToolTip="{Binding Shell.I18n[close]}">
                <controls:DialogSurface.RenderTransform>
                    <TranslateTransform/>
                </controls:DialogSurface.RenderTransform>
                <controls:DialogSurface.HeaderIcon>
                    <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource Launcher.Icon.Md}" Height="{StaticResource Launcher.Icon.Md}"/>
                </controls:DialogSurface.HeaderIcon>
                <controls:DialogSurface.Content>
                        <Border Classes="dialog-alert danger">
                            <TextBlock Text="{Binding Dialogs.ErrorDialogMessage}" Classes="dialog-alert-content"/>
                        </Border>
                </controls:DialogSurface.Content>
                <controls:DialogSurface.FooterLeading>
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ViewErrorLogCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[errorDialogViewLog]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[errorDialogViewLog]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CopyErrorDetailsCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[errorDialogCopyDetails]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[errorDialogCopyDetails]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:DialogSurface.FooterLeading>
                <controls:DialogSurface.Footer>
                    <StackPanel Classes="confirm-actions">
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ContinueAfterErrorCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[errorDialogContinue]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[errorDialogContinue]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:DialogSurface.Footer>
            </controls:DialogSurface>
        </Grid>

        <views:SetupWizardOverlay/>
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.SetupWizardExitConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[setupWizardExitTitle]}"
                                Message="{Binding Shell.I18n[setupWizardExitMessage]}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.SetupWizardExitConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[setupWizardExitConfirm]}"
                                ConfirmCommand="{Binding Dialogs.SetupWizardExitConfirm.ConfirmCommand}"/>
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.DebugResetConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[debugResetSettingsTitle]}"
                                Message="{Binding Shell.I18n[debugResetSettingsDescription]}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.DebugResetConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[debugResetSettingsConfirm]}"
                                ConfirmCommand="{Binding Dialogs.DebugResetConfirm.ConfirmCommand}"
                                IsDangerConfirm="True"/>
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.SettingsResetConfirm.IsVisible}"
                                Title="{Binding Shell.I18n[debugResetSettingsTitle]}"
                                Message="{Binding Shell.I18n[debugResetSettingsDescription]}"
                                CancelText="{Binding Shell.I18n[cancel]}"
                                CancelCommand="{Binding Dialogs.SettingsResetConfirm.CancelCommand}"
                                ConfirmText="{Binding Shell.I18n[debugResetSettingsConfirm]}"
                                ConfirmCommand="{Binding Dialogs.SettingsResetConfirm.ConfirmCommand}"
                                IsDangerConfirm="True"/>
    </Grid>
</UserControl>
