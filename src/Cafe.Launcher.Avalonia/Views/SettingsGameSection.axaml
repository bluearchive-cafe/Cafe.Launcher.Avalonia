<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Views.SettingsGameSection"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel>
        <StackPanel Classes="settings-group">
            <TextBlock Text="{Binding Shell.I18n[settingsGroupGameFiles]}" Classes="group-title"/>

            <controls:SettingRow ShowTopDivider="False"
                                 Title="{Binding Shell.I18n[gamePath]}"
                                 Description="{Binding Settings.Editor.Current.GamePath}">
                <controls:SettingRow.Action>
                    <Button Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[choose]}"
                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                            <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                        </StackPanel>
                    </Button>
                </controls:SettingRow.Action>
            </controls:SettingRow>

            <controls:SettingSelect Title="{Binding Shell.I18n[launchCheck]}"
                                    Description="{Binding Shell.I18n[launchCheckDescription]}"
                                    AutomationName="{Binding Shell.I18n[launchCheck]}"
                                    ItemsSource="{Binding Settings.Options.LaunchCheckMode}"
                                    SelectedValue="{Binding Settings.Editor.Current.LaunchCheckMode, Mode=TwoWay}"/>

            <controls:SettingRow Title="{Binding Shell.I18n[gameManagement]}"
                                 Description="{Binding Shell.I18n[gameManagementDescription]}">
                <controls:SettingRow.Action>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Launcher.Spacing.Sm}" VerticalAlignment="Center">
                        <Button Classes="flat-action" Command="{Binding Operations.RequestRepairCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[repair]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[repair]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action danger-action" Command="{Binding Operations.RequestUninstallCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n[uninstall]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{StaticResource Launcher.Icon.Sm}" Height="{StaticResource Launcher.Icon.Sm}"/>
                                <TextBlock Text="{Binding Shell.I18n[uninstall]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingRow.Action>
            </controls:SettingRow>
        </StackPanel>

        <StackPanel Classes="settings-group" IsVisible="{Binding Shell.IsLinuxPlatform}">
            <TextBlock Text="{Binding Shell.I18n[settingsGroupGameRuntime]}" Classes="group-title"/>

            <controls:SettingSelect ShowTopDivider="False"
                                    Title="{Binding Shell.I18n[gameRuntimeRunner]}"
                                    Description="{Binding Shell.I18n[gameRuntimeRunnerDescription]}"
                                    AutomationName="{Binding Shell.I18n[gameRuntimeRunner]}"
                                    ItemsSource="{Binding Settings.Options.GameRuntimeRunner}"
                                    SelectedValue="{Binding Settings.Editor.Current.GameRuntime.Runner, Mode=TwoWay}"/>

            <controls:SettingRow Title="{Binding Shell.I18n[gameRuntimeStatusTitle]}"
                                 Description="{Binding Settings.GameRuntimeStatusSummary}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
