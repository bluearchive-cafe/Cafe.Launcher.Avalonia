            <!-- Elevation (阴影 0–3 档；颜色/偏移/模糊 token 化；P2 全面消费) -->
            <!-- 注：BoxShadow 为值类型，只能经转换器加载（AVLN3000），故以 x:String 存储，
                 由 Setter 的 BoxShadow 类型转换器解析（与既有硬编码字符串路径一致）。 -->
            <x:String x:Key="Launcher.Elevation.Shadow.None">0 0 0 0 #00000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Sm">0 4 8 0 #26000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Md">0 12 32 0 #33000000</x:String>
            <x:String x:Key="Launcher.Elevation.Shadow.Lg">0 22 55 0 #66000000</x:String>
            <!-- StateLayer (状态层不透明度 8/12/16/24%；P2 状态矩阵消费) -->
