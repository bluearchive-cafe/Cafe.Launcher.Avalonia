<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cafe.Launcher.Avalonia.App"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Design Tokens — see CLAUDE.md § Design Tokens for usage reference -->
            <x:Double x:Key="Launcher.Spacing.Xs">4</x:Double>
            <x:Double x:Key="Launcher.Spacing.Sm">8</x:Double>
            <x:Double x:Key="Launcher.Spacing.Md">12</x:Double>
            <x:Double x:Key="Launcher.Spacing.Lg">16</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xl">20</x:Double>
            <x:Double x:Key="Launcher.Spacing.Xxl">24</x:Double>
            <x:Double x:Key="Launcher.Spacing.Section">40</x:Double>
            <Thickness x:Key="Launcher.Spacing.Thickness.Xs">4</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Sm">8</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Xl">20</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.None">0</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Md">12</Thickness>
            <Thickness x:Key="Launcher.Spacing.Thickness.Lg">16</Thickness>
            <Thickness x:Key="Launcher.Component.PathField.Padding">16,0,4,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Message.Margin">0,4,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.RowMargin">0,8,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.Primary.Margin">0,0,8,0</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.Progress.Margin">8,0,0,0</Thickness>
            <Thickness x:Key="Launcher.Component.Tabs.Header.Margin">0,0,0,4</Thickness>
            <Thickness x:Key="Launcher.Component.Tabs.Indicator.Margin">0,4,0,2</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Content.Padding">12</Thickness>
            <Thickness x:Key="Launcher.Component.Toast.Action.Padding">12,8</Thickness>
            <CornerRadius x:Key="Launcher.Radius.Sm">4</CornerRadius>
            <CornerRadius x:Key="Launcher.Radius.Md">6</CornerRadius>
            <CornerRadius x:Key="Launcher.Radius.Lg">8</CornerRadius>
            <x:Double x:Key="Launcher.Icon.Sm">16</x:Double>
            <x:Double x:Key="Launcher.Icon.Md">18</x:Double>
            <x:Double x:Key="Launcher.Icon.Lg">20</x:Double>
            <x:Double x:Key="Launcher.Icon.Xl">22</x:Double>
            <x:Double x:Key="Launcher.Icon.Xxl">24</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Setting">36</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Dialog">42</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Bottom">48</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Launch">58</x:Double>
            <x:Double x:Key="Launcher.Control.MinWidth.None">0</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.Action.MinHeight">30</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Width">720</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Height">540</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Log.Path.MaxWidth">300</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.Log.Level.MinWidth">110</x:Double>
            <x:Double x:Key="Launcher.Layout.Debug.SettingsPreview.MaxHeight">160</x:Double>
            <x:Double x:Key="Launcher.Control.Size.Swatch">28</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Chip">32</x:Double>
            <x:Double x:Key="Launcher.Control.Height.Field">40</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Title.Height">56</x:Double>
            <x:Double x:Key="Launcher.Layout.News.Viewport.Height">184</x:Double>
            <x:Double x:Key="Launcher.Component.Dialog.Confirm.MaxHeight">480</x:Double>
            <x:Double x:Key="Launcher.Layout.LogViewer.Width">720</x:Double>
            <x:Double x:Key="Launcher.Layout.LogViewer.Height">592</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Row.Content.MinWidth">240</x:Double>
            <x:Double x:Key="Launcher.Component.Settings.Row.Action.MaxWidth">440</x:Double>
            <x:Double x:Key="Launcher.Component.Loading.Bar.Width">120</x:Double>
            <x:Double x:Key="Launcher.Component.Loading.Bar.Height">4</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.AutoDismiss.Progress.Height">3</x:Double>
            <x:Double x:Key="Launcher.Component.Toast.Width">340</x:Double>
            <x:TimeSpan x:Key="Launcher.Motion.Duration.Faster">0:0:0.050</x:TimeSpan>
            <x:TimeSpan x:Key="Launcher.Motion.Duration.Fast">0:0:0.167</x:TimeSpan>
            <x:TimeSpan x:Key="Launcher.Motion.Duration.Content">0:0:0.200</x:TimeSpan>
            <x:TimeSpan x:Key="Launcher.Motion.Duration.Normal">0:0:0.250</x:TimeSpan>
            <x:Double x:Key="Launcher.Motion.Offset.Toast">6</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Content">6</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Surface">8</x:Double>
            <x:Double x:Key="Launcher.Motion.Offset.Bottom">12</x:Double>
            <ExponentialEaseOut x:Key="Launcher.Motion.Easing.Enter"/>
            <ExponentialEaseIn x:Key="Launcher.Motion.Easing.Exit"/>
            <LinearEasing x:Key="Launcher.Motion.Easing.Linear"/>
            <x:Double x:Key="Launcher.Typography.FontSize.Label.Sm">11</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Label.Md">12</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Sm">13</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Md">14</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Body.Lg">15</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Title.Md">16</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Title.Lg">17</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Headline.Md">18</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Headline.Lg">19</x:Double>
            <x:Double x:Key="Launcher.Typography.FontSize.Display">22</x:Double>
            <FontWeight x:Key="Launcher.Typography.FontWeight.Normal">Normal</FontWeight>
            <FontWeight x:Key="Launcher.Typography.FontWeight.Strong">SemiBold</FontWeight>
            <FontFamily x:Key="Launcher.Typography.FontFamily.Monospace">Consolas</FontFamily>
            <SolidColorBrush x:Key="Launcher.Color.Primary" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Hover" Color="{DynamicResource SystemAccentColorLight1}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Pressed" Color="{DynamicResource SystemAccentColorDark1}"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Soft" Color="{DynamicResource SystemAccentColor}" Opacity="0.10"/>
            <SolidColorBrush x:Key="Launcher.Color.Primary.Border" Color="{DynamicResource SystemAccentColor}" Opacity="0.40"/>
            <SolidColorBrush x:Key="Launcher.Color.OnPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Text.OnChrome" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Text.OnChrome.Muted" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Text.OnDark" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Transparent" Color="#00000000"/>
            <SolidColorBrush x:Key="Launcher.Color.Chrome.Hover" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Chrome.Pressed" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger" Color="#FFE5484D"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger.Hover" Color="#FFF15B60"/>
            <SolidColorBrush x:Key="Launcher.Color.Danger.Pressed" Color="#FFC9353A"/>
            <SolidColorBrush x:Key="Launcher.Color.Overlay.Scrim" Color="#99000000"/>
            <SolidColorBrush x:Key="Launcher.Color.FocusRing" Color="{DynamicResource SystemAccentColor}" Opacity="0.60"/>
            <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Active" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Inactive" Color="#FFD0D4DA"/>
            <SolidColorBrush x:Key="Launcher.Color.Success" Color="#FF22C55E"/>
            <SolidColorBrush x:Key="Launcher.Color.Warning" Color="#FFF59E0B"/>
            <SolidColorBrush x:Key="Launcher.Color.Info" Color="#FF2E7DF6"/>
            <LinearGradientBrush x:Key="Launcher.Color.TitleBar.Gradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#52000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Launcher.Color.Media.Placeholder" Color="#FF2A3A5C"/>
            <SolidColorBrush x:Key="Launcher.Text.Media.Placeholder" Color="#88FFFFFF"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Launcher.Text.Primary" Color="#FF232A31"/>
                    <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="#FF68717D"/>
                    <SolidColorBrush x:Key="Launcher.Text.Body" Color="#FF3F4954"/>
                    <SolidColorBrush x:Key="Launcher.Text.Link" Color="#FF313233"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Background" Color="#EAF6FAFE"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Bottom.Background" Color="#F2F8FBFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Background" Color="#FFFAFCFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Border" Color="#FFD6E2EE"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Header" Color="#FFF4F8FD"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Footer" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Hover" Color="#FFEDF2F7"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Pressed" Color="#FFDDE6F0"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Background" Color="#FFF0F6FD"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Border" Color="#FFB8CADB"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.Background" Color="#FFDCEFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Notice.Background" Color="#FFFFF6D8"/>
                    <SolidColorBrush x:Key="Launcher.Color.Warning.Background" Color="#FFFFF2C2"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.Soft" Color="#FFFFECEE"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row" Color="#FFF1F5F9"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row.Hover" Color="#0A000000"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Border" Color="#FFC8D2DE"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Hover" Color="#FFEEF6FF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Pressed" Color="#FFDCEFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Border" Color="#FFD5E3F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Toast.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Text.Info" Color="#FF24415E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Launcher.Color.Carousel.Dot.Inactive" Color="#FF5A6270"/>
                    <SolidColorBrush x:Key="Launcher.Text.Primary" Color="#FFE8EEF6"/>
                    <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="#FFA8B3C2"/>
                    <SolidColorBrush x:Key="Launcher.Text.Body" Color="#FFC8D2DF"/>
                    <SolidColorBrush x:Key="Launcher.Text.Link" Color="#FFDDE7F3"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Background" Color="#E819202A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Panel.Bottom.Background" Color="#F219202A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Background" Color="#FF202733"/>
                    <SolidColorBrush x:Key="Launcher.Color.Card.Border" Color="#FF344150"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Background" Color="#FF161C26"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Header" Color="#FF1B2430"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Footer" Color="#FF161C26"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Hover" Color="#FF2A3547"/>
                    <SolidColorBrush x:Key="Launcher.Color.Dialog.Close.Pressed" Color="#FF344156"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Background" Color="#FF1E2834"/>
                    <SolidColorBrush x:Key="Launcher.Color.Field.Border" Color="#FF40516A"/>
                    <SolidColorBrush x:Key="Launcher.Color.Info.Background" Color="#FF19324D"/>
                    <SolidColorBrush x:Key="Launcher.Color.Notice.Background" Color="#FF352D17"/>
                    <SolidColorBrush x:Key="Launcher.Color.Warning.Background" Color="#FF463817"/>
                    <SolidColorBrush x:Key="Launcher.Color.Danger.Soft" Color="#FF3A1D22"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row" Color="#FF202833"/>
                    <SolidColorBrush x:Key="Launcher.Color.Content.Row.Hover" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Border" Color="#FF4A5B73"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Hover" Color="#FF243653"/>
                    <SolidColorBrush x:Key="Launcher.Color.Button.Flat.Pressed" Color="#FF1D426C"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Background" Color="#FF192232"/>
                    <SolidColorBrush x:Key="Launcher.Color.SiteButton.Border" Color="#FF3D5B80"/>
                    <SolidColorBrush x:Key="Launcher.Color.Toast.Background" Color="#FF1C2533"/>
                    <SolidColorBrush x:Key="Launcher.Text.Info" Color="#FFD6E8FF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Cafe.Launcher.Avalonia/Views/MainWindow.Styles.axaml"/>
    </Application.Styles>
</Application>
