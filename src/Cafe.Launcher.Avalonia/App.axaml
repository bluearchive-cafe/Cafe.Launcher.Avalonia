<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cafe.Launcher.Avalonia.App"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Design Tokens — see CLAUDE.md § Design Tokens for usage reference -->
            <x:Double x:Key="LauncherSpacingXs">4</x:Double>
            <x:Double x:Key="LauncherSpacingSm">8</x:Double>
            <x:Double x:Key="LauncherSpacingMd">12</x:Double>
            <x:Double x:Key="LauncherSpacingLg">16</x:Double>
            <x:Double x:Key="LauncherSpacingXl">20</x:Double>
            <x:Double x:Key="LauncherSpacingXxl">24</x:Double>
            <x:Double x:Key="LauncherSpacingSection">40</x:Double>
            <Thickness x:Key="LauncherSpacingXsThickness">4</Thickness>
            <Thickness x:Key="LauncherSpacingSmThickness">8</Thickness>
            <Thickness x:Key="LauncherSpacingXlThickness">20</Thickness>
            <Thickness x:Key="LauncherThicknessNone">0</Thickness>
            <Thickness x:Key="LauncherThicknessSm">8</Thickness>
            <Thickness x:Key="LauncherThicknessMd">12</Thickness>
            <Thickness x:Key="LauncherThicknessLg">16</Thickness>
            <Thickness x:Key="LauncherPathFieldPadding">16,0,4,0</Thickness>
            <Thickness x:Key="LauncherToastMessageMargin">0,4,0,0</Thickness>
            <Thickness x:Key="LauncherToastActionRowMargin">0,8,0,0</Thickness>
            <Thickness x:Key="LauncherToastPrimaryActionMargin">0,0,8,0</Thickness>
            <Thickness x:Key="LauncherToastActionProgressMargin">8,0,0,0</Thickness>
            <Thickness x:Key="LauncherTabHeaderMargin">0,0,0,4</Thickness>
            <Thickness x:Key="LauncherTabIndicatorMargin">0,4,0,2</Thickness>
            <Thickness x:Key="LauncherToastContentPadding">12</Thickness>
            <Thickness x:Key="LauncherToastActionPadding">12,8</Thickness>
            <CornerRadius x:Key="LauncherRadiusSm">4</CornerRadius>
            <CornerRadius x:Key="LauncherRadiusMd">6</CornerRadius>
            <CornerRadius x:Key="LauncherRadiusLg">8</CornerRadius>
            <x:Double x:Key="LauncherIconSm">16</x:Double>
            <x:Double x:Key="LauncherIconMd">18</x:Double>
            <x:Double x:Key="LauncherIconLg">20</x:Double>
            <x:Double x:Key="LauncherIconXl">22</x:Double>
            <x:Double x:Key="LauncherIconXxl">24</x:Double>
            <x:Double x:Key="LauncherControlHeightSetting">36</x:Double>
            <x:Double x:Key="LauncherControlHeightDialog">42</x:Double>
            <x:Double x:Key="LauncherControlHeightBottom">48</x:Double>
            <x:Double x:Key="LauncherControlHeightLaunch">58</x:Double>
            <x:Double x:Key="LauncherControlMinWidthNone">0</x:Double>
            <x:Double x:Key="LauncherToastActionMinHeight">30</x:Double>
            <x:Double x:Key="LauncherDebugDialogWidth">720</x:Double>
            <x:Double x:Key="LauncherDebugDialogHeight">540</x:Double>
            <x:Double x:Key="LauncherDebugLogPathMaxWidth">300</x:Double>
            <x:Double x:Key="LauncherDebugLogLevelMinWidth">110</x:Double>
            <x:Double x:Key="LauncherDebugSettingsPreviewMaxHeight">160</x:Double>
            <x:Double x:Key="LauncherSwatchSize">28</x:Double>
            <x:Double x:Key="LauncherChipHeight">32</x:Double>
            <x:Double x:Key="LauncherFieldHeight">40</x:Double>
            <x:Double x:Key="LauncherDialogTitleHeight">56</x:Double>
            <x:Double x:Key="LauncherNewsViewportHeight">184</x:Double>
            <x:Double x:Key="LauncherConfirmDialogMaxHeight">480</x:Double>
            <x:Double x:Key="LauncherLogViewerWidth">720</x:Double>
            <x:Double x:Key="LauncherLogViewerHeight">592</x:Double>
            <x:Double x:Key="LauncherSettingRowContentMinWidth">240</x:Double>
            <x:Double x:Key="LauncherSettingRowActionMaxWidth">440</x:Double>
            <x:Double x:Key="LauncherLoadingBarWidth">120</x:Double>
            <x:Double x:Key="LauncherLoadingBarHeight">4</x:Double>
            <x:Double x:Key="LauncherToastAutoDismissProgressHeight">3</x:Double>
            <x:Double x:Key="LauncherToastWidth">340</x:Double>
            <x:TimeSpan x:Key="LauncherMotionFasterDuration">0:0:0.050</x:TimeSpan>
            <x:TimeSpan x:Key="LauncherMotionFastDuration">0:0:0.167</x:TimeSpan>
            <x:TimeSpan x:Key="LauncherMotionContentDuration">0:0:0.200</x:TimeSpan>
            <x:TimeSpan x:Key="LauncherMotionNormalDuration">0:0:0.250</x:TimeSpan>
            <x:Double x:Key="LauncherMotionToastOffset">6</x:Double>
            <x:Double x:Key="LauncherMotionContentOffset">6</x:Double>
            <x:Double x:Key="LauncherMotionSurfaceOffset">8</x:Double>
            <x:Double x:Key="LauncherMotionBottomOffset">12</x:Double>
            <ExponentialEaseOut x:Key="LauncherMotionEnterEasing"/>
            <ExponentialEaseIn x:Key="LauncherMotionExitEasing"/>
            <LinearEasing x:Key="LauncherMotionLinearEasing"/>
            <x:Double x:Key="LauncherFontSizeXs">11</x:Double>
            <x:Double x:Key="LauncherFontSizeSm">12</x:Double>
            <x:Double x:Key="LauncherFontSizeMd">13</x:Double>
            <x:Double x:Key="LauncherFontSizeLg">14</x:Double>
            <x:Double x:Key="LauncherFontSizeXl">15</x:Double>
            <x:Double x:Key="LauncherFontSizeXxl">16</x:Double>
            <x:Double x:Key="LauncherFontSizeHeadingSm">17</x:Double>
            <x:Double x:Key="LauncherFontSizeHeadingMd">18</x:Double>
            <x:Double x:Key="LauncherFontSizeHeadingLg">19</x:Double>
            <x:Double x:Key="LauncherFontSizeDisplay">22</x:Double>
            <FontWeight x:Key="LauncherFontWeightNormal">Normal</FontWeight>
            <FontWeight x:Key="LauncherFontWeightStrong">SemiBold</FontWeight>
            <FontFamily x:Key="LauncherFontFamilyMonospace">Consolas</FontFamily>
            <SolidColorBrush x:Key="LauncherAccentBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="LauncherAccentHoverBrush" Color="{DynamicResource SystemAccentColorLight1}"/>
            <SolidColorBrush x:Key="LauncherAccentPressedBrush" Color="{DynamicResource SystemAccentColorDark1}"/>
            <SolidColorBrush x:Key="LauncherAccentSoftBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.10"/>
            <SolidColorBrush x:Key="LauncherAccentBorderBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.40"/>
            <SolidColorBrush x:Key="LauncherOnAccentBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LauncherOnChromeBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LauncherOnChromeMutedBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="LauncherOnDarkMutedBrush" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="LauncherTransparentBrush" Color="#00000000"/>
            <SolidColorBrush x:Key="LauncherChromeHoverBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="LauncherChromePressedBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="LauncherDangerBrush" Color="#FFE5484D"/>
            <SolidColorBrush x:Key="LauncherDangerHoverBrush" Color="#FFF15B60"/>
            <SolidColorBrush x:Key="LauncherDangerPressedBrush" Color="#FFC9353A"/>
            <SolidColorBrush x:Key="LauncherOverlayBrush" Color="#99000000"/>
            <SolidColorBrush x:Key="LauncherFocusRingBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.60"/>
            <SolidColorBrush x:Key="LauncherCarouselDotActiveBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="LauncherCarouselDotInactiveBrush" Color="#FFD0D4DA"/>
            <SolidColorBrush x:Key="LauncherToastSuccessBrush" Color="#FF22C55E"/>
            <SolidColorBrush x:Key="LauncherToastWarningBrush" Color="#FFF59E0B"/>
            <SolidColorBrush x:Key="LauncherToastErrorBrush" Color="#FFE5484D"/>
            <SolidColorBrush x:Key="LauncherToastInfoBrush" Color="#FF2E7DF6"/>
            <SolidColorBrush x:Key="LauncherSuccessBrush" Color="#FF22C55E"/>
            <LinearGradientBrush x:Key="LauncherTitleBarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#52000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="LauncherMediaPlaceholderBrush" Color="#FF2A3A5C"/>
            <SolidColorBrush x:Key="LauncherMediaPlaceholderTextBrush" Color="#88FFFFFF"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FF232A31"/>
                    <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#FF68717D"/>
                    <SolidColorBrush x:Key="LauncherTextBodyBrush" Color="#FF3F4954"/>
                    <SolidColorBrush x:Key="LauncherTextLinkBrush" Color="#FF313233"/>
                    <SolidColorBrush x:Key="LauncherPanelBackgroundBrush" Color="#EAF6FAFE"/>
                    <SolidColorBrush x:Key="LauncherBottomPanelBackgroundBrush" Color="#F2F8FBFF"/>
                    <SolidColorBrush x:Key="LauncherCardBackgroundBrush" Color="#FFFAFCFF"/>
                    <SolidColorBrush x:Key="LauncherCardBorderBrush" Color="#FFD6E2EE"/>
                    <SolidColorBrush x:Key="LauncherDialogBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="LauncherDialogHeaderBrush" Color="#FFF4F8FD"/>
                    <SolidColorBrush x:Key="LauncherDialogFooterBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="LauncherDialogCloseHoverBrush" Color="#FFEDF2F7"/>
                    <SolidColorBrush x:Key="LauncherDialogClosePressedBrush" Color="#FFDDE6F0"/>
                    <SolidColorBrush x:Key="LauncherFieldBackgroundBrush" Color="#FFF0F6FD"/>
                    <SolidColorBrush x:Key="LauncherFieldBorderBrush" Color="#FFB8CADB"/>
                    <SolidColorBrush x:Key="LauncherInfoBackgroundBrush" Color="#FFDCEFFF"/>
                    <SolidColorBrush x:Key="LauncherNoticeBackgroundBrush" Color="#FFFFF6D8"/>
                    <SolidColorBrush x:Key="LauncherWarningBackgroundBrush" Color="#FFFFF2C2"/>
                    <SolidColorBrush x:Key="LauncherDangerSoftBrush" Color="#FFFFECEE"/>
                    <SolidColorBrush x:Key="LauncherContentRowBrush" Color="#FFF1F5F9"/>
                    <SolidColorBrush x:Key="LauncherContentRowHoverBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="LauncherButtonBorderBrush" Color="#FFC8D2DE"/>
                    <SolidColorBrush x:Key="LauncherFlatHoverBrush" Color="#FFEEF6FF"/>
                    <SolidColorBrush x:Key="LauncherFlatPressedBrush" Color="#FFDCEFFF"/>
                    <SolidColorBrush x:Key="LauncherSiteButtonBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="LauncherSiteButtonBorderBrush" Color="#FFD5E3F3"/>
                    <SolidColorBrush x:Key="LauncherToastBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="LauncherInfoTextBrush" Color="#FF24415E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LauncherCarouselDotInactiveBrush" Color="#FF5A6270"/>
                    <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FFE8EEF6"/>
                    <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#FFA8B3C2"/>
                    <SolidColorBrush x:Key="LauncherTextBodyBrush" Color="#FFC8D2DF"/>
                    <SolidColorBrush x:Key="LauncherTextLinkBrush" Color="#FFDDE7F3"/>
                    <SolidColorBrush x:Key="LauncherPanelBackgroundBrush" Color="#E819202A"/>
                    <SolidColorBrush x:Key="LauncherBottomPanelBackgroundBrush" Color="#F219202A"/>
                    <SolidColorBrush x:Key="LauncherCardBackgroundBrush" Color="#FF202733"/>
                    <SolidColorBrush x:Key="LauncherCardBorderBrush" Color="#FF344150"/>
                    <SolidColorBrush x:Key="LauncherDialogBackgroundBrush" Color="#FF161C26"/>
                    <SolidColorBrush x:Key="LauncherDialogHeaderBrush" Color="#FF1B2430"/>
                    <SolidColorBrush x:Key="LauncherDialogFooterBrush" Color="#FF161C26"/>
                    <SolidColorBrush x:Key="LauncherDialogCloseHoverBrush" Color="#FF2A3547"/>
                    <SolidColorBrush x:Key="LauncherDialogClosePressedBrush" Color="#FF344156"/>
                    <SolidColorBrush x:Key="LauncherFieldBackgroundBrush" Color="#FF1E2834"/>
                    <SolidColorBrush x:Key="LauncherFieldBorderBrush" Color="#FF40516A"/>
                    <SolidColorBrush x:Key="LauncherInfoBackgroundBrush" Color="#FF19324D"/>
                    <SolidColorBrush x:Key="LauncherNoticeBackgroundBrush" Color="#FF352D17"/>
                    <SolidColorBrush x:Key="LauncherWarningBackgroundBrush" Color="#FF463817"/>
                    <SolidColorBrush x:Key="LauncherDangerSoftBrush" Color="#FF3A1D22"/>
                    <SolidColorBrush x:Key="LauncherContentRowBrush" Color="#FF202833"/>
                    <SolidColorBrush x:Key="LauncherContentRowHoverBrush" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="LauncherButtonBorderBrush" Color="#FF4A5B73"/>
                    <SolidColorBrush x:Key="LauncherFlatHoverBrush" Color="#FF243653"/>
                    <SolidColorBrush x:Key="LauncherFlatPressedBrush" Color="#FF1D426C"/>
                    <SolidColorBrush x:Key="LauncherSiteButtonBackgroundBrush" Color="#FF192232"/>
                    <SolidColorBrush x:Key="LauncherSiteButtonBorderBrush" Color="#FF3D5B80"/>
                    <SolidColorBrush x:Key="LauncherToastBackgroundBrush" Color="#FF1C2533"/>
                    <SolidColorBrush x:Key="LauncherInfoTextBrush" Color="#FFD6E8FF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Cafe.Launcher.Avalonia/Views/MainWindow.Styles.axaml"/>
    </Application.Styles>
</Application>
