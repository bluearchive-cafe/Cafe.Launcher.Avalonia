<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Controls.ConfirmDialog"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <!-- M3 basic 对话框的标准门面：标题 + 支撑文案（Description） +
         滚动正文（Message，可为空）+ 无装饰动作带。解剖由 DialogSurface 承载，
         此处只做类型化归约；安全钮默认聚焦的规律由代码后置执行。
         遮罩显隐走统一的 MotionVisibility 通道（ADR-015）。 -->
    <Grid Classes="dialog-overlay motion-overlay"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding IsOpen, ElementName=Root}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <controls:DialogSurface
            Form="Basic"
            Classes="motion-surface"
            MaxWidth="{StaticResource Launcher.Component.Dialog.Confirm.MaxWidth}"
            MinWidth="{StaticResource Launcher.Component.Dialog.Confirm.MinWidth}"
            MaxHeight="{StaticResource Launcher.Component.Dialog.Confirm.MaxHeight}"
            Title="{Binding Title, ElementName=Root}"
            Subtitle="{Binding Description, ElementName=Root}">
            <controls:DialogSurface.RenderTransform>
                <TranslateTransform/>
            </controls:DialogSurface.RenderTransform>
            <controls:DialogSurface.Content>
                <TextBlock Text="{Binding Message, ElementName=Root}"
                           Classes="dialog-message"
                           TextWrapping="Wrap"/>
            </controls:DialogSurface.Content>
            <controls:DialogSurface.Footer>
                <StackPanel Classes="confirm-actions">
                    <Button x:Name="SafeActionButton"
                            Classes="flat-action dialog-action confirm-dialog-action"
                            Command="{Binding CancelCommand, ElementName=Root}"
                            ToolTip.Tip="{Binding CancelText, ElementName=Root}"
                            AutomationProperties.Name="{Binding CancelText, ElementName=Root}">
                        <TextBlock Text="{Binding CancelText, ElementName=Root}"/>
                    </Button>
                    <Button Classes="primary-action dialog-action confirm-dialog-action"
                            Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding !IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                    </Button>
                    <Button Classes="danger-action dialog-action confirm-dialog-action"
                            Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                    </Button>
                </StackPanel>
            </controls:DialogSurface.Footer>
        </controls:DialogSurface>
    </Grid>
</UserControl>
