<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Controls.ConfirmDialog"
             x:Name="Root"
             x:DataType="controls:ConfirmDialog">
    <Grid IsVisible="{Binding IsOpen, ElementName=Root}" Classes="dialog-overlay">
        <Border Classes="dialog confirm-panel" MaxWidth="{Binding DialogMaxWidth, ElementName=Root}"
                MaxHeight="{StaticResource Launcher.Component.Dialog.Confirm.MaxHeight}">
            <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                <TextBlock Text="{Binding Title, ElementName=Root}" Classes="dialog-title"/>
                <ScrollViewer Grid.Row="1" Classes="scroll-pad"
                              IsVisible="{Binding DisplayMessage, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding DisplayMessage, ElementName=Root}"
                               Classes="dialog-message"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Classes="confirm-actions">
                    <Button x:Name="SafeActionButton" Classes="flat-action dialog-action confirm-dialog-action" Command="{Binding CancelCommand, ElementName=Root}"
                            ToolTip.Tip="{Binding CancelText, ElementName=Root}"
                            AutomationProperties.Name="{Binding CancelText, ElementName=Root}">
                        <TextBlock Text="{Binding CancelText, ElementName=Root}"/>
                    </Button>
                    <Button Classes="primary-action dialog-action confirm-dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding !IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                    </Button>
                    <Button Classes="danger-action dialog-action confirm-dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
