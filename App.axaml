<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cafe.Launcher.Avalonia.App"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
    <!-- Composition root only: token ownership is intentionally outside App.axaml. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Cafe.Launcher.Avalonia/Views/Styles/Foundation.axaml"/>
                <ResourceInclude Source="avares://Cafe.Launcher.Avalonia/Views/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Cafe.Launcher.Avalonia/Views/Styles/Controls.axaml"/>
        <StyleInclude Source="avares://Cafe.Launcher.Avalonia/Views/MainWindow.Styles.axaml"/>
    </Application.Styles>
</Application>
