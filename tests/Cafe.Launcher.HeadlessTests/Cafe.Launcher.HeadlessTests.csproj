<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher.HeadlessTests</AssemblyName>
    <RootNamespace>Cafe.Launcher.HeadlessTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!--
      When the CI release build adds a RID (-r win-x64), referencing the self-contained main
      app trips NETSDK1151 (non-self-contained exe references self-contained exe). The test
      host only needs the app's managed assemblies, not its bundled runtime, so allow the
      mismatch.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <!--
      Avalonia.Headless.XUnit 12.1.4 uses the xUnit 3.2.2 extensibility API.
      Keep the verified xunit.v3 3.2.2 combination until its compatibility with
      xUnit 4's breaking extensibility changes is validated; the nuspec's
      minimum version alone does not establish runtime compatibility.
      The explicit mtp-v2 package selects MTP 2 independently of that xUnit
      framework version. See PROJECT_CONVENTIONS.md §12 for the two boundaries.
    -->
    <PackageReference Include="xunit.v3.mtp-v2" VersionOverride="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cafe.Launcher\Cafe.Launcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestUserDataIsolation.cs" Link="TestUserDataIsolation.cs" />
    <Compile Include="..\TestAnimationSetup.cs" Link="TestAnimationSetup.cs" />
    <Compile Include="..\Support\TestDirectory.cs" Link="Support\TestDirectory.cs" />
    <Compile Include="..\Support\TestRepository.cs" Link="Support\TestRepository.cs" />
    <Compile Include="..\Support\TestWait.cs" Link="Support\TestWait.cs" />
    <Compile Include="..\TestDoubles\StubFileDownloadService.cs" Link="TestDoubles\StubFileDownloadService.cs" />
    <Compile Include="..\TestDoubles\FakeGameSessionMonitor.cs" Link="TestDoubles\FakeGameSessionMonitor.cs" />
    <Compile Include="..\TestDoubles\StubGameOperationExecutor.cs" Link="TestDoubles\StubGameOperationExecutor.cs" />
    <Compile Include="..\TestDoubles\StubRemoteHttpTransport.cs" Link="TestDoubles\StubRemoteHttpTransport.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
