<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher.Avalonia.Tests</AssemblyName>
    <RootNamespace>Cafe.Launcher.Avalonia.Tests</RootNamespace>
    <!--
      xUnit v3 requires OutputType=Exe, but the Windows app host cannot
      be created when cross-compiling on Linux with -r win-x64. Keep the
      default (Library) during RID-specific builds so the VSTest adapter
      loads tests in-process; use Exe on native builds for v3 compliance.
    -->
    <OutputType Condition="'$(RuntimeIdentifier)' == ''">Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      xunit.v3 4.x defaults to Microsoft Testing Platform v2. Keep the VSTest
      adapter path because the repository scripts use its filtering, TRX, hang
      detection, and Coverlet MSBuild contracts.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!--
      xUnit1051 要求所有带可选 CancellationToken 的调用（含全部文件 IO）显式传
      TestContext.Current.CancellationToken，全项目约 1100+ 处，故按项目整体抑制。
      悬挂防护不由该规则承担，而是两层（AUD-TEST-014）：
      ①等待被测代码产出的任务时显式给上限——被测 VM 暴露的 Pending* 系列统一写
        .WaitAsync(TimeSpan.FromSeconds(5))，由 TestSourceWaitContractTests 扫描钉住
        （替身与事件处理体里的故意阻塞点不在该扫描范围内：那里长阻塞是场景本身）；
      ②整类净网在 test.ps1 的挂起检测（blame-hang，5 分钟无活动即中止 testhost 并失败），
        覆盖扫描不到的一次性任务局部变量与未来新增站点。
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cafe.Launcher.Avalonia\Cafe.Launcher.Avalonia.csproj" />
  </ItemGroup>

  <!--
    The update helper's pure logic (argument parsing, path planning, integrity) is
    compiled into this test assembly instead of referencing the helper executable
    project, so the contract between the main app's argument builder and the helper's
    parser can be tested without pulling the helper build into the test graph.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Cafe.Launcher.Updater\UpdateApplyMode.cs" Link="Updater\UpdateApplyMode.cs" />
    <Compile Include="..\..\src\Cafe.Launcher.Updater\UpdateApplyPlan.cs" Link="Updater\UpdateApplyPlan.cs" />
    <Compile Include="..\..\src\Cafe.Launcher.Updater\PackageIntegrity.cs" Link="Updater\PackageIntegrity.cs" />
    <Compile Include="..\..\src\Cafe.Launcher.Updater\UpdaterArguments.cs" Link="Updater\UpdaterArguments.cs" />
    <Compile Include="..\..\src\Cafe.Launcher.Updater\UpdateLog.cs" Link="Updater\UpdateLog.cs" />
    <Compile Include="..\..\src\Cafe.Launcher.Updater\UpdateApplier.cs" Link="Updater\UpdateApplier.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestUserDataIsolation.cs" Link="TestUserDataIsolation.cs" />
    <Compile Include="..\TestAnimationSetup.cs" Link="TestAnimationSetup.cs" />
    <Compile Include="..\Support\TestDirectory.cs" Link="Support\TestDirectory.cs" />
    <Compile Include="..\Support\TestRepository.cs" Link="Support\TestRepository.cs" />
    <Compile Include="..\Support\TestWait.cs" Link="Support\TestWait.cs" />
    <Compile Include="..\TestDoubles\CallbackRecorder.cs" Link="TestDoubles\CallbackRecorder.cs" />
    <Compile Include="..\TestDoubles\StubFatalCrashService.cs" Link="TestDoubles\StubFatalCrashService.cs" />
    <Compile Include="..\TestDoubles\FakeGameSessionMonitor.cs" Link="TestDoubles\FakeGameSessionMonitor.cs" />
    <Compile Include="..\TestDoubles\StubFileDownloadService.cs" Link="TestDoubles\StubFileDownloadService.cs" />
    <Compile Include="..\TestDoubles\StubFilePickerService.cs" Link="TestDoubles\StubFilePickerService.cs" />
    <Compile Include="..\TestDoubles\TestGameProcessTracker.cs" Link="TestDoubles\TestGameProcessTracker.cs" />
    <Compile Include="..\TestDoubles\ScriptedReadStream.cs" Link="TestDoubles\ScriptedReadStream.cs" />
    <Compile Include="..\TestDoubles\BestHttpCookieLibraryFixture.cs" Link="TestDoubles\BestHttpCookieLibraryFixture.cs" />
    <Compile Include="..\TestDoubles\StubGameOperationExecutor.cs" Link="TestDoubles\StubGameOperationExecutor.cs" />
    <Compile Include="..\TestDoubles\StubRemoteHttpTransport.cs" Link="TestDoubles\StubRemoteHttpTransport.cs" />
