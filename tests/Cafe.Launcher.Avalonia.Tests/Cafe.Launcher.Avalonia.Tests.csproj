<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cafe.Launcher.Avalonia.Tests</AssemblyName>
    <RootNamespace>Cafe.Launcher.Avalonia.Tests</RootNamespace>
    <!--
      xUnit v3 requires OutputType=Exe, but the Windows app host cannot
      be created when cross-compiling on Linux with -r win-x64. Keep the
      default (Library) during RID-specific builds so the VSTest adapter
      loads tests in-process; use Exe on native builds for v3 compliance.
    -->
    <OutputType Condition="'$(RuntimeIdentifier)' == ''">Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cafe.Launcher.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestUserDataIsolation.cs" Link="TestUserDataIsolation.cs" />
  </ItemGroup>

</Project>
