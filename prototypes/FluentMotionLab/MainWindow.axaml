<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FluentMotionLab.MainWindow"
        x:Name="Root"
        Title="Fluent Motion Lab — PROTOTYPE"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        Background="#0B111B"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Lab.Surface">#111A29</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.SurfaceRaised">#182337</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.SurfaceSoft">#22314A</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Border">#33445F</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Text">#F4F7FB</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.TextMuted">#AEBBD0</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Accent">#78A9FF</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.AccentSoft">#253D63</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Success">#69D39B</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Warning">#F2C66D</SolidColorBrush>
        <SolidColorBrush x:Key="Lab.Danger">#FF8C91</SolidColorBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Lab.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource Lab.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Lab.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Lab.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Lab.Text}"/>
            <Setter Property="Background" Value="{StaticResource Lab.SurfaceSoft}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#304463"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Lab.Accent}"/>
            <Setter Property="Foreground" Value="#071323"/>
        </Style>
        <Style Selector="Button.scene-nav">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Button.scene-nav.active">
            <Setter Property="Background" Value="{StaticResource Lab.AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Lab.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Lab.Accent}"/>
            <Setter Property="Background" Value="#2A3850"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#101827" BorderBrush="{StaticResource Lab.Border}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="Fluent Motion Lab"/>
                    <TextBlock Classes="muted" Text="PROTOTYPE · Compare current behavior, proposed Fluent motion, and reduced motion."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Replay" Classes="primary" Click="OnReplayClick"/>
                    <Button Content="Rapid fire" Click="OnRapidFireClick"/>
                    <Button Content="Reset" Click="OnResetClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,88" ColumnDefinitions="220,*,292" ColumnSpacing="18">
            <Border Classes="card" Padding="12">
                <StackPanel>
                    <TextBlock Classes="muted" Text="SCENES" Margin="10,6,10,12" FontSize="11" FontWeight="SemiBold"/>
                    <Button Classes="scene-nav active" Tag="shell" Content="01  Shell entrance" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="modal" Content="02  Modal surface" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="settings" Content="03  Settings content" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="wizard" Content="04  Wizard direction" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="carousel" Content="05  Banner carousel" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="operation" Content="06  Operation surface" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="toast" Content="07  Toast stack" Click="OnSceneClick"/>
                    <Button Classes="scene-nav" Tag="appearance" Content="08  Appearance preview" Click="OnSceneClick"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ShellScene" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Shell entrance"/>
                            <TextBlock Classes="muted" Text="The shell is usable immediately; only the internal content receives one entrance treatment."/>
                        </StackPanel>
                        <Border x:Name="ShellPreview" Grid.Row="1" CornerRadius="12" BorderBrush="{StaticResource Lab.Border}" BorderThickness="1" Background="#0D1625" ClipToBounds="True">
                            <Grid RowDefinitions="44,*,96">
                                <Border Background="#121F32" Padding="16,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Cafe Launcher" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <TextBlock Text="—"/>
                                            <TextBlock Text="□"/>
                                            <TextBlock Text="×"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="18" ColumnDefinitions="1.3*,*" ColumnSpacing="16">
                                    <Border CornerRadius="10" Background="#243A5A">
                                        <Grid>
                                            <TextBlock Text="Featured update" FontSize="22" FontWeight="SemiBold" Margin="20" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <Border Background="#172439" CornerRadius="10" Height="64"/>
                                        <Border Background="#172439" CornerRadius="10" Height="64"/>
                                        <Border Background="#172439" CornerRadius="10" Height="64"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2" Background="#142238" Padding="18,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ready to play" FontWeight="SemiBold"/>
                                            <TextBlock Classes="muted" Text="Version 1.0.1 · Files verified"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Launch" MinWidth="132"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ModalScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Modal surface"/>
                            <TextBlock Classes="muted" Text="Compare nested legacy movement with a single Fluent surface transition and reduced fade."/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#0F1928" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock Text="Underlying task remains visible"/>
                                    <Button Content="Open confirmation" Classes="primary" Tag="modal:toggle" Click="OnActionClick"/>
                                </StackPanel>
                                <Grid x:Name="ModalDemoOverlay" IsVisible="False" Background="#B3000000">
                                    <Border x:Name="ModalDemoSurface" Width="430" CornerRadius="18" Background="#1B2940" BorderBrush="#405777" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel x:Name="ModalDemoContent" Spacing="18">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Install this update?" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Classes="muted" Text="The launcher will download 1.8 GB and verify the installation." TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button Content="Cancel" Tag="modal:toggle" Click="OnActionClick"/>
                                                <Button Content="Install" Classes="primary" Tag="modal:toggle" Click="OnActionClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Settings content"/>
                            <TextBlock Classes="muted" Text="Peer destinations should not imply forward or backward spatial order."/>
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <Button Content="General" Tag="settings:0" Click="OnActionClick"/>
                                <Button Content="Game" Tag="settings:1" Click="OnActionClick"/>
                                <Button Content="Appearance" Tag="settings:2" Click="OnActionClick"/>
                                <Button Content="Advanced" Tag="settings:3" Click="OnActionClick"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#121E30" CornerRadius="12" Padding="24">
                                <StackPanel x:Name="SettingsContent" Spacing="14">
                                    <TextBlock x:Name="SettingsTitle" Text="General" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SettingsDescription" Classes="muted" Text="Language, startup, and motion preferences."/>
                                    <Border Height="54" CornerRadius="8" Background="#1B2A41"/>
                                    <Border Height="54" CornerRadius="8" Background="#1B2A41"/>
                                    <Border Height="54" CornerRadius="8" Background="#1B2A41"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="WizardScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Wizard direction"/>
                            <TextBlock Classes="muted" Text="Forward and backward actions preserve direction; completion stays in the same surface."/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#121E30" CornerRadius="14" Padding="24">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                                <TextBlock x:Name="WizardStepLabel" Classes="muted" Text="STEP 1 OF 4"/>
                                <StackPanel x:Name="WizardContent" Grid.Row="1" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="WizardTitle" Text="Choose language" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WizardDescription" Classes="muted" Text="Select the language used by the launcher." HorizontalAlignment="Center"/>
                                    <Border Width="280" Height="48" CornerRadius="8" Background="#20324E" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Button Content="Previous" Tag="wizard:previous" Click="OnActionClick"/>
                                    <Button Grid.Column="1" Content="Restart" Tag="wizard:restart" Click="OnActionClick"/>
                                    <Button Grid.Column="2" Content="Next" Classes="primary" Tag="wizard:next" Click="OnActionClick"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="CarouselScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Banner carousel"/>
                            <TextBlock Classes="muted" Text="Manual navigation has direction; automatic changes fade and stop entirely in Reduced."/>
                        </StackPanel>
                        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="14">
                            <Border x:Name="CarouselVisual" CornerRadius="14" Background="#24456A" ClipToBounds="True">
                                <Grid>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#405F92" Offset="0"/>
                                                <GradientStop Color="#17273E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Margin="28" VerticalAlignment="Bottom" Spacing="6">
                                        <TextBlock x:Name="CarouselKicker" Text="NEWS 01" Classes="muted"/>
                                        <TextBlock x:Name="CarouselTitle" Text="A new journey begins" FontSize="26" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CarouselDescription" Text="Explore the latest launcher update."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Button Content="Previous" Tag="carousel:previous" Click="OnActionClick"/>
                                <Button Content="Automatic tick" Tag="carousel:auto" Click="OnActionClick"/>
                                <Button Content="Next" Classes="primary" Tag="carousel:next" Click="OnActionClick"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="OperationScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Game operation surface"/>
                            <TextBlock Classes="muted" Text="One bottom-anchored task surface changes state instead of swapping independent panels."/>
                        </StackPanel>
                        <Grid Grid.Row="1" RowDefinitions="*,Auto">
                            <Border Background="#0F1928" CornerRadius="12"/>
                            <Border x:Name="OperationPanel" Grid.Row="1" Height="148" Background="#17283F" BorderBrush="#385273" BorderThickness="1,1,1,0" CornerRadius="14,14,0,0" Padding="20" VerticalAlignment="Bottom">
                                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="OperationTitle" Text="Ready to install" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OperationBadge" Grid.Column="1" Text="INSTALL" Foreground="{StaticResource Lab.Accent}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <TextBlock x:Name="OperationDescription" Grid.Row="1" Classes="muted" Text="12.4 GB · Version 2.6"/>
                                    <ProgressBar x:Name="OperationProgress" Grid.Row="2" Value="0" IsVisible="False" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ToastScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Toast stack"/>
                            <TextBlock Classes="muted" Text="New messages enter from their right-edge origin while existing messages make room as one stack."/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#0F1928" CornerRadius="12" Padding="20">
                            <Grid RowDefinitions="Auto,*" RowSpacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Add success" Classes="primary" Tag="toast:add" Click="OnActionClick"/>
                                    <Button Content="Dismiss oldest" Tag="toast:dismiss" Click="OnActionClick"/>
                                </StackPanel>
                                <StackPanel x:Name="ToastHost" Grid.Row="1" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="AppearanceScene" IsVisible="False" Margin="24" RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="Appearance preview"/>
                            <TextBlock Classes="muted" Text="Wallpaper is one visual object; theme tokens switch together without distributed color tweening."/>
                        </StackPanel>
                        <Border Grid.Row="1" CornerRadius="14" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="WallpaperA" Source="avares://FluentMotionLab/Assets/launcher-background.png" Stretch="UniformToFill"/>
                                <Border x:Name="WallpaperB" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#482B65" Offset="0"/>
                                            <GradientStop Color="#163D56" Offset="0.52"/>
                                            <GradientStop Color="#0B1725" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Background="#66071320"/>
                                <StackPanel Margin="28" VerticalAlignment="Bottom" Spacing="10">
                                    <TextBlock Text="Preview appearance" FontSize="25" FontWeight="SemiBold"/>
                                    <TextBlock Classes="muted" Text="The accent sample changes atomically with the wallpaper decision."/>
                                    <Button x:Name="AppearanceButton" Content="Change wallpaper" Classes="primary" HorizontalAlignment="Left" Tag="appearance:toggle" Click="OnActionClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="muted" Text="LIVE STATE" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusTitle" Text="Ready" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDetail" Classes="muted" Text="Select a scene and replay its current motion." TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource Lab.Border}" Margin="0,4"/>
                    <TextBlock Text="Motion profile" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileDump" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="Scene state" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StateDump" Classes="muted" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource Lab.Border}" Margin="0,4"/>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Rapid fire intentionally interrupts active motion. The final visible state—not the animation queue—is the result under test."/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Padding="8"
                CornerRadius="18"
                Background="#F2111A29"
                BorderBrush="#536A8A"
                BorderThickness="1"
                BoxShadow="0 12 36 0 #99000000">
            <Grid ColumnDefinitions="Auto,220,Auto" ColumnSpacing="8">
                <Button Content="←" Width="44" Click="OnPreviousVariantClick"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="VariantLabel" Text="A — Legacy" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="← / → switches variant" Classes="muted" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Content="→" Width="44" Click="OnNextVariantClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
