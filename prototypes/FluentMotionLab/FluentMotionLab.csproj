<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 原型项目偏离仓库中央包版本管理，显式关闭 CPM（版本在此文件内自持） -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\src\Cafe.Launcher.Avalonia\Assets\launcher-background.png"
                      Link="Assets\launcher-background.png" />
  </ItemGroup>
</Project>
