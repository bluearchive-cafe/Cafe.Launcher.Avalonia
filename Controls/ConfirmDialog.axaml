<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Controls.ConfirmDialog"
             x:Name="Root"
             x:DataType="controls:ConfirmDialog">
    <Grid IsVisible="{Binding IsOpen, ElementName=Root}" Classes="dialog-overlay">
        <controls:DialogFrame Title="{Binding Title, ElementName=Root}"
                              Description="{Binding Description, ElementName=Root}"
                              IconKind="{Binding IconKind, ElementName=Root}"
                              IsDanger="{Binding IsDangerIcon, ElementName=Root}"
                              CloseCommand="{Binding CancelCommand, ElementName=Root}"
                              CloseToolTip="{Binding CloseToolTip, ElementName=Root}"
                              MaxWidth="{Binding DialogMaxWidth, ElementName=Root}"
                              MaxHeight="{StaticResource Cafe.Layout.Dialog.Confirm.MaxHeight}"
                              IsConfirmPanel="True">
            <controls:DialogFrame.BodyContent>
                <Border Classes="confirm-message" Background="{Binding MessageBackground, ElementName=Root}">
                    <TextBlock Text="{Binding Message, ElementName=Root}" Classes="confirm-message-text"/>
                </Border>
            </controls:DialogFrame.BodyContent>
            <controls:DialogFrame.ActionsContent>
                <StackPanel Classes="confirm-actions">
                    <Button Classes="flat-action dialog-action" Command="{Binding CancelCommand, ElementName=Root}"
                            ToolTip.Tip="{Binding CancelText, ElementName=Root}"
                            AutomationProperties.Name="{Binding CancelText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                            <TextBlock Text="{Binding CancelText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary-action dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding !IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="{Binding ConfirmIconKind, ElementName=Root}" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                            <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger-action dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding IsDangerConfirm, ElementName=Root}"
                            ToolTip.Tip="{Binding ConfirmText, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="{Binding ConfirmIconKind, ElementName=Root}" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                            <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:DialogFrame.ActionsContent>
        </controls:DialogFrame>
    </Grid>
</UserControl>
