<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Controls.ConfirmDialog"
             x:Name="Root"
             x:DataType="controls:ConfirmDialog">
    <Grid IsVisible="{Binding IsOpen, ElementName=Root}" Classes="dialog-overlay">
        <Border Classes="dialog confirm-panel" MaxWidth="{Binding DialogMaxWidth, ElementName=Root}">
            <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="dialog-icon" Classes.danger="{Binding IsDangerIcon, ElementName=Root}" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="{Binding IconKind, ElementName=Root}"
                                                    Classes="confirm-heading-icon"
                                                    Classes.danger="{Binding IsDangerIcon, ElementName=Root}"
                                                    Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                        <TextBlock Text="{Binding Title, ElementName=Root}" Classes="dialog-title"/>
                        <TextBlock Text="{Binding Description, ElementName=Root}" Classes="caption"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="dialog-close" Command="{Binding CancelCommand, ElementName=Root}"
                            ToolTip.Tip="{Binding CloseToolTip, ElementName=Root}"
                            AutomationProperties.Name="{Binding CloseToolTip, ElementName=Root}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Classes="confirm-message" Background="{Binding MessageBackground, ElementName=Root}">
                    <TextBlock Text="{Binding Message, ElementName=Root}" Classes="confirm-message-text"/>
                </Border>
                <StackPanel Grid.Row="2" Classes="confirm-actions">
                    <Button Classes="flat-action dialog-action" Command="{Binding CancelCommand, ElementName=Root}"
                            AutomationProperties.Name="{Binding CancelText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                            <TextBlock Text="{Binding CancelText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary-action dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding !IsDangerConfirm, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="{Binding ConfirmIconKind, ElementName=Root}"
                                                        Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                            <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger-action dialog-action" Command="{Binding ConfirmCommand, ElementName=Root}"
                            IsVisible="{Binding IsDangerConfirm, ElementName=Root}"
                            AutomationProperties.Name="{Binding ConfirmText, ElementName=Root}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="{Binding ConfirmIconKind, ElementName=Root}"
                                                        Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                            <TextBlock Text="{Binding ConfirmText, ElementName=Root}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
