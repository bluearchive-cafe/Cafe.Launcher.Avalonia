<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Controls.SettingRow"
             x:Name="Root"
             x:DataType="controls:SettingRow">
    <Border Classes="settings-row-frame">
        <Grid x:Name="RowLayout" Classes="settings-row" ColumnDefinitions="*,Auto">
            <StackPanel x:Name="TitleCopy"
                        MinWidth="{StaticResource Cafe.Layout.Settings.RowContent.MinWidth}"
                        Classes="dialog-heading-copy">
                <TextBlock x:Name="RowTitle" Text="{Binding Title, ElementName=Root}" Classes="section-title" TextWrapping="Wrap"/>
                <TextBlock x:Name="RowDescription" Text="{Binding Description, ElementName=Root}" Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentPresenter x:Name="ActionPresenter" Grid.Column="1"
                              Content="{Binding Action, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
