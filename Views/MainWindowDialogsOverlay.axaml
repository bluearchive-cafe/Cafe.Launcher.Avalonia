<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowDialogsOverlay"
             x:Name="DialogsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <!-- Resource control panel -->
        <Grid IsVisible="{Binding ResourcePanel.IsResourcePanelVisible}" Classes="dialog-overlay">
            <Border MaxWidth="720"
                    MaxHeight="592"
                    Classes="dialog overlay-dialog">
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanel}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding ResourcePanel.CloseResourcePanelCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                        <StackPanel Spacing="{StaticResource LauncherSpacingMd}">
                            <Border Classes="info-strip">
                                <StackPanel Spacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Text="{Binding ResourcePanel.ResourcePanelUidText}" Classes="body"
                                               IsVisible="{Binding ResourcePanel.ResourcePanelUidText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding ResourcePanel.ResourcePanelMessage}" Classes="body"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="dialog-card" IsVisible="{Binding ResourcePanel.IsResourcePanelUidMissing}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingMd}" RowSpacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Shell.I18n.ResourcePanelManualUid}" Classes="group-title"/>
                                    <TextBox Grid.Row="1"
                                             Classes="uid-input"
                                             Text="{Binding ResourcePanel.ManualResourcePanelUid, Mode=TwoWay}"
                                             PlaceholderText="{Binding Shell.I18n.ResourcePanelUid}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="primary-action dialog-action"
                                            Command="{Binding ResourcePanel.SaveManualResourcePanelUidCommand}"
                                            IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelSaveUid}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ResourcePanel.ResourcePanelItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ResourcePanelItem">
                                        <Border Classes="dialog-card" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource LauncherSpacingSm}" ColumnSpacing="{StaticResource LauncherSpacingLg}">
                                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                                    <TextBlock Text="{Binding DisplayName}" Classes="section-title"/>
                                                    <TextBlock Text="{Binding StatusText}" Classes="caption"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              OnContent="{Binding DataContext.Shell.I18n.ToggleOn, ElementName=DialogsRoot}"
                                                              OffContent="{Binding DataContext.Shell.I18n.ToggleOff, ElementName=DialogsRoot}"
                                                              VerticalAlignment="Center"/>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="{StaticResource LauncherSpacingSm}">
                                                    <TextBlock Text="{Binding DataContext.Shell.I18n.ResourcePanelOfficialVersion, ElementName=DialogsRoot}" Classes="caption"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfficialVersion}" Classes="value"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DataContext.Shell.I18n.ResourcePanelLocalizedVersion, ElementName=DialogsRoot}" Classes="caption"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LocalizedVersion}" Classes="value"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding ResourcePanel.RefreshResourcePanelCommand}"
                                IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelRefresh}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding ResourcePanel.SaveResourcePanelCommand}"
                                IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelSave}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Notice popup dialog -->
        <Grid IsVisible="{Binding Dialogs.IsNoticeDialogVisible}" Classes="dialog-overlay">
            <Border MaxWidth="540"
                    MaxHeight="480"
                    Classes="dialog overlay-dialog">
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingMd}">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n.Notice}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" Classes="scroll-pad">
                        <Border Classes="info-strip">
                            <TextBlock Text="{Binding Dialogs.NoticeDialogContent}" TextWrapping="Wrap" Foreground="{DynamicResource LauncherInfoTextBrush}" Classes="caption"/>
                        </Border>
                    </ScrollViewer>
                    <Button Grid.Row="2" Classes="primary-action" Command="{Binding Dialogs.DismissNoticeCommand}"
                            HorizontalAlignment="Center" Width="120">
                        <StackPanel Classes="button-content" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Dialogs.NoticeDialogConfirmText}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- Repair confirmation dialog -->
        <Grid IsVisible="{Binding Dialogs.IsRepairConfirmVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.RepairConfirm}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.RepairConfirmDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelRepairCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.RepairConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelRepairCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ConfirmRepairCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.Repair}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Resource Panel source confirmation dialog -->
        <Grid IsVisible="{Binding Dialogs.IsResourcePanelSourceConfirmVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelCafeOnlyTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelCafeOnlyDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelResourcePanelSourceSwitchCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.ResourcePanelSourceConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelResourcePanelSourceSwitchCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ConfirmResourcePanelSourceSwitchCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelCafeOnlySwitch}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Update available dialog -->
        <Grid IsVisible="{Binding Dialogs.IsUpdateAvailableVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel" MaxWidth="620">
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.UpdateAvailableTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Dialogs.UpdateAvailableText}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelUpdateAvailableCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="{StaticResource LauncherSpacingMd}">
                        <StackPanel Classes="card-heading">
                            <materialIcons:MaterialIcon Kind="InformationOutline"
                                                       Width="{StaticResource LauncherIconSm}"
                                                       Height="{StaticResource LauncherIconSm}"
                                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Shell.I18n.UpdateSelectFile}"
                                       Classes="confirm-message-text"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Dialogs.UpdateAvailableFiles}"
                                 SelectedItem="{Binding Dialogs.SelectedUpdateFile, Mode=TwoWay}"
                                 Classes="update-file-list"
                                 MaxHeight="240">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ReleaseFile">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="{StaticResource LauncherSpacingMd}">
                                        <Border Classes="update-file-icon">
                                            <materialIcons:MaterialIcon Kind="Download"
                                                                       Width="{StaticResource LauncherIconLg}"
                                                                       Height="{StaticResource LauncherIconLg}"
                                                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="{StaticResource LauncherSpacingXs}"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LauncherTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Url}"
                                                       Classes="caption"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Classes="update-file-size"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource LauncherSpacingXs}">
                                                <TextBlock Text="{Binding $parent[UserControl].DataContext.Shell.I18n.UpdateFileSize}"
                                                           Classes="caption"/>
                                                <TextBlock Text="{Binding DisplaySize}"
                                                           Classes="caption"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelUpdateAvailableCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.UpdateLater}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.ConfirmUpdateAvailableCommand}"
                                IsEnabled="{Binding Dialogs.HasSelectedUpdateFile}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.UpdateDownload}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- I4: Stop download confirmation dialog -->
        <Grid IsVisible="{Binding Dialogs.IsStopConfirmVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ConfirmStop}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.StopDownloadConfirm}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelStopCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.StopConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelStopCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding Dialogs.ConfirmStopCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.Stop}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- I9: Download running close confirmation dialog -->
        <Grid IsVisible="{Binding Dialogs.IsDownloadRunningCloseConfirmVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ConfirmStop}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.StopDownloadConfirm}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelCloseWhileDownloadingCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.DownloadRunningCloseConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelCloseWhileDownloadingCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding Dialogs.ConfirmCloseWhileDownloadingCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.Stop}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding Dialogs.IsUninstallConfirmVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon danger" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ConfirmUninstall}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.UninstallConfirmDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelUninstallCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherDangerSoftBrush}">
                        <TextBlock Text="{Binding Dialogs.UninstallConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelUninstallCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding Dialogs.ConfirmUninstallCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.Uninstall}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- M4: Unsaved changes confirmation dialog -->
        <Grid IsVisible="{Binding Settings.IsUnsavedChangesVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.UnsavedChanges}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.UnsavedChangesMessage}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding WindowChrome.KeepEditingSettingsCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Shell.I18n.UnsavedChangesMessage}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding WindowChrome.KeepEditingSettingsCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Pencil" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.KeepEditing}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding WindowChrome.DiscardSettingsChangesCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.DiscardChanges}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Migration wizard dialog -->
        <Grid IsVisible="{Binding MigrationWizard.IsVisible}" Classes="dialog-overlay">
            <Border Classes="dialog overlay-dialog" MaxWidth="620" MaxHeight="560">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource LauncherSpacingLg}" Classes="confirm-layout">
                    <!-- Header -->
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"
                                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.MigrationWizardTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.MigrationWizardDescription}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding MigrationWizard.SkipMigrationCommand}"
                                ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                        <StackPanel Spacing="{StaticResource LauncherSpacingLg}">
                            <!-- Game path section -->
                            <Border Classes="dialog-card">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Text="{Binding Shell.I18n.MigrationGamePathLabel}" Classes="section-title"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingSm}">
                                        <TextBox Text="{Binding MigrationWizard.Editor.Current.GamePath, Mode=TwoWay}"
                                                 MinHeight="{StaticResource LauncherControlHeightDialog}" VerticalContentAlignment="Center"
                                                 PlaceholderText="{Binding Shell.I18n.MigrationGamePathNotFound}"/>
                                        <Button Grid.Column="1" Classes="flat-action dialog-action"
                                                Command="{Binding MigrationWizard.BrowseGamePathCommand}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.MigrationGamePathBrowse}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Proxy mode -->
                            <Border Classes="dialog-card">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingLg}">
                                    <TextBlock Text="{Binding Shell.I18n.MigrationProxyLabel}"
                                               VerticalAlignment="Center" Classes="section-title" MinWidth="120"/>
                                    <ComboBox Grid.Column="1" Classes="setting-control" MinWidth="140"
                                              ItemsSource="{Binding MigrationWizard.Options.ProxyMode}"
                                              SelectedValue="{Binding MigrationWizard.Editor.Current.ProxyMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Close behavior -->
                            <Border Classes="dialog-card">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingLg}">
                                    <TextBlock Text="{Binding Shell.I18n.MigrationCloseBehaviorLabel}"
                                               VerticalAlignment="Center" Classes="section-title" MinWidth="120"/>
                                    <ComboBox Grid.Column="1" Classes="setting-control" MinWidth="140"
                                              ItemsSource="{Binding MigrationWizard.Options.CloseBehavior}"
                                              SelectedValue="{Binding MigrationWizard.Editor.Current.CloseBehavior, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Info strips -->
                            <Border Classes="info-strip" IsVisible="{Binding MigrationWizard.ClickCodeFound}">
                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}" Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="CheckCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"
                                                               Foreground="{DynamicResource LauncherSuccessBrush}"
                                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Shell.I18n.MigrationClickCodeFound}" Classes="caption" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="info-strip" IsVisible="{Binding MigrationWizard.LevelDbReadSuccess, Converter={x:Static BoolConverters.Not}}">
                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}" Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"
                                                               Foreground="{DynamicResource LauncherAccentBrush}"
                                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Shell.I18n.MigrationLevelDbFailed}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer actions -->
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding MigrationWizard.SkipMigrationCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="SkipNextOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.MigrationSkip}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding MigrationWizard.ApplyMigrationCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.MigrationApply}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Crash recovery dialog (shown on startup after unclean shutdown) -->
        <Grid IsVisible="{Binding Dialogs.IsCrashRecoveryVisible}" Classes="dialog-overlay">
            <Border Classes="dialog confirm-panel" MaxWidth="460">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"
                                                       Foreground="{DynamicResource LauncherDangerBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.CrashRecoveryTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.CrashRecoveryDescription}" Classes="caption"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.CrashRecoveryText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ViewCrashLogCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryViewLog}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ResetSettingsAfterCrashCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CogRefreshOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryResetSettings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ContinueAfterCrashCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryContinue}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
