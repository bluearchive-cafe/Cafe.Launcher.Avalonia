<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowDialogsOverlay"
             x:Name="DialogsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <!-- Resource control panel -->
        <Grid IsVisible="{Binding IsResourcePanelVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Width="720"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="dialog">
                <Grid RowDefinitions="Auto,*,Auto" Margin="22" RowSpacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Web" Width="22" Height="22" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding I18n.ResourcePanel}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding I18n.ResourcePanelDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding CloseResourcePanelCommand}" ToolTip.Tip="{Binding I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0,0,6,0">
                        <StackPanel Spacing="12">
                            <Border Classes="info-strip">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding ResourcePanelUidText}" Classes="body"
                                               IsVisible="{Binding ResourcePanelUidText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding ResourcePanelMessage}" Classes="body"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="dialog-card" IsVisible="{Binding IsResourcePanelUidMissing}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding I18n.ResourcePanelManualUid}" Classes="group-title"/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding ManualResourcePanelUid, Mode=TwoWay}"
                                             PlaceholderText="{Binding I18n.ResourcePanelUid}"
                                             MinHeight="38"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="primary-action dialog-action"
                                            Command="{Binding SaveManualResourcePanelUidCommand}"
                                            IsEnabled="{Binding IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="17" Height="17" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                            <TextBlock Text="{Binding I18n.ResourcePanelSaveUid}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ResourcePanelItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ResourcePanelItem">
                                        <Border Classes="dialog-card" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding DisplayName}" Classes="section-title"/>
                                                    <TextBlock Text="{Binding StatusText}" Classes="caption"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"/>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding DataContext.I18n.ResourcePanelOfficialVersion, ElementName=DialogsRoot}" Classes="caption"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfficialVersion}" Classes="value"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DataContext.I18n.ResourcePanelLocalizedVersion, ElementName=DialogsRoot}" Classes="caption"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LocalizedVersion}" Classes="value"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding RefreshResourcePanelCommand}"
                                IsEnabled="{Binding IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="17" Height="17"/>
                                <TextBlock Text="{Binding I18n.ResourcePanelRefresh}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding SaveResourcePanelCommand}"
                                IsEnabled="{Binding IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding I18n.ResourcePanelSave}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Notice popup dialog -->
        <Grid IsVisible="{Binding IsNoticeDialogVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Width="540"
                    MaxHeight="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="dialog">
                <Grid RowDefinitions="Auto,*,Auto" Margin="22">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="22" Height="22" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding I18n.Notice}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" Margin="0,16,0,0" Padding="0,0,6,0">
                        <Border Classes="info-strip">
                            <TextBlock Text="{Binding NoticeDialogContent}" TextWrapping="Wrap" Foreground="{DynamicResource LauncherInfoTextBrush}" FontSize="13"/>
                        </Border>
                    </ScrollViewer>
                    <Button Grid.Row="2" Classes="primary-action" Command="{Binding DismissNoticeCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Width="120">
                        <StackPanel Classes="button-content" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NoticeDialogConfirmText}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- Repair confirmation dialog -->
        <Grid IsVisible="{Binding IsRepairConfirmVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Tools" Width="22" Height="22" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding I18n.RepairConfirm}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding I18n.RepairConfirmDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding CancelRepairCommand}" ToolTip.Tip="{Binding I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding RepairConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding CancelRepairCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="17" Height="17"/>
                                <TextBlock Text="{Binding I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding ConfirmRepairCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Tools" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding I18n.Repair}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- I4: Stop download confirmation dialog -->
        <Grid IsVisible="{Binding IsStopConfirmVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Stop" Width="22" Height="22" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding I18n.ConfirmStop}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding I18n.StopDownloadConfirm}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding CancelStopCommand}" ToolTip.Tip="{Binding I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding StopConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding CancelStopCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="17" Height="17"/>
                                <TextBlock Text="{Binding I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding ConfirmStopCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Stop" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding I18n.Stop}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding IsUninstallConfirmVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="dialog-icon danger" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="22" Height="22" Foreground="{DynamicResource LauncherDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding I18n.ConfirmUninstall}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding I18n.UninstallConfirmDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding CancelUninstallCommand}" ToolTip.Tip="{Binding I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherDangerSoftBrush}">
                        <TextBlock Text="{Binding UninstallConfirmText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding CancelUninstallCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CloseCircle" Width="17" Height="17"/>
                                <TextBlock Text="{Binding I18n.Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding ConfirmUninstallCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding I18n.Uninstall}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- M4: Unsaved changes confirmation dialog -->
        <Grid IsVisible="{Binding IsUnsavedChangesVisible}" Background="{DynamicResource LauncherOverlayBrush}">
            <Border Classes="dialog confirm-panel">
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="22" Height="22" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding I18n.UnsavedChanges}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding I18n.UnsavedChangesMessage}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding KeepEditingSettingsCommand}" ToolTip.Tip="{Binding I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding I18n.UnsavedChangesMessage}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding KeepEditingSettingsCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Pencil" Width="17" Height="17"/>
                                <TextBlock Text="{Binding I18n.KeepEditing}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="danger-action dialog-action" Command="{Binding DiscardSettingsChangesCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                                <TextBlock Text="{Binding I18n.DiscardChanges}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
