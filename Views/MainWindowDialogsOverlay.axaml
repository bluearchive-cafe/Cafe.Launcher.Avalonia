<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:converters="using:Cafe.Launcher.Avalonia.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:views="using:Cafe.Launcher.Avalonia.Views"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowDialogsOverlay"
             x:Name="DialogsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <!-- Chinese localization settings -->
        <Grid Classes="dialog-overlay motion-overlay"
              IsEnabled="{Binding ModalHost.IsResourcePanelInteractive}"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding ResourcePanel.IsResourcePanelVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border Width="720"
                    Height="592"
                    Classes="dialog overlay-dialog motion-surface">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanel}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelDescription}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding ResourcePanel.CloseResourcePanelCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Classes="scroll-pad">
                        <StackPanel Spacing="{StaticResource LauncherSpacingMd}">
                            <Border Classes="info-strip resource-panel-status">
                                <StackPanel Spacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Text="{Binding ResourcePanel.ResourcePanelUidText}" Classes="body"
                                               IsVisible="{Binding ResourcePanel.ResourcePanelUidText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding ResourcePanel.ResourcePanelMessage}" Classes="body"/>
                                </StackPanel>
                            </Border>

                            <!-- UID input card: shown when UID missing -->
                            <Border Classes="dialog-card"
                                    IsVisible="{Binding ResourcePanel.IsResourcePanelUidMissing}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingMd}" RowSpacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Shell.I18n.ResourcePanelManualUid}" Classes="group-title"/>
                                    <TextBox Grid.Row="1"
                                             Classes="uid-input"
                                             Text="{Binding ResourcePanel.ManualResourcePanelUid, Mode=TwoWay}"
                                             PlaceholderText="{Binding Shell.I18n.ResourcePanelUid}"
                                             AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelUid}"
                                             IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="primary-action dialog-action"
                                            Command="{Binding ResourcePanel.SaveManualResourcePanelUidCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelSaveUid}"
                                            IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelSaveUid}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- UID edit card: shown when user clicked Change on existing UID -->
                            <Border Classes="dialog-card"
                                    IsVisible="{Binding ResourcePanel.IsResourcePanelUidEditing}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource LauncherSpacingMd}" RowSpacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Grid.ColumnSpan="3" Text="{Binding Shell.I18n.ResourcePanelEditUid}" Classes="group-title"/>
                                    <TextBox Grid.Row="1"
                                             Classes="uid-input"
                                             Text="{Binding ResourcePanel.ManualResourcePanelUid, Mode=TwoWay}"
                                             PlaceholderText="{Binding Shell.I18n.ResourcePanelUid}"
                                             AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelUid}"
                                             IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="flat-action dialog-action"
                                            Command="{Binding ResourcePanel.CancelEditResourcePanelUidCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n.Cancel}"
                                            IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="CloseCircle" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.Cancel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="2" Classes="primary-action dialog-action"
                                            Command="{Binding ResourcePanel.SaveManualResourcePanelUidCommand}"
                                            AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelSaveUid}"
                                            IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelSaveUid}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- UID display card: shown when UID is present and not editing -->
                            <Border Classes="dialog-card"
                                    IsVisible="{Binding ResourcePanel.IsResourcePanelUidPresent}">
                                <StackPanel Spacing="{StaticResource LauncherSpacingMd}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource LauncherSpacingMd}">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Shell.I18n.ResourcePanelUid}" Classes="caption"/>
                                            <TextBlock Text="{Binding ResourcePanel.ResourcePanelUidText}" Classes="body"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="flat-action dialog-action"
                                                Command="{Binding ResourcePanel.BeginEditResourcePanelUidCommand}"
                                                AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelChangeUid}"
                                                IsVisible="{Binding ResourcePanel.IsResourcePanelUidSourceCustom}"
                                                IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="Pencil" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelChangeUid}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource LauncherSpacingMd}">
                                        <TextBlock Text="{Binding Shell.I18n.ResourcePanelUidSource}" Classes="group-title"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ResourcePanel.ResourcePanelUidSourceOptions}"
                                                  SelectedValue="{Binding ResourcePanel.SelectedResourcePanelUidSource, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Code}"
                                                  IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}"
                                                  HorizontalAlignment="Left"
                                                  MinWidth="140"
                                                  AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelUidSource}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SettingOption">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ResourcePanel.ResourcePanelItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ResourcePanelItem">
                                        <Border Classes="dialog-card" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource LauncherSpacingSm}" ColumnSpacing="{StaticResource LauncherSpacingLg}">
                                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                                    <TextBlock Text="{Binding DisplayName}" Classes="section-title"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingXs}">
                                                        <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"/>
                                                        <materialIcons:MaterialIcon Kind="{Binding StatusIconKind}"
                                                                                    Width="{StaticResource LauncherIconSm}"
                                                                                    Height="{StaticResource LauncherIconSm}"
                                                                                    Foreground="{Binding Status, Converter={x:Static converters:ResourcePanelStatusToBrushConverter.Instance}}"
                                                                                    VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsOperable}"
                                                          AutomationProperties.Name="{Binding DisplayName}"
                                                          VerticalAlignment="Center"/>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="{StaticResource LauncherSpacingSm}">
                                                    <TextBlock Text="{Binding #DialogsRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n.ResourcePanelOfficialVersion}" Classes="caption"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OfficialVersion}" Classes="value"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding #DialogsRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n.ResourcePanelLocalizedVersion}" Classes="caption"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LocalizedVersion}" Classes="value"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding ResourcePanel.RefreshResourcePanelCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelRefresh}"
                                IsEnabled="{Binding ResourcePanel.IsResourcePanelBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelRefresh}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding ResourcePanel.SaveResourcePanelCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n.ResourcePanelSave}"
                                IsEnabled="{Binding ResourcePanel.IsResourcePanelSaveEnabled}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ResourcePanelSave}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Notice popup dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsNoticeDialogVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border MaxWidth="540"
                    MaxHeight="480"
                    Classes="dialog overlay-dialog motion-surface">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingMd}">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n.Notice}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" Classes="scroll-pad">
                        <Border Classes="info-strip">
                            <TextBlock Text="{Binding Dialogs.NoticeDialogContent}" TextWrapping="Wrap" Foreground="{DynamicResource LauncherInfoTextBrush}" Classes="caption"/>
                        </Border>
                    </ScrollViewer>
                    <Button Grid.Row="2" Classes="primary-action dialog-action" Command="{Binding Dialogs.DismissNoticeCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Classes="button-content" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Dialogs.NoticeDialogConfirmText}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Repair confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsRepairConfirmVisible}"
                                Title="{Binding Shell.I18n.RepairConfirm}"
                                Description="{Binding Shell.I18n.RepairConfirmDescription}"
                                IconKind="Tools"
                                Message="{Binding Dialogs.RepairConfirmText}"
                                MessageBackground="{DynamicResource LauncherWarningBackgroundBrush}"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelRepairCommand}"
                                ConfirmText="{Binding Shell.I18n.Repair}"
                                ConfirmCommand="{Binding Dialogs.ConfirmRepairCommand}"
                                ConfirmIconKind="Tools"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Resource Panel source confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsResourcePanelSourceConfirmVisible}"
                                Title="{Binding Shell.I18n.ResourcePanelCafeOnlyTitle}"
                                Description="{Binding Shell.I18n.ResourcePanelCafeOnlyDescription}"
                                IconKind="Web"
                                Message="{Binding Dialogs.ResourcePanelSourceConfirmText}"
                                MessageBackground="{DynamicResource LauncherWarningBackgroundBrush}"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelResourcePanelSourceSwitchCommand}"
                                ConfirmText="{Binding Shell.I18n.ResourcePanelCafeOnlySwitch}"
                                ConfirmCommand="{Binding Dialogs.ConfirmResourcePanelSourceSwitchCommand}"
                                ConfirmIconKind="SwapHorizontal"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Update available dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsUpdateAvailableVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border Classes="dialog confirm-panel motion-surface" MaxWidth="620">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.LauncherUpdateAvailableTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Dialogs.UpdateAvailableText}" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="dialog-close" Command="{Binding Dialogs.CancelUpdateAvailableCommand}" ToolTip.Tip="{Binding Shell.I18n.Close}"
                                AutomationProperties.Name="{Binding Shell.I18n.Close}">
                            <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="{StaticResource LauncherSpacingMd}">
                        <StackPanel Classes="card-heading">
                            <materialIcons:MaterialIcon Kind="InformationOutline"
                                                       Width="{StaticResource LauncherIconSm}"
                                                       Height="{StaticResource LauncherIconSm}"
                                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Shell.I18n.LauncherUpdateSelectFile}"
                                       Classes="confirm-message-text"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Dialogs.UpdateAvailableFiles}"
                                 SelectedItem="{Binding Dialogs.SelectedUpdateFile, Mode=TwoWay}"
                                 Classes="update-file-list"
                                 MaxHeight="240">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ReleaseFile">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="{StaticResource LauncherSpacingMd}">
                                        <Border Classes="update-file-icon">
                                            <materialIcons:MaterialIcon Kind="Download"
                                                                       Width="{StaticResource LauncherIconLg}"
                                                                       Height="{StaticResource LauncherIconLg}"
                                                                       Foreground="{DynamicResource LauncherAccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="{StaticResource LauncherSpacingXs}"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="update-file-name"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Url}"
                                                       Classes="caption"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Classes="update-file-size"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource LauncherSpacingXs}">
                                                <TextBlock Text="{Binding #DialogsRoot.((vm:MainWindowViewModel)DataContext).Shell.I18n.LauncherUpdateFileSize}"
                                                           Classes="caption"/>
                                                <TextBlock Text="{Binding DisplaySize}"
                                                           Classes="update-file-size-text"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CancelUpdateAvailableCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ClockOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.LauncherUpdateLater}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Dialogs.ConfirmUpdateAvailableCommand}"
                                IsEnabled="{Binding Dialogs.HasSelectedUpdateFile}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.LauncherUpdateDownload}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Stop download confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsStopConfirmVisible}"
                                Title="{Binding Shell.I18n.StopDownloadTitle}"
                                Description="{Binding Shell.I18n.StopDownloadMessage}"
                                IconKind="Stop"
                                Message="{Binding Dialogs.StopConfirmText}"
                                MessageBackground="{DynamicResource LauncherWarningBackgroundBrush}"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelStopCommand}"
                                ConfirmText="{Binding Shell.I18n.Stop}"
                                ConfirmCommand="{Binding Dialogs.ConfirmStopCommand}"
                                ConfirmIconKind="Stop"
                                IsDangerConfirm="True"
                                IsDangerIcon="True"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Download running close confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsDownloadRunningCloseConfirmVisible}"
                                Title="{Binding Shell.I18n.StopDownloadTitle}"
                                Description="{Binding Shell.I18n.StopDownloadMessage}"
                                IconKind="Stop"
                                Message="{Binding Dialogs.DownloadRunningCloseConfirmText}"
                                MessageBackground="{DynamicResource LauncherWarningBackgroundBrush}"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelCloseWhileDownloadingCommand}"
                                ConfirmText="{Binding Shell.I18n.Stop}"
                                ConfirmCommand="{Binding Dialogs.ConfirmCloseWhileDownloadingCommand}"
                                ConfirmIconKind="Stop"
                                IsDangerConfirm="True"
                                IsDangerIcon="True"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Uninstall confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsUninstallConfirmVisible}"
                                Title="{Binding Shell.I18n.ConfirmUninstall}"
                                Description="{Binding Shell.I18n.UninstallConfirmDescription}"
                                IconKind="AlertCircle"
                                IsDangerIcon="True"
                                Message="{Binding Dialogs.UninstallConfirmText}"
                                MessageBackground="{DynamicResource LauncherDangerSoftBrush}"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelUninstallCommand}"
                                ConfirmText="{Binding Shell.I18n.Uninstall}"
                                ConfirmCommand="{Binding Dialogs.ConfirmUninstallCommand}"
                                ConfirmIconKind="TrashCanOutline"
                                IsDangerConfirm="True"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Unsaved changes confirmation dialog -->
        <controls:ConfirmDialog IsOpen="{Binding Settings.IsUnsavedChangesVisible}"
                                Title="{Binding Shell.I18n.UnsavedChanges}"
                                Description="{Binding Shell.I18n.UnsavedChangesMessage}"
                                IconKind="AlertCircle"
                                Message="{Binding Shell.I18n.UnsavedChangesMessage}"
                                MessageBackground="{DynamicResource LauncherWarningBackgroundBrush}"
                                CancelText="{Binding Shell.I18n.KeepEditing}"
                                CancelCommand="{Binding WindowChrome.KeepEditingSettingsCommand}"
                                ConfirmText="{Binding Shell.I18n.DiscardChanges}"
                                ConfirmCommand="{Binding WindowChrome.DiscardSettingsChangesCommand}"
                                ConfirmIconKind="DeleteOutline"
                                IsDangerConfirm="True"
                                IsDangerIcon="True"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>

        <!-- Crash recovery dialog (shown on startup after unclean shutdown) -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsCrashRecoveryVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border Classes="dialog confirm-panel motion-surface" MaxWidth="460">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,Auto,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"
                                                       Foreground="{DynamicResource LauncherDangerBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.CrashRecoveryTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.CrashRecoveryDescription}" Classes="caption"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Classes="confirm-message" Background="{DynamicResource LauncherWarningBackgroundBrush}">
                        <TextBlock Text="{Binding Dialogs.CrashRecoveryText}" Classes="confirm-message-text"/>
                    </Border>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ViewCrashLogCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryViewLog}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ResetSettingsAfterCrashCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="CogRefreshOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryResetSettings}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ContinueAfterCrashCommand}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.CrashRecoveryContinue}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Critical error dialog -->
        <Grid Classes="dialog-overlay motion-overlay"
              Classes.motion-enabled="{Binding IsMotionEnabled}"
              controls:MotionVisibility.IsOpen="{Binding Dialogs.IsErrorDialogVisible}"
              controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
            <Border Classes="dialog confirm-panel motion-surface" MaxWidth="540">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,*,Auto" Classes="confirm-layout">
                    <Grid Classes="dialog-heading" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="dialog-icon" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="{StaticResource LauncherIconXl}" Height="{StaticResource LauncherIconXl}"
                                                       Foreground="{DynamicResource LauncherDangerBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                            <TextBlock Text="{Binding Shell.I18n.ErrorDialogTitle}" Classes="dialog-title"/>
                            <TextBlock Text="{Binding Shell.I18n.ErrorDialogDescription}" Classes="caption"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" Classes="scroll-pad">
                        <Border Classes="confirm-message" Background="{DynamicResource LauncherDangerSoftBrush}">
                            <TextBlock Text="{Binding Dialogs.ErrorDialogMessage}" Classes="confirm-message-text" TextWrapping="Wrap"/>
                        </Border>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Classes="confirm-actions">
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.ViewErrorLogCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n.ErrorDialogViewLog}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ErrorDialogViewLog}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="flat-action dialog-action" Command="{Binding Dialogs.CopyErrorDetailsCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n.ErrorDialogCopyDetails}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ErrorDialogCopyDetails}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action" Command="{Binding Dialogs.ContinueAfterErrorCommand}"
                                AutomationProperties.Name="{Binding Shell.I18n.ErrorDialogContinue}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Check" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.ErrorDialogContinue}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <views:SetupWizardOverlay/>
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsSetupWizardExitConfirmVisible}"
                                Title="{Binding Shell.I18n.SetupWizardExitTitle}"
                                Description="{Binding Shell.I18n.SetupWizardExitMessage}"
                                IconKind="AlertOutline"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelSetupWizardExitCommand}"
                                ConfirmText="{Binding Shell.I18n.SetupWizardExitConfirm}"
                                ConfirmCommand="{Binding Dialogs.ConfirmSetupWizardExitCommand}"
                                ConfirmIconKind="ExitToApp"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>
        <controls:ConfirmDialog IsOpen="{Binding Dialogs.IsDebugResetConfirmationVisible}"
                                Title="{Binding Shell.I18n.DebugResetSettingsTitle}"
                                Description="{Binding Shell.I18n.DebugResetSettingsDescription}"
                                IconKind="AlertOutline"
                                IsDangerIcon="True"
                                CancelText="{Binding Shell.I18n.Cancel}"
                                CancelCommand="{Binding Dialogs.CancelDebugResetCommand}"
                                ConfirmText="{Binding Shell.I18n.DebugResetSettingsConfirm}"
                                ConfirmCommand="{Binding Dialogs.ConfirmDebugResetCommand}"
                                ConfirmIconKind="Restore"
                                IsDangerConfirm="True"
                                CloseToolTip="{Binding Shell.I18n.Close}"/>
    </Grid>
</UserControl>
