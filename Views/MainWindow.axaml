<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
        xmlns:models="using:Cafe.Launcher.Avalonia.Models"
        xmlns:services="using:Cafe.Launcher.Avalonia.Services"
        xmlns:views="using:Cafe.Launcher.Avalonia.Views"
        xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="754"
        x:Class="Cafe.Launcher.Avalonia.Views.MainWindow"
        x:Name="Root"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="{Binding Shell.ProductName}"
        FontFamily="{Binding Shell.FontFamily}"
        Width="1300"
        Height="754"
        MinWidth="1024"
        MinHeight="640"
        CanResize="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource Cafe.Color.Media.Placeholder}">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Rectangle Fill="{Binding Background.BackgroundFillBrush}"/>
        <Image Source="{Binding Background.BackgroundImageSource}" Stretch="{Binding Background.BackgroundStretch}"/>

        <Grid RowDefinitions="Auto,*"
              IsEnabled="{Binding ModalHost.IsBaseLayerInteractive}">
            <Grid ColumnDefinitions="*,Auto" Height="{StaticResource Cafe.Layout.TitleBar.Height}">
                <Grid.Background>
                    <StaticResource ResourceKey="Cafe.Color.Chrome.Gradient"/>
                </Grid.Background>
                <!-- W3: Right-click context menu on title bar -->
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Shell.I18n[showLauncher]}" Command="{Binding WindowChrome.ExecuteRestoreWindowCommand}"/>
                        <MenuItem Header="{Binding Shell.I18n[settings]}" Command="{Binding WindowChrome.ShowSettingsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Shell.I18n[close]}" Command="{Binding WindowChrome.CloseCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel Classes="titlebar-brand-row">
                    <TextBlock Text="{Binding Shell.ProductName}" Classes="titlebar-brand"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="titlebar-actions">
                    <Button Classes="chrome" Command="{Binding WindowChrome.OpenDebugPanelCommand}" ToolTip.Tip="{Binding Shell.I18n[debugPanel]}"
                            IsVisible="{Binding IsDebugFeaturesEnabled}"
                            AutomationProperties.Name="{Binding Shell.I18n[debugPanel]}">
                        <materialIcons:MaterialIcon Kind="BugOutline" Width="{StaticResource Cafe.Icon.ChromeAction}" Height="{StaticResource Cafe.Icon.ChromeAction}" Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                    </Button>
                    <Button Classes="chrome" Command="{Binding ResourcePanel.OpenResourcePanelCommand}" ToolTip.Tip="{Binding Shell.I18n[resourcePanel]}"
                            AutomationProperties.Name="{Binding Shell.I18n[resourcePanel]}">
                        <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource Cafe.Icon.ChromeAction}" Height="{StaticResource Cafe.Icon.ChromeAction}" Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                    </Button>
                    <Button Classes="chrome settings" Command="{Binding WindowChrome.ShowSettingsCommand}" ToolTip.Tip="{Binding Shell.I18n[settings]}"
                            AutomationProperties.Name="{Binding Shell.I18n[settings]}">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="{StaticResource Cafe.Icon.ChromeAction}" Height="{StaticResource Cafe.Icon.ChromeAction}" Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                    </Button>
                    <Button Classes="chrome" Command="{Binding WindowChrome.MinimizeCommand}" ToolTip.Tip="{Binding Shell.I18n[minimize]}"
                            AutomationProperties.Name="{Binding Shell.I18n[minimize]}">
                        <materialIcons:MaterialIcon Kind="Minus" Width="{StaticResource Cafe.Icon.ChromeAction}" Height="{StaticResource Cafe.Icon.ChromeAction}" Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                    </Button>
                    <Button Classes="chrome close" Command="{Binding WindowChrome.CloseCommand}" ToolTip.Tip="{Binding Shell.I18n[close]}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Cafe.Icon.ChromeAction}" Height="{StaticResource Cafe.Icon.ChromeAction}" Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*,Auto">
                <Grid Classes="home-stage" Classes.compact="{Binding IsCompactHome}">
                    <Button Classes="home-drawer-toggle"
                            IsVisible="{Binding IsCompactHome}"
                            Command="{Binding ToggleHomeDrawerCommand}"
                            ToolTip.Tip="{Binding Shell.I18n[notice]}"
                            AutomationProperties.Name="{Binding Shell.I18n[notice]}">
                        <materialIcons:MaterialIcon Kind="Menu" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                    </Button>
                    <Border Classes="remote-surface home-drawer"
                            Classes.compact="{Binding IsCompactHome}"
                            IsVisible="{Binding IsHomeDrawerVisible}">
                    <Panel>
                        <Border Classes="remote-content-scroll-host">
                            <ScrollViewer Classes="scroll-pad">
                            <StackPanel Spacing="{StaticResource Cafe.Space.3}">
                            <Border IsVisible="{Binding RemoteContent.HasNotice}" Classes="notice-card">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                      ColumnSpacing="{StaticResource Cafe.Space.2}">
                                    <materialIcons:MaterialIcon Kind="BellOutline"
                                                                Width="{StaticResource Cafe.Icon.Small}"
                                                                Height="{StaticResource Cafe.Icon.Small}"
                                                                Foreground="{DynamicResource Cafe.Color.Accent}"
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Shell.I18n[notice]}"
                                               Classes="panel-title"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RemoteContent.NoticeText}"
                                               Classes="body"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <materialIcons:MaterialIcon Grid.Column="3"
                                                                Kind="ChevronRight"
                                                                Width="{StaticResource Cafe.Icon.Small}"
                                                                Height="{StaticResource Cafe.Icon.Small}"
                                                                Foreground="{DynamicResource Cafe.Color.Text.Muted}"
                                                                VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="BannerHost"
                                    Classes="surface banner-shell"
                                    Focusable="True"
                                    PointerEntered="BannerHost_OnPointerEntered"
                                    PointerExited="BannerHost_OnPointerExited"
                                    KeyDown="BannerHost_OnKeyDown"
                                    IsVisible="{Binding RemoteContent.HasBannerItems}">
                              <Panel>
                                <Carousel x:Name="BannerCarousel"
                                          ItemsSource="{Binding RemoteContent.BannerItems}"
                                          SelectedIndex="{Binding RemoteContent.CarouselSelectedIndex, Mode=TwoWay}"
                                          PageTransition="{Binding RemoteContent.CarouselTransition}"
                                          Height="{StaticResource Cafe.Layout.Home.Banner.Height}"
                                          CornerRadius="{StaticResource Cafe.Radius.Medium}" ClipToBounds="True">
                                    <Carousel.Styles>
                                        <Style Selector="ContentControl">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </Carousel.Styles>
                                    <Carousel.ItemTemplate>
                                        <DataTemplate x:DataType="models:RemoteContentItem">
                                            <Button Classes="banner-link"
                                                    Cursor="Hand"
                                                    Width="{Binding #BannerCarousel.Bounds.Width}"
                                                    Height="{Binding #BannerCarousel.Bounds.Height}"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                    CommandParameter="{Binding Url}">
                                                <Border Classes="banner-media">
                                                    <Panel>
                                                        <Border Classes="media-placeholder"
                                                                IsVisible="{Binding IsImageLoadFailed}">
                                                            <TextBlock Text="{Binding #Root.((vm:MainWindowViewModel)DataContext).Shell.I18n[bannerLoadingFailed]}"
                                                                       Classes="media-placeholder-text"/>
                                                        </Border>
                                                        <Image Source="{Binding BannerBitmap}"
                                                               Stretch="UniformToFill"/>
                                                        <controls:LoadingOverlay IsVisible="{Binding IsImageLoading}"
                                                                                  Text="{Binding #Root.((vm:MainWindowViewModel)DataContext).Shell.I18n[bannerLoading]}"/>
                                                    </Panel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </Carousel.ItemTemplate>
                                </Carousel>

                                <Grid Classes="banner-controls"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="*,Auto"
                                      IsVisible="{Binding RemoteContent.HasMultipleBanners}">
                                    <Button Grid.Column="0"
                                            Grid.RowSpan="2"
                                            Classes="icon-button carousel-navigation"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Command="{Binding RemoteContent.SelectPreviousBannerCommand}"
                                            ToolTip.Tip="{Binding Shell.I18n[previousBanner]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[previousBanner]}">
                                        <materialIcons:MaterialIcon Kind="ChevronLeft" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"
                                                                    Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Classes="icon-button carousel-navigation"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Command="{Binding RemoteContent.SelectNextBannerCommand}"
                                            ToolTip.Tip="{Binding Shell.I18n[nextBanner]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[nextBanner]}">
                                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"
                                                                    Foreground="{DynamicResource Cafe.Color.OnChrome}"/>
                                    </Button>

                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Classes="banner-progress"
                                            HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{StaticResource Cafe.Space.2}"
                                                    VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding RemoteContent.BannerDots}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <StaticResource ResourceKey="HorizontalSpacingSmPanel"/>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:BannerDot">
                                                        <Button Classes="icon-button dot"
                                                                Cursor="Hand"
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.SelectBannerCommand}"
                                                                CommandParameter="{Binding Index}">
                                                            <Border Classes="banner-dot"
                                                                    Classes.active="{Binding IsActive}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RemoteContent.CarouselPageText}"
                                                       Classes="banner-page-text"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                              </Panel>
                            </Border>

                            <Border Classes="surface news-card"
                                    IsVisible="{Binding RemoteContent.HasNewsItems}">
                                <StackPanel Classes="news-panel"
                                            Spacing="{StaticResource Cafe.Space.2}">
                                    <ScrollViewer HorizontalAlignment="Left"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding RemoteContent.NewsCategories}">
                                                <ItemsControl.ItemsPanel>
                                                    <StaticResource ResourceKey="HorizontalSpacingXsPanel"/>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:NewsCategory">
                                                        <Button Cursor="Hand"
                                                                Classes="news-category-tab"
                                                                Classes.active="{Binding IsActive}"
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.SelectNewsCategoryCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- Filtered news items -->
                                    <ScrollViewer Classes="news-viewport"
                                                  Height="{StaticResource Cafe.Layout.News.Viewport.Height}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding RemoteContent.SelectedNewsCategory, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ItemsControl ItemsSource="{Binding RemoteContent.SelectedNewsCategory.Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="{StaticResource Cafe.Space.2}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:RemoteContentItem">
                                                    <Button Classes="content-link news-row"
                                                            Cursor="Hand"
                                                            Height="{StaticResource Cafe.Layout.News.Row.Height}"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                            CommandParameter="{Binding Url}">
                                                        <Border Classes="content-row news-content-row">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Cafe.Space.4}">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Classes="value"
                                                                           MaxLines="2"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding Title}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Subtitle}"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Classes="caption"/>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Classes="remote-content-load-error"
                                IsVisible="{Binding RemoteContent.HasLoadError}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource Cafe.Space.3}">
                                <materialIcons:MaterialIcon Kind="AlertCircle"
                                                            Width="{StaticResource Cafe.Icon.Medium}"
                                                            Height="{StaticResource Cafe.Icon.Medium}"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{DynamicResource Cafe.Color.Danger}"/>
                                <TextBlock Text="{Binding Shell.I18n[remoteContentLoadFailed]}"
                                           Classes="body"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <controls:LoadingOverlay Classes="remote-content-loading-overlay"
                                                  IsVisible="{Binding RemoteContent.IsLoading}"
                                                  Text="{Binding Shell.I18n[remoteContentLoading]}"/>
                    </Panel>
                    </Border>

                    <Border Classes="social-rail"
                            Classes.compact="{Binding IsCompactHome}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="{StaticResource Cafe.Space.1}">
                            <Button Classes="social-chip"
                                    Command="{Binding WindowChrome.OpenOfficialSiteCommand}"
                                    ToolTip.Tip="{Binding Shell.I18n[officialSite]}"
                                    AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                                <materialIcons:MaterialIcon Kind="Web"
                                                            Width="{StaticResource Cafe.Icon.Medium}"
                                                            Height="{StaticResource Cafe.Icon.Medium}"/>
                            </Button>
                            <ItemsControl ItemsSource="{Binding RemoteContent.SocialMediaItems}"
                                          IsVisible="{Binding RemoteContent.HasSocialMediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource Cafe.Space.1}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RemoteContentItem">
                                        <Button Classes="social-chip"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoteContent.OpenExternalUrlCommand}"
                                                CommandParameter="{Binding Url}"
                                                ToolTip.Tip="{Binding Title}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <materialIcons:MaterialIcon Kind="{Binding SocialIconKind}"
                                                                        Width="{StaticResource Cafe.Icon.Medium}"
                                                                        Height="{StaticResource Cafe.Icon.Medium}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Classes="bottom-panel motion-bottom"
                        Classes.motion-enabled="{Binding IsMotionEnabled}"
                        Classes.motion-enter="{Binding Operations.IsInstallPanelVisible}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Operations.IsInstallPanelVisible"/>
                            <Binding Path="IsBottomPanelVisible"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Panel>
                    <!-- Compact layout -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" ColumnSpacing="{StaticResource Cafe.Space.5}">
                        <StackPanel Spacing="{StaticResource Cafe.Space.2}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Cafe.Space.4}">
                                <TextBlock Classes="caption" Text="{Binding Shell.VersionText}"/>
                                <TextBlock Classes="caption" Text="{Binding Shell.DiskSpaceText}"/>
                                <TextBlock Classes="caption" Text="{Binding Shell.NetworkText}"/>
                            </StackPanel>
                            <Border Classes="path-field">
                                <Grid Classes="install-path-row" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Cafe.Space.2}">
                                    <TextBlock Text="{Binding Shell.I18n[path]}" Classes="value" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Shell.PathText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Classes="icon-link" Command="{Binding Settings.ChangePersistedGamePathCommand}" VerticalAlignment="Center"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                            ToolTip.Tip="{Binding Shell.I18n[changePath]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[changePath]}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                                            <TextBlock Text="{Binding Shell.I18n[changePath]}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="icon-link" Command="{Binding Settings.SelectInstalledGameCommand}" VerticalAlignment="Center"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                            ToolTip.Tip="{Binding Shell.I18n[selectInstalledGame]}"
                                            AutomationProperties.Name="{Binding Shell.I18n[selectInstalledGame]}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                                            <TextBlock Text="{Binding Shell.I18n[selectInstalledGame]}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="operation-actions" Orientation="Horizontal" Spacing="{StaticResource Cafe.Space.3}" VerticalAlignment="Center">
                            <Button Classes="flat-action" Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="{Binding Shell.I18n[refreshTooltip]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Shell.I18n[refresh]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                                    <TextBlock Text="{Binding Shell.I18n[refresh]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary-action" Command="{Binding Operations.InstallOrUpdateCommand}"
                                    ToolTip.Tip="{Binding Operations.InstallButtonToolTip}"
                                    ToolTip.ShowOnDisabled="True"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Operations.InstallButtonText}"
                                    AutomationProperties.HelpText="{Binding Operations.InstallButtonToolTip}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Download" Width="{StaticResource Cafe.Icon.Large}" Height="{StaticResource Cafe.Icon.Large}"/>
                                    <TextBlock Text="{Binding Operations.InstallButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Panel>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding Operations.IsProgressPanelVisible}"
                        Classes="bottom-panel">
                    <Grid Classes="operation-layout" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Cafe.Space.5}" VerticalAlignment="Center">
                        <Grid Classes="operation-status"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="{StaticResource Cafe.Space.3}"
                              RowSpacing="{StaticResource Cafe.Space.2}"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Cafe.Icon.Large}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Title + percentage -->
                            <materialIcons:MaterialIcon Kind="{Binding Operations.ProgressIconKind}"
                                                        Width="{StaticResource Cafe.Icon.Large}"
                                                        Height="{StaticResource Cafe.Icon.Large}"
                                                        Foreground="{DynamicResource Cafe.Color.Accent}"
                                                        VerticalAlignment="Center"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Cafe.Space.2}">
                                <TextBlock Text="{Binding Operations.ProgressTitle}" Classes="progress-title operation-status-title" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operations.ProgressValue, StringFormat={}{0}%}"
                                           Classes="progress-title" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Cafe.Color.Accent}"/>
                            </Grid>
                            <!-- Progress bar -->
                            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Operations.ProgressValue}" Minimum="0" Maximum="100" Height="8"/>
                            <!-- Stage | Speed | Size | ETA -->
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Cafe.Space.3}">
                                <TextBlock Text="{Binding Operations.ProgressDetail}" Classes="caption"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operations.ProgressSpeed}" Classes="caption"
                                           IsVisible="{Binding Operations.ProgressSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Operations.ProgressSize}" Classes="caption"
                                           IsVisible="{Binding Operations.ProgressSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Operations.ProgressEstimated}" Classes="caption"
                                           Foreground="{DynamicResource Cafe.Color.Accent}"
                                           IsVisible="{Binding Operations.ProgressEstimated, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" Classes="operation-actions" Orientation="Horizontal" Spacing="{StaticResource Cafe.Space.2}" VerticalAlignment="Center">
                            <Button Classes="flat-action" Command="{Binding Operations.PauseResumeCommand}" VerticalAlignment="Center"
                                    IsVisible="{Binding Operations.CanPauseOperation}"
                                    ToolTip.Tip="{Binding Operations.PauseResumeText}"
                                    AutomationProperties.Name="{Binding Operations.PauseResumeText}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="{Binding Operations.PauseResumeIcon}" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                                    <TextBlock Text="{Binding Operations.PauseResumeText}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="flat-action" Command="{Binding Operations.StopOperationCommand}" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Shell.I18n[stop]}"
                                    AutomationProperties.Name="{Binding Shell.I18n[stop]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                                    <TextBlock Text="{Binding Shell.I18n[stop]}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Classes="bottom-panel control-panel motion-bottom"
                        Classes.motion-enabled="{Binding IsMotionEnabled}"
                        Classes.motion-enter="{Binding Operations.IsControlPanelVisible}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Operations.IsControlPanelVisible"/>
                            <Binding Path="IsBottomPanelVisible"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Panel>
                    <!-- Compact layout -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" ColumnSpacing="{StaticResource Cafe.Space.5}">
                        <Grid.IsVisible>
                            <Binding Path="IsStatusDetailHidden" Converter="{x:Static BoolConverters.Not}"/>
                        </Grid.IsVisible>
                        <StackPanel Grid.Column="1" Classes="operation-actions" Orientation="Horizontal" Spacing="{StaticResource Cafe.Space.4}" VerticalAlignment="Center">
                            <Button Classes="flat-action elevated"
                                    Command="{Binding WindowChrome.OpenOfficialSiteCommand}"
                                    ToolTip.Tip="{Binding Shell.I18n[officialSite]}"
                                    AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                                    <TextBlock Text="{Binding Shell.I18n[officialSite]}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary-action" Command="{Binding Operations.StartGameCommand}" ToolTip.Tip="{Binding Shell.I18n[startGame]}"
                                    IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                    AutomationProperties.Name="{Binding Shell.I18n[startGame]}">
                                <StackPanel Classes="button-content">
                                    <materialIcons:MaterialIcon Kind="PlayCircle" Width="{StaticResource Cafe.Icon.Large}" Height="{StaticResource Cafe.Icon.Large}"/>
                                    <TextBlock Text="{Binding Shell.I18n[startGame]}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="{StaticResource Cafe.Space.4}">
                            <TextBlock Text="{Binding Shell.VersionText}" Classes="on-dark-caption"/>
                            <TextBlock Text="{Binding Shell.LaunchCheckText}" Classes="on-dark-caption"/>
                            <TextBlock Text="{Binding Shell.NetworkText}" Classes="on-dark-caption"/>
                        </StackPanel>
                    </Grid>
                    <!-- Hidden layout (buttons only) -->
                    <StackPanel Classes="operation-actions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Cafe.Space.4}"
                                IsVisible="{Binding IsStatusDetailHidden}"
                                VerticalAlignment="Center">
                        <Button Classes="flat-action elevated"
                                Command="{Binding WindowChrome.OpenOfficialSiteCommand}"
                                ToolTip.Tip="{Binding Shell.I18n[officialSite]}"
                                AutomationProperties.Name="{Binding Shell.I18n[officialSite]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                                <TextBlock Text="{Binding Shell.I18n[officialSite]}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action" Command="{Binding Operations.StartGameCommand}" ToolTip.Tip="{Binding Shell.I18n[startGame]}"
                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}"
                                AutomationProperties.Name="{Binding Shell.I18n[startGame]}">
                            <StackPanel Classes="button-content">
                                <materialIcons:MaterialIcon Kind="PlayCircle" Width="{StaticResource Cafe.Icon.Large}" Height="{StaticResource Cafe.Icon.Large}"/>
                                <TextBlock Text="{Binding Shell.I18n[startGame]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Grid>

        <views:MainWindowSettingsOverlay/>
        <views:MainWindowDebugOverlay/>
        <views:MainWindowLogViewerOverlay/>
        <views:MainWindowDialogsOverlay/>
        <views:MainWindowToastOverlay/>
    </Grid>
</Window>
