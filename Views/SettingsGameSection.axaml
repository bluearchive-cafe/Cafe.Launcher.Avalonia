<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             x:Class="Cafe.Launcher.Avalonia.Views.SettingsGameSection"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel Classes="settings-group first">
        <TextBlock Text="{Binding Shell.I18n[settingsGroupGameFiles]}" Classes="group-title settings-group-title"/>

        <controls:SettingRow
                             Title="{Binding Shell.I18n[gamePath]}"
                             Description="{Binding Settings.Editor.Current.GamePath}">
            <controls:SettingRow.Action>
                <Button Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                        AutomationProperties.Name="{Binding Shell.I18n[choose]}"
                        IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Classes="button-content">
                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                        <TextBlock Text="{Binding Shell.I18n[choose]}"/>
                    </StackPanel>
                </Button>
            </controls:SettingRow.Action>
        </controls:SettingRow>

        <controls:SettingComboRow
                                  Title="{Binding Shell.I18n[launchCheck]}"
                                  Description="{Binding Shell.I18n[launchCheckDescription]}"
                                  ItemsSource="{Binding Settings.Options.LaunchCheckMode}"
                                  SelectedValue="{Binding Settings.Editor.Current.LaunchCheckMode, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource SelectableOptionTextTemplate}"/>

        <controls:SettingRow
                             Title="{Binding Shell.I18n[gameManagement]}"
                             Description="{Binding Shell.I18n[gameManagementDescription]}">
            <controls:SettingRow.Action>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Cafe.Space.2}" VerticalAlignment="Center">
                    <Button Classes="flat-action" Command="{Binding Operations.RequestRepairCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[repair]}"
                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}"/>
                            <TextBlock Text="{Binding Shell.I18n[repair]}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="flat-action" Command="{Binding Operations.RequestUninstallCommand}"
                            AutomationProperties.Name="{Binding Shell.I18n[uninstall]}"
                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                        <StackPanel Classes="button-content">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{StaticResource Cafe.Icon.Small}" Height="{StaticResource Cafe.Icon.Small}" Foreground="{DynamicResource Cafe.Color.Danger}"/>
                            <TextBlock Text="{Binding Shell.I18n[uninstall]}" Foreground="{DynamicResource Cafe.Color.Danger}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingRow.Action>
        </controls:SettingRow>
    </StackPanel>
</UserControl>
