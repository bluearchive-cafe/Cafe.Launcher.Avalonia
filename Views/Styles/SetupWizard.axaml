<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox.settings-navigation.wizard-navigation">
        <Setter Property="Padding" Value="8,8,8,16"/>
    </Style>
    <Style Selector="TextBlock.wizard-step-number">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.wizard-review-row">
        <Setter Property="MinHeight" Value="{StaticResource Cafe.Control.Height.Dialog}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.wizard-review-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Border}"/>
    </Style>
    <Style Selector="Button.wizard-choice">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Cafe.Radius.Medium}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.wizard-choice:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
    </Style>
    <Style Selector="Button.wizard-choice.active">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.checking">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.ready">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Success}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.corrupted">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Danger}"/>
    </Style>
    <Style Selector="TextBlock.wizard-game-path-status.inaccessible">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Danger}"/>
    </Style>
</Styles>
