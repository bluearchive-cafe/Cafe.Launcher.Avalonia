<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.banner-dot">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Indicator.Inactive}"/>
        <Setter Property="Width" Value="{DynamicResource Cafe.Space.2}"/>
        <Setter Property="Height" Value="{DynamicResource Cafe.Space.2}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Cafe.Radius.Small}"/>
    </Style>
    <Style Selector="Border.banner-dot.active">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.social-chip">
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Chrome.ControlHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.OnChrome.Muted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnChrome}"/>
        <Setter Property="Width" Value="{StaticResource Cafe.Control.Size.Social}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Size.Social}"/>
        <Setter Property="Padding" Value="{DynamicResource Cafe.Inset.None}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Cafe.Radius.Small}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.social-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.social-chip:disabled">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Border.Button}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
    </Style>
    <Style Selector="Button.news-tab">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Row}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Cafe.Type.Body}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.news-tab.log-filter">
        <Setter Property="Height" Value="{DynamicResource Cafe.Control.Height.Setting}"/>
    </Style>
    <Style Selector="Button.news-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent.Hover}"/>
    </Style>
    <Style Selector="Button.news-tab.active">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent}"/>
    </Style>
    <Style Selector="Button.news-category-tab">
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.None}"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Cafe.Border.TabUnderline}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Cafe.Type.Body}"/>
        <Setter Property="Padding" Value="{DynamicResource Cafe.Inset.Tab}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Cafe.Control.Height.Setting}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.news-category-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.news-category-tab:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
    </Style>
    <Style Selector="Button.news-category-tab.active">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.news-category-tab:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Focus}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Cafe.Border.TabUnderline}"/>
    </Style>
    <Style Selector="Border.info-strip.resource-panel-status">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</Styles>
