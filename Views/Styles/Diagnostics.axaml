<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="StackPanel.log-filter-bar">
        <Setter Property="Margin" Value="16,12,16,0"/>
    </Style>
    <Style Selector="Border.log-empty-state">
        <Setter Property="Margin" Value="{StaticResource Cafe.Inset.Large}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.log-empty-state TextBlock.media-placeholder-text">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list">
        <Setter Property="Margin" Value="{StaticResource Cafe.Inset.Large}"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
    </Style>
    <Style Selector="ListBox.log-entry-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
    </Style>
</Styles>
