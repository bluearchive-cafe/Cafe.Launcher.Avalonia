<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Style Selector="Border.toast-card">
        <Setter Property="Background" Value="{DynamicResource LauncherToastBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LauncherCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource LauncherRadiusMd}"/>
        <Setter Property="Padding" Value="{DynamicResource LauncherThicknessNone}"/>
        <Setter Property="MinWidth" Value="{DynamicResource LauncherToastWidth}"/>
        <Setter Property="MaxWidth" Value="{DynamicResource LauncherToastWidth}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.toast-card.motion-enabled:not(.motion-exit)">
        <Style.Animations>
            <Animation Duration="0:0:0.200" FillMode="Forward" Easing="ExponentialEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="6"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.toast-card.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="0:0:0.167" FillMode="Forward" Easing="ExponentialEaseIn">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.toast-host">
        <Setter Property="IsHitTestVisible" Value="True"/>
        <Setter Property="Margin" Value="0,56,16,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="StackPanel.toast-list">
        <Setter Property="Spacing" Value="{DynamicResource LauncherSpacingSm}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="Grid.toast-layout">
        <Setter Property="ColumnSpacing" Value="{DynamicResource LauncherSpacingSm}"/>
    </Style>
    <Style Selector="Border.toast-content">
        <Setter Property="Padding" Value="{DynamicResource LauncherToastContentPadding}"/>
    </Style>
    <Style Selector="TextBlock.toast-message">
        <Setter Property="FontSize" Value="{DynamicResource LauncherFontSizeMd}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextBodyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="282"/>
        <Setter Property="Margin" Value="{DynamicResource LauncherToastMessageMargin}"/>
    </Style>
    <Style Selector="Button.toast-close">
        <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource LauncherRadiusSm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button.toast-close:pointerover">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource LauncherFlatHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.toast-close:pressed">
        <Setter Property="Background" Value="{DynamicResource LauncherFlatPressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.toast-title">
        <Setter Property="FontSize" Value="{DynamicResource LauncherFontSizeLg}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.toast-icon">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="WrapPanel.toast-actions">
        <Setter Property="Margin" Value="{DynamicResource LauncherToastActionRowMargin}"/>
    </Style>
    <Style Selector="Button.toast-primary-action">
        <Setter Property="MinWidth" Value="{DynamicResource LauncherControlMinWidthNone}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="{DynamicResource LauncherToastPrimaryActionMargin}"/>
        <Setter Property="FontSize" Value="{DynamicResource LauncherFontSizeSm}"/>
        <Setter Property="Background" Value="{DynamicResource LauncherAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherOnAccentBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource LauncherRadiusSm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource LauncherBorderButtonTemplate}"/>
    </Style>
    <Style Selector="Button.toast-primary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource LauncherAccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.toast-primary-action:pressed">
        <Setter Property="Background" Value="{DynamicResource LauncherAccentPressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.toast-primary-action:disabled">
        <Setter Property="Background" Value="{DynamicResource LauncherButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.toast-secondary-action">
        <Setter Property="MinWidth" Value="{DynamicResource LauncherControlMinWidthNone}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="{DynamicResource LauncherFontSizeSm}"/>
        <Setter Property="Background" Value="{DynamicResource LauncherTransparentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LauncherButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource LauncherRadiusSm}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource LauncherBorderButtonTemplate}"/>
    </Style>
    <Style Selector="Button.toast-secondary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource LauncherFlatHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}"/>
    </Style>
    <Style Selector="Button.toast-secondary-action:pressed">
        <Setter Property="Background" Value="{DynamicResource LauncherFlatPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}"/>
    </Style>
    <Style Selector="Button.toast-secondary-action:disabled">
        <Setter Property="Background" Value="{DynamicResource LauncherContentRowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LauncherCardBorderBrush}"/>
    </Style>
    <Style Selector="ProgressBar.toast-progress">
        <Setter Property="Height" Value="{DynamicResource LauncherToastAutoDismissProgressHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource LauncherToastAutoDismissProgressHeight}"/>
        <Setter Property="Background" Value="{DynamicResource LauncherCardBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
</Styles>
