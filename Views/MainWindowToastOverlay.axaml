<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:services="using:Cafe.Launcher.Avalonia.Services"
             xmlns:converters="using:Cafe.Launcher.Avalonia.Converters"
             xmlns:constants="using:Cafe.Launcher.Avalonia.Constants"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowToastOverlay"
             x:Name="ToastOverlayRoot"
             x:DataType="vm:MainWindowViewModel">
        <!-- Toast notification overlay -->
        <Grid Classes="toast-host" ZIndex="{x:Static constants:LauncherConstants.ZIndexToast}">
            <ItemsControl ItemsSource="{Binding Toasts.ActiveToasts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Classes="toast-list"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:ToastNotification}">
                        <Border Classes="toast-card"
                                IsHitTestVisible="True">
                            <Grid Classes="toast-layout" ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"
                                                            Foreground="{Binding Severity, Converter={x:Static converters:ToastSeverityToBrushConverter.Instance}}"
                                                            Classes="toast-icon"
                                                            AutomationProperties.Name="{Binding SeverityLabel}"/>
                                <StackPanel Grid.Column="1" Classes="toast-copy">
                                    <TextBlock Text="{Binding SeverityLabel}" Classes="toast-severity"
                                               Foreground="{Binding Severity, Converter={x:Static converters:ToastSeverityToBrushConverter.Instance}}"/>
                                    <TextBlock Text="{Binding Message}"
                                               VerticalAlignment="Center"
                                               Classes="toast-message"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="toast-close"
                                        Command="{Binding DataContext.Toasts.DismissToastCommand, ElementName=ToastOverlayRoot}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding DataContext.Shell.I18n.Close, ElementName=ToastOverlayRoot}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
</UserControl>
