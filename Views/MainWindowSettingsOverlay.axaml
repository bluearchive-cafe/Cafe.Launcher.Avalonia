<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:controls="using:Cafe.Launcher.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Cafe.Launcher.Avalonia.Views"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowSettingsOverlay"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid Classes="settings-overlay motion-overlay"
          IsEnabled="{Binding ModalHost.IsSettingsInteractive}"
          Classes.motion-enabled="{Binding IsMotionEnabled}"
          controls:MotionVisibility.IsOpen="{Binding WindowChrome.IsSettingsVisible}"
          controls:MotionVisibility.IsMotionEnabled="{Binding IsMotionEnabled}">
        <Border MaxWidth="960"
                MaxHeight="620"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="dialog overlay-dialog panel-frame motion-surface">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid RowDefinitions="*" Classes="motion-surface-content panel-content">
                <Grid x:Name="SettingsWorkspace" Classes="settings-workspace" ColumnDefinitions="188,*">
                    <Button x:Name="SettingsFloatingClose"
                            Grid.Column="1"
                            Classes="dialog-close settings-floating-close"
                            Command="{Binding WindowChrome.ShowSettingsCommand}"
                            ToolTip.Tip="{Binding Shell.I18n[close]}"
                            AutomationProperties.Name="{Binding Shell.I18n[close]}"
                            ZIndex="2">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource Cafe.Icon.Medium}" Height="{StaticResource Cafe.Icon.Medium}"/>
                    </Button>

                    <Grid x:Name="SettingsNavigationPane" Classes="settings-navigation-pane" RowDefinitions="Auto,*">
                        <TextBlock Text="{Binding Shell.I18n[settings]}"
                                   Classes="dialog-title settings-navigation-title"
                                   AutomationProperties.Name="{Binding Shell.I18n[settings]}"/>
                        <ListBox Grid.Row="1"
                                 Classes="settings-navigation"
                                 x:Name="SettingsNavigation"
                                 AutomationProperties.AutomationId="SettingsNavigation"
                                 Focusable="True"
                                 ItemsSource="{Binding Settings.Options.SettingsCategories}"
                                 SelectedValue="{Binding Settings.SelectedCategory, Mode=TwoWay}"
                                 SelectedValueBinding="{Binding Code}"
                                 IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SettingOption">
                                <TextBlock Text="{Binding DisplayName}"
                                           Classes="settings-navigation-item"
                                           ToolTip.Tip="{Binding Description}"
                                           AutomationProperties.Name="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border x:Name="SettingsContentDivider" Grid.Column="1" Classes="settings-content-divider">
                      <Border Classes="settings-content-padding">
                        <Grid Classes="settings-content">
                        <ScrollViewer
                                      Classes="dialog-scroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="category-header settings-category-header">
                                <TextBlock Classes="category-title"
                                           DataContext="{Binding SelectedItem, ElementName=SettingsNavigation}"
                                           x:DataType="models:SettingOption"
                                           Text="{Binding DisplayName}"
                                           AutomationProperties.Name="{Binding DisplayName}"/>
                                <TextBlock Classes="settings-intro caption"
                                           DataContext="{Binding SelectedItem, ElementName=SettingsNavigation}"
                                           x:DataType="models:SettingOption"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap"/>
                                <Border Classes="settings-save-error" IsVisible="{Binding Settings.HasAutoSaveFailure}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Cafe.Space.3}">
                                        <materialIcons:MaterialIcon Kind="AlertCircle"
                                                                     Width="{StaticResource Cafe.Icon.Medium}"
                                                                     Height="{StaticResource Cafe.Icon.Medium}"
                                                                     Foreground="{DynamicResource Cafe.Color.Danger}"
                                                                     VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Settings.AutoSaveFailureMessage}" Classes="body"/>
                                        <Button Grid.Column="2" Classes="flat-action settings-retry-action" Command="{Binding Settings.RetryAutoSaveCommand}">
                                            <TextBlock Text="{Binding Shell.I18n[retry]}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <views:SettingsGeneralSection IsVisible="{Binding Settings.IsGeneralCategorySelected}"
                                                              Classes="motion-content"
                                                              Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                              Classes.motion-enter="{Binding Settings.IsGeneralCategorySelected}">
                                    <views:SettingsGeneralSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsGeneralSection.RenderTransform>
                                </views:SettingsGeneralSection>
                                <views:SettingsGameSection IsVisible="{Binding Settings.IsGameCategorySelected}"
                                                           Classes="motion-content"
                                                           Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                           Classes.motion-enter="{Binding Settings.IsGameCategorySelected}">
                                    <views:SettingsGameSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsGameSection.RenderTransform>
                                </views:SettingsGameSection>
                                <views:SettingsDownloadNetworkSection IsVisible="{Binding Settings.IsDownloadNetworkCategorySelected}"
                                                                      Classes="motion-content"
                                                                      Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                                      Classes.motion-enter="{Binding Settings.IsDownloadNetworkCategorySelected}">
                                    <views:SettingsDownloadNetworkSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsDownloadNetworkSection.RenderTransform>
                                </views:SettingsDownloadNetworkSection>
                                <views:SettingsAppearanceSection IsVisible="{Binding Settings.IsAppearanceCategorySelected}"
                                                                 Classes="motion-content"
                                                                 Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                                 Classes.motion-enter="{Binding Settings.IsAppearanceCategorySelected}">
                                    <views:SettingsAppearanceSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAppearanceSection.RenderTransform>
                                </views:SettingsAppearanceSection>
                                <views:SettingsAdvancedSection IsVisible="{Binding Settings.IsAdvancedCategorySelected}"
                                                               Classes="motion-content"
                                                               Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                               Classes.motion-enter="{Binding Settings.IsAdvancedCategorySelected}">
                                    <views:SettingsAdvancedSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAdvancedSection.RenderTransform>
                                </views:SettingsAdvancedSection>
                                <views:SettingsAboutSection IsVisible="{Binding Settings.IsAboutCategorySelected}"
                                                            Classes="motion-content"
                                                            Classes.motion-enabled="{Binding IsMotionEnabled}"
                                                            Classes.motion-enter="{Binding Settings.IsAboutCategorySelected}">
                                    <views:SettingsAboutSection.RenderTransform>
                                        <TranslateTransform/>
                                    </views:SettingsAboutSection.RenderTransform>
                                </views:SettingsAboutSection>
                            </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </Border>
                    </Border>

                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
