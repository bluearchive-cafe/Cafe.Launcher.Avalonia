<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowSettingsOverlay"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid IsVisible="{Binding WindowChrome.IsSettingsVisible}" Classes="settings-overlay">
        <Border MaxWidth="760"
                MaxHeight="650"
                Classes="dialog overlay-dialog">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Classes="dialog-header">
                    <StackPanel Classes="dialog-title-row">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n.Settings}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dialog-close" Command="{Binding WindowChrome.ShowSettingsCommand}"
                            VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="{Binding Shell.I18n.Close}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Classes="dialog-scroll">
                    <StackPanel Spacing="{StaticResource LauncherSpacingMd}">
                        <Border Classes="settings-section">
                            <StackPanel Classes="status-panel">
                                <TextBlock Text="{Binding Shell.I18n.SettingsStatus}" Classes="group-title"/>
                                <Grid Classes="status-summary" ColumnDefinitions="Auto,*">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="{Binding Shell.StatusIconKind}"
                                                                    Width="{StaticResource LauncherIconLg}"
                                                                    Height="{StaticResource LauncherIconLg}"
                                                                    Foreground="{DynamicResource LauncherAccentBrush}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Shell.CurrentViewTitle}"
                                               Classes="status-summary-title"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Classes="status-details"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <Border Classes="status-detail">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                            <TextBlock Text="{Binding Shell.I18n.Version}" Classes="caption"/>
                                            <TextBlock Text="{Binding Shell.VersionText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="status-detail">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                            <TextBlock Text="{Binding Shell.I18n.Executable}" Classes="caption"/>
                                            <TextBlock Text="{Binding Shell.ExecutableNameText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Classes="status-detail">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                            <TextBlock Text="{Binding Shell.I18n.Network}" Classes="caption"/>
                                            <TextBlock Text="{Binding Shell.NetworkStatusValueText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Classes="status-detail">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                            <TextBlock Text="{Binding Shell.I18n.LaunchCheck}" Classes="caption"/>
                                            <TextBlock Text="{Binding Shell.LaunchCheckValueText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="status-detail">
                                        <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                            <TextBlock Text="{Binding Shell.I18n.DiskSpaceLabel}" Classes="caption"/>
                                            <TextBlock Text="{Binding Shell.DiskSpaceText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Classes="info-strip status-note">
                                    <TextBlock Text="{Binding Shell.OperationNote}" Foreground="{DynamicResource LauncherInfoTextBrush}" Classes="caption" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsGameFiles}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.GamePath}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.PathText}" Classes="caption" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.Choose}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PlaylistCheck" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.LaunchCheck}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.LaunchCheckDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.LaunchCheckModeOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.LaunchCheckMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="GamepadSquareOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.GameManagement}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.GameManagementDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                                        <Button Classes="flat-action" Command="{Binding Operations.RequestRepairCommand}"
                                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="Tools" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.Repair}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Operations.RequestUninstallCommand}"
                                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}" Foreground="{DynamicResource LauncherDangerBrush}"/>
                                                <TextBlock Text="{Binding Shell.I18n.Uninstall}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherDangerBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsDownloadNetwork}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ShieldCheck" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.Proxy}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ProxyDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.ProxyModeOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.ProxyMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSource}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSourceDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.PatchUrlGroupOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.PatchUrlGroup, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Speedometer" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSpeedLimit}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSpeedLimitDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.DownloadSpeedLimitOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.DownloadSpeedLimit, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.UpdateChannel}" Classes="section-title"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.UpdateChannelOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.UpdateChannel, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsAppPreferences}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Translate" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.Language}" Classes="section-title"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.LanguageOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.Language, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.Theme}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.ThemeOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.ThemeMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ThemeOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColor}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                                        <Border Classes="color-swatch"
                                                Background="{Binding Settings.ThemeColorPreviewBrush}"/>
                                        <ComboBox Classes="setting-control"
                                                  ItemsSource="{Binding Settings.ThemeColorOptions}"
                                                  SelectedValue="{Binding Settings.Editor.Current.ThemeColorMode, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Code}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SettingOption">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding Settings.IsWallpaperThemeColorSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PaletteSwatchOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorPalette}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorPaletteDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                                        <ItemsControl Width="136"
                                                      ItemsSource="{Binding Settings.ThemeColorPaletteItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ThemeColorPaletteItem">
                                                    <Button Classes="color-swatch-button"
                                                            Command="{Binding DataContext.Settings.SelectThemeColorPaletteCommand, ElementName=SettingsRoot}"
                                                            CommandParameter="{Binding Index}">
                                                        <Border Classes="color-swatch"
                                                                Background="{Binding Brush}">
                                                            <materialIcons:MaterialIcon Kind="Check"
                                                                                        Width="{StaticResource LauncherIconSm}"
                                                                                        Height="{StaticResource LauncherIconSm}"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource LauncherOnAccentBrush}"
                                                                                        IsVisible="{Binding IsSelected}"/>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="flat-action icon-only"
                                                Command="{Binding Settings.RefreshThemeColorPaletteCommand}"
                                                ToolTip.Tip="{Binding Shell.I18n.RefreshThemeColorPalette}">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding Settings.IsCustomThemeColorSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="FormatColorFill" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorCustom}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ColorPicker Grid.Column="2"
                                                 Classes="setting-control"
                                                 Color="{Binding Settings.SelectedCustomThemeColor, Mode=TwoWay}">
                                        <StackPanel Classes="button-content">
                                            <Border Classes="color-swatch-preview"
                                                    Background="{Binding Settings.ThemeColorPreviewBrush}"/>
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.OpenColorPalette}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ColorPicker>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ImageOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundSource}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundSourceDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.BackgroundSourceOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.BackgroundSource, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ImageAspectRatio" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundFit}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundFitDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.BackgroundFitOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.BackgroundFit, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding Settings.IsBackgroundFitSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="FormatColorFill" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundFillColor}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundFillColorDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ColorPicker Grid.Column="2" Classes="setting-control"
                                                 Color="{Binding Settings.SelectedBackgroundFillColor, Mode=TwoWay}">
                                        <StackPanel Classes="button-content">
                                            <Border Classes="color-swatch-preview"
                                                    Background="{Binding Settings.BackgroundFillColorPreviewBrush}"/>
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.OpenColorPalette}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ColorPicker>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding Settings.IsCustomBackgroundSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ImageEditOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.CustomBackground}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.CustomBackgroundDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource LauncherSpacingSm}" VerticalAlignment="Center">
                                        <Button Classes="flat-action" Command="{Binding Settings.ChooseBackgroundImageCommand}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.ChooseImage}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Settings.ChooseBackgroundFolderCommand}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.ChooseFolder}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Settings.ClearBackgroundCommand}"
                                                IsVisible="{Binding Settings.IsCustomBackground}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                                <TextBlock Text="{Binding Shell.I18n.ClearBackground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ProgressClose" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.CloseBehavior}" Classes="section-title"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.CloseBehaviorOptions}"
                                              SelectedValue="{Binding Settings.Editor.Current.CloseBehavior, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="BellOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.NotificationSettings}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ToastNotifications}" Classes="caption"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding Settings.Editor.Current.ToastNotificationsEnabled, Mode=TwoWay}"
                                                  OnContent="{Binding Shell.I18n.ToggleOn}"
                                                  OffContent="{Binding Shell.I18n.ToggleOff}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Classes="dialog-heading-copy">
                                        <TextBlock Text="{Binding Shell.I18n.RemoteContentCard}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ShowRemoteContentCard}" Classes="caption"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding Settings.Editor.Current.ShowRemoteContentCard, Mode=TwoWay}"
                                                  OnContent="{Binding Shell.I18n.ToggleOn}"
                                                  OffContent="{Binding Shell.I18n.ToggleOff}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="{StaticResource LauncherSpacingSm}">
                                <TextBlock Text="{Binding Shell.I18n.About}" Classes="group-title"/>
                                <StackPanel Classes="card-heading">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="{StaticResource LauncherIconLg}" Height="{StaticResource LauncherIconLg}" Foreground="{DynamicResource LauncherAccentBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.ProductName}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.AboutDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource LauncherSpacingSm}">
                                    <TextBlock Text="{Binding Shell.I18n.VersionInfo}" Classes="section-title"/>
                                    <WrapPanel>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.LauncherVersionText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.CommitShaText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.FrameworkVersionText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.AvaloniaVersionText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.PlatformText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.BuildConfigText}" Classes="chip-text"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Classes="flat-action wrap-action" Command="{Binding WindowChrome.OpenOfficialSiteCommand}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Web" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.OfficialSite}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="flat-action wrap-action" Command="{Binding WindowChrome.OpenGitHubRepositoryCommand}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Github" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.GitHubRepository}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="flat-action wrap-action"
                                            Command="{Binding Settings.CheckForUpdatesCommand}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Update" Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                            <TextBlock Text="{Binding Shell.I18n.CheckUpdates}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <StackPanel Spacing="{StaticResource LauncherSpacingXs}">
                                    <TextBlock Text="{Binding Shell.I18n.AboutLinks}" Classes="section-title"/>
                                    <TextBlock Text="{Binding Shell.I18n.AboutCopyrightText}" Classes="caption" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Shell.I18n.AboutDisclaimerText}" Classes="caption" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="dialog-footer">
                    <Button Classes="primary-action" Command="{Binding Settings.SaveSettingsCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Classes="button-content" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentSave" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            <TextBlock Text="{Binding Shell.I18n.Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
