<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Cafe.Launcher.Avalonia.Views"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowSettingsOverlay"
             x:Name="SettingsRoot"
             x:DataType="vm:MainWindowViewModel">
    <Grid IsVisible="{Binding WindowChrome.IsSettingsVisible}" Classes="settings-overlay">
        <Border MaxWidth="960"
                MaxHeight="620"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="dialog overlay-dialog">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Classes="dialog-header">
                    <StackPanel Classes="dialog-title-row">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n.Settings}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dialog-close header-action" Command="{Binding WindowChrome.ShowSettingsCommand}"
                            IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding Shell.I18n.Close}"
                            AutomationProperties.Name="{Binding Shell.I18n.Close}">
                        <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource LauncherIconMd}" Height="{StaticResource LauncherIconMd}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Classes="settings-workspace" ColumnDefinitions="184,*">
                    <ListBox Classes="settings-navigation"
                             x:Name="SettingsNavigation"
                             AutomationProperties.AutomationId="SettingsNavigation"
                             Focusable="True"
                             ItemsSource="{Binding Settings.Options.SettingsCategories}"
                             SelectedValue="{Binding Settings.SelectedCategory, Mode=TwoWay}"
                             SelectedValueBinding="{Binding Code}"
                             IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SettingOption">
                                <TextBlock Text="{Binding DisplayName}"
                                           Classes="settings-navigation-item"
                                           ToolTip.Tip="{Binding Description}"
                                           AutomationProperties.Name="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Classes="settings-content-divider">
                      <Border Classes="settings-content-padding">
                        <Grid Classes="settings-content" RowDefinitions="Auto,*">
                        <Border Classes="status-summary settings-status-summary">
                            <Grid Classes="status-details" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Classes="settings-icon">
                                    <materialIcons:MaterialIcon Kind="{Binding Shell.StatusIconKind}"
                                                                Width="{StaticResource LauncherIconMd}"
                                                                Height="{StaticResource LauncherIconMd}"
                                                                Foreground="{DynamicResource LauncherAccentBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Classes="status-title-inline"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource LauncherSpacingXs}"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Shell.CurrentViewTitle}" Classes="status-summary-title"/>
                                    <TextBlock Text="{Binding Shell.VersionText}" Classes="caption status-summary-version"/>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="status-detail">
                                    <TextBlock Text="{Binding Shell.NetworkStatusValueText}"
                                               Classes="caption"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="3" Classes="status-detail">
                                    <TextBlock Text="{Binding Shell.DiskSpaceText}"
                                               Classes="caption"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Classes="dialog-scroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Classes="category-header settings-category-header">
                                <TextBlock Classes="category-title"
                                           DataContext="{Binding SelectedItem, ElementName=SettingsNavigation}"
                                           x:DataType="models:SettingOption"
                                           Text="{Binding DisplayName}"
                                           AutomationProperties.Name="{Binding DisplayName}"/>
                                <views:SettingsGeneralSection IsVisible="{Binding Settings.IsGeneralCategorySelected}"/>
                                <views:SettingsGameSection IsVisible="{Binding Settings.IsGameCategorySelected}"/>
                                <views:SettingsDownloadNetworkSection IsVisible="{Binding Settings.IsDownloadNetworkCategorySelected}"/>
                                <views:SettingsAppearanceSection IsVisible="{Binding Settings.IsAppearanceCategorySelected}"/>
                                <views:SettingsAboutSection IsVisible="{Binding Settings.IsAboutCategorySelected}"/>
                            </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </Border>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Classes="dialog-footer">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource LauncherSpacingSm}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Classes="flat-action dialog-action"
                                Command="{Binding WindowChrome.ShowSettingsCommand}"
                                IsEnabled="{Binding Settings.IsSaving, Converter={x:Static BoolConverters.Not}}"
                                AutomationProperties.Name="{Binding Shell.I18n.Cancel}">
                            <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CloseCircleOutline"
                                    Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Cancel}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary-action dialog-action"
                                Command="{Binding Settings.SaveSettingsCommand}"
                                IsEnabled="{Binding Settings.CanSaveSettings}"
                                AutomationProperties.Name="{Binding Shell.I18n.Save}">
                            <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ContentSave"
                                    Width="{StaticResource LauncherIconSm}" Height="{StaticResource LauncherIconSm}"/>
                                <TextBlock Text="{Binding Shell.I18n.Save}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
