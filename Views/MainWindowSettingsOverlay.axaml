<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cafe.Launcher.Avalonia.ViewModels"
             xmlns:models="using:Cafe.Launcher.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cafe.Launcher.Avalonia.Views.MainWindowSettingsOverlay"
             x:DataType="vm:MainWindowViewModel">
    <Grid IsVisible="{Binding WindowChrome.IsSettingsVisible}" Background="{DynamicResource LauncherOverlayBrush}">
        <Border MaxWidth="760"
                MaxHeight="650"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="dialog">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Classes="dialog-header">
                    <StackPanel Classes="dialog-title-row">
                        <Border Classes="dialog-icon">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="19" Height="19" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Shell.I18n.Settings}" Classes="dialog-title" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dialog-close" Command="{Binding WindowChrome.ShowSettingsCommand}"
                            VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="{Binding Shell.I18n.Close}">
                        <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Classes="dialog-scroll">
                    <StackPanel Spacing="12">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Shell.I18n.SettingsStatus}" Classes="group-title"/>
                                <StackPanel Classes="card-heading">
                                    <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="20" Height="20" Foreground="{DynamicResource LauncherAccentBrush}"/>
                                    <TextBlock Text="{Binding Shell.ProductName}" Classes="kicker"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Shell.CurrentViewTitle}" Classes="section-title" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Shell.StatusText}" Classes="body"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Text="{Binding Shell.I18n.Version}" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Shell.VersionText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Shell.I18n.Executable}" Classes="caption"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Shell.ExecutableText}" Classes="value" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Classes="info-strip">
                                    <TextBlock Text="{Binding Shell.OperationNote}" Foreground="{DynamicResource LauncherInfoTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsGameFiles}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.GamePath}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.PathText}" Classes="caption" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="flat-action" Command="{Binding Settings.ChooseGamePathCommand}"
                                            IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Shell.I18n.Choose}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PlaylistCheck" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.LaunchCheck}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.LaunchCheckDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.LaunchCheckModeOptions}"
                                              SelectedValue="{Binding Settings.SelectedLaunchCheckMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="GamepadSquareOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.GameManagement}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.GameManagementDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="flat-action" Command="{Binding Operations.RequestRepairCommand}"
                                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="Tools" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Shell.I18n.Repair}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Operations.RequestUninstallCommand}"
                                                IsEnabled="{Binding Shell.IsBusy, Converter={x:Static BoolConverters.Not}}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource LauncherDangerBrush}"/>
                                                <TextBlock Text="{Binding Shell.I18n.Uninstall}" VerticalAlignment="Center" Foreground="{DynamicResource LauncherDangerBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsDownloadNetwork}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ShieldCheck" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.Proxy}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ProxyDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.ProxyModeOptions}"
                                              SelectedValue="{Binding Settings.SelectedProxyMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Web" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSource}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSourceDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.PatchUrlGroupOptions}"
                                              SelectedValue="{Binding Settings.SelectedPatchUrlGroup, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Speedometer" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSpeedLimit}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.DownloadSpeedLimitDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.DownloadSpeedLimitOptions}"
                                              SelectedValue="{Binding Settings.SelectedDownloadSpeedLimit, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel>
                                <TextBlock Text="{Binding Shell.I18n.SettingsAppPreferences}" Classes="group-title"/>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="Translate" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.Language}" Classes="section-title"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.LanguageOptions}"
                                              SelectedValue="{Binding Settings.SelectedLanguage, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.Theme}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.ThemeOptions}"
                                              SelectedValue="{Binding Settings.SelectedThemeMode, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ThemeOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColor}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Classes="color-swatch"
                                                Background="{Binding Settings.ThemeColorPreviewBrush}"/>
                                        <ComboBox Classes="setting-control"
                                                  ItemsSource="{Binding Settings.ThemeColorOptions}"
                                                  SelectedValue="{Binding Settings.SelectedThemeColorMode, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Code}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SettingOption">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,190" ColumnSpacing="12"
                                      IsVisible="{Binding Settings.IsWallpaperThemeColorSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="PaletteSwatchOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorPalette}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorPaletteDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                        <ListBox Width="190"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ItemsSource="{Binding Settings.ThemeColorPaletteItems}"
                                                 SelectedIndex="{Binding Settings.SelectedThemeColorPaletteIndex, Mode=TwoWay}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ThemeColorPaletteItem">
                                                    <Border Classes="color-swatch"
                                                            Background="{Binding Brush}">
                                                        <materialIcons:MaterialIcon Kind="Check"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="{DynamicResource LauncherOnAccentBrush}"
                                                                                    IsVisible="{Binding IsSelected}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Classes="flat-action"
                                                Command="{Binding Settings.RefreshThemeColorPaletteCommand}"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Classes="button-content" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Shell.I18n.RefreshThemeColorPalette}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                      IsVisible="{Binding Settings.IsCustomThemeColorSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="FormatColorFill" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorCustom}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ThemeColorDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ColorPicker Grid.Column="2"
                                                 Classes="setting-control"
                                                 Color="{Binding Settings.SelectedCustomThemeColor, Mode=TwoWay}">
                                        <StackPanel Classes="button-content">
                                            <Border Width="16"
                                                    Height="16"
                                                    CornerRadius="3"
                                                    BorderBrush="{DynamicResource LauncherCardBorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{Binding Settings.ThemeColorPreviewBrush}"/>
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Shell.I18n.OpenColorPalette}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ColorPicker>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ImageOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundSource}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.BackgroundSourceDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.BackgroundSourceOptions}"
                                              SelectedValue="{Binding Settings.SelectedBackgroundSource, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                      IsVisible="{Binding Settings.IsCustomBackgroundSelected}">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ImageEditOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.CustomBackground}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.CustomBackgroundDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="flat-action" Command="{Binding Settings.ChooseBackgroundImageCommand}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Shell.I18n.ChooseImage}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Settings.ChooseBackgroundFolderCommand}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Shell.I18n.ChooseFolder}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="flat-action" Command="{Binding Settings.ClearBackgroundCommand}"
                                                IsVisible="{Binding Settings.IsCustomBackground}">
                                            <StackPanel Classes="button-content">
                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Shell.I18n.ClearBackground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ProgressClose" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.CloseBehavior}" Classes="section-title"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="setting-control"
                                              ItemsSource="{Binding Settings.CloseBehaviorOptions}"
                                              SelectedValue="{Binding Settings.SelectedCloseBehavior, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Code}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SettingOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="BellOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.NotificationSettings}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ToastNotifications}" Classes="caption"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding Settings.ToastNotificationsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Classes="settings-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="settings-icon">
                                        <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="18" Height="18" Foreground="{DynamicResource LauncherAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shell.I18n.RemoteContentCard}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.ShowRemoteContentCard}" Classes="caption"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding Settings.ShowRemoteContentCard, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Shell.I18n.About}" Classes="group-title"/>
                                <StackPanel Classes="card-heading">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" Foreground="{DynamicResource LauncherAccentBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Shell.ProductName}" Classes="section-title"/>
                                        <TextBlock Text="{Binding Shell.I18n.AboutDescription}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Shell.I18n.VersionInfo}" Classes="section-title"/>
                                    <WrapPanel>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.LauncherVersionText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.RuntimeInfoText}" Classes="chip-text"/>
                                        </Border>
                                        <Border Classes="version-chip">
                                            <TextBlock Text="{Binding Shell.BuildInfoText}" Classes="chip-text"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Classes="flat-action wrap-action" Command="{Binding WindowChrome.OpenOfficialSiteCommand}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Web" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Shell.I18n.OfficialSite}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="flat-action wrap-action" Command="{Binding WindowChrome.OpenGitHubRepositoryCommand}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Github" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Shell.I18n.GithubRepository}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- "Check for Updates" is hidden until the feature is implemented.
                                         Re-enable by removing IsVisible="False" and wiring up the command. -->
                                    <Button Classes="flat-action wrap-action"
                                            IsVisible="False"
                                            ToolTip.Tip="{Binding Shell.I18n.CheckUpdatesUnavailable}">
                                        <StackPanel Classes="button-content">
                                            <materialIcons:MaterialIcon Kind="Update" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Shell.I18n.CheckUpdates}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Shell.I18n.AboutLinks}" Classes="section-title"/>
                                    <TextBlock Text="{Binding Shell.I18n.AboutCopyrightText}" Classes="caption" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Shell.I18n.AboutDisclaimerText}" Classes="caption" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="dialog-footer">
                    <Button Classes="primary-action" Command="{Binding Settings.SaveSettingsCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Classes="button-content" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18" Foreground="{DynamicResource LauncherOnAccentBrush}"/>
                            <TextBlock Text="{Binding Shell.I18n.Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
