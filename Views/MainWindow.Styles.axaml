        <Setter Property="MinHeight" Value="{StaticResource Cafe.Control.Height.Field}"/>
        <Setter Property="Padding" Value="{StaticResource Cafe.Inset.Small}"/>
    </Style>
    <Style Selector="StackPanel.confirm-actions">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Spacing" Value="{StaticResource Cafe.Space.3}"/>
    </Style>
