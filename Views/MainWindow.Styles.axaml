        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnDanger}"/>
    </Style>
    <Style Selector="Button.chrome.close:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Danger.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnDanger.Pressed}"/>
    </Style>
    <Style Selector="Button.text-link">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Link}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Body}"/>
        <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="Button.icon-link">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="Padding" Value="{StaticResource Cafe.Inset.Tab}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Small}"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
    </Style>
    <Style Selector="Button.icon-link:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Info}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.icon-link:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
    </Style>
    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
        <Setter Property="Width" Value="{StaticResource Cafe.Control.Size.Swatch}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Size.Swatch}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Small}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon-button.compact">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="Button.icon-button.carousel-navigation">
        <Setter Property="Width" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Overlay.Strong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnChrome}"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
        <Setter Property="Margin" Value="{StaticResource Cafe.Space.2.Thickness}"/>
    </Style>
    <Style Selector="Button.icon-button.dot">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.icon-button:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
    </Style>
    <Style Selector="Button.icon-button.carousel-navigation:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Chrome.ControlHover}"/>
    </Style>
    <Style Selector="Button.icon-button.carousel-navigation:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Soft}"/>
    </Style>
    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent}"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Label}"/>
        <Setter Property="FontWeight" Value="{StaticResource Cafe.Type.Weight.Strong}"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.Dock}"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Medium}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
    </Style>
    <Style Selector="Button.primary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent.Hover}"/>
    </Style>
    <Style Selector="Button.primary-action:pressed">
