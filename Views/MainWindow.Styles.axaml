    <Style Selector="Button.primary-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Border.Button}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
    </Style>
    <Style Selector="Button.flat-action">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Border.Button}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text}"/>
        <Setter Property="Padding" Value="{StaticResource Cafe.Inset.Control}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Small}"/>
        <Setter Property="MinHeight" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
    </Style>
    <Style Selector="Button.flat-action.elevated">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.flat-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.flat-action.elevated:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.flat-action:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.QuietPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.flat-action.elevated:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Info}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Accent}"/>
    </Style>
    <Style Selector="Button.flat-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Row}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Border}"/>
    </Style>
    <Style Selector="Button.flat-action.icon-only">
        <Setter Property="Width" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="MinWidth" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="StackPanel.operation-actions > Button">
        <Setter Property="MinHeight" Value="{StaticResource Cafe.Control.Height.Dock}"/>
        <Setter Property="MinWidth" Value="156"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Label}"/>
    </Style>
    <Style Selector="StackPanel.operation-actions > Button.primary-action">
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.PrimaryAction}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Medium}"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Title}"/>
    </Style>
    <Style Selector="Border.control-panel StackPanel.operation-actions > Button">
        <Setter Property="Width" Value="{StaticResource Cafe.Layout.OperationDock.Action.Width}"/>
        <Setter Property="MinWidth" Value="{StaticResource Cafe.Layout.OperationDock.Action.Width}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Layout.OperationDock.Action.Height}"/>
        <Setter Property="MinHeight" Value="{StaticResource Cafe.Layout.OperationDock.Action.Height}"/>
        <Setter Property="Padding" Value="{StaticResource Cafe.Layout.OperationDock.Action.Padding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Medium}"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Title}"/>
    </Style>
    <Style Selector="Border.control-panel StackPanel.operation-actions > Button.primary-action">
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent}"/>
    </Style>
    <Style Selector="Border.control-panel StackPanel.operation-actions > Button.primary-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnChrome.Muted}"/>
    </Style>
    <Style Selector="Border.control-panel StackPanel.operation-actions > Button.primary-action:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Accent.Pressed}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnAccent.Pressed}"/>
    </Style>
    <Style Selector="Grid.install-path-row > Button.primary-action">
