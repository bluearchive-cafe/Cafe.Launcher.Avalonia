        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
        <Setter Property="Width" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.Setting}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Cafe.Radius.Small}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
    </Style>
    <Style Selector="Button.dialog-close:pointerover">
