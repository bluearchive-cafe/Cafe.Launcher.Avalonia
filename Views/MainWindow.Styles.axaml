        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Cafe.Control.Template.BorderButton}"/>
    </Style>
    <Style Selector="Button.chrome.settings">
        <Setter Property="Margin" Value="{StaticResource Cafe.Layout.TitleBar.SettingsAction.Margin}"/>
    </Style>
    <Style Selector="Button.chrome:pointerover">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Chrome.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnChrome}"/>
    </Style>
    <Style Selector="Button.chrome:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Chrome.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnChrome}"/>
    </Style>
    <Style Selector="Button.chrome.close:pointerover">
