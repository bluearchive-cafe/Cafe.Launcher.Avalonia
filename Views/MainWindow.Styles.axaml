        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnDanger.Hover}"/>
    </Style>
    <Style Selector="Button.danger-action:pressed">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Danger.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.OnDanger.Pressed}"/>
    </Style>
    <Style Selector="Button.dialog-action">
        <Setter Property="Height" Value="{StaticResource Cafe.Control.Height.Dialog}"/>
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="{StaticResource Cafe.Type.Body}"/>
    </Style>
    <Style Selector="Button.primary-action.dialog-action:disabled">
        <Setter Property="Background" Value="{DynamicResource Cafe.Color.Surface.Row}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cafe.Color.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Cafe.Color.Text.Muted}"/>
