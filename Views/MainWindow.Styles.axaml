    <!-- Operation panels share 40px horizontal alignment and common padding. -->
    <Style Selector="Border.bottom-panel">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="MinHeight" Value="{StaticResource Cafe.Layout.Home.Dock.MinHeight}"/>
