    <Style Selector="Grid.motion-overlay">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-surface">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-surface-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector=":is(UserControl).motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="StackPanel.motion-content">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.motion-bottom">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Fast}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{DynamicResource Cafe.Color.Overlay}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Surface}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Cafe.Motion.Offset.Medium}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-enter > Border.motion-surface > Grid.motion-surface-content">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Surface}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Fast}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource Cafe.Color.Overlay}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{DynamicResource Cafe.Color.Transparent}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > Border.motion-surface">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Fast}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Cafe.Motion.Offset.Medium}"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Grid.motion-overlay.motion-enabled.motion-exit > Border.motion-surface > Grid.motion-surface-content">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Fast}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Exit}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(UserControl).motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Standard}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Cafe.Motion.Offset.Small}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="StackPanel.motion-content.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Standard}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Cafe.Motion.Offset.Small}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.motion-bottom.motion-enabled.motion-enter">
        <Style.Animations>
            <Animation Duration="{StaticResource Cafe.Motion.Surface}" FillMode="Forward" Easing="{StaticResource Cafe.Motion.Ease.Enter}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="{StaticResource Cafe.Motion.Offset.Large}"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
