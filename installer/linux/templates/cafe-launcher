#!/bin/sh
set -eu

# Package-managed installs are not writable by the user. Tell the launcher to
# choose a writable user-home default for game files instead of a sibling of
# the application directory.
#
# The package-format marker below is substituted at packaging time (deb / rpm /
# pacman); GameInstallationPath only checks it is non-empty, so it is diagnostic.
export CAFE_LAUNCHER_PACKAGE_FORMAT={PACKAGE_FORMAT}

exec {APP_DIR}/Cafe.Launcher.Avalonia "$@"
